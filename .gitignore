# Dependencies
node_modules/

# Build outputs
dist/
bin/
packages/*/dist
packages/*/dist-typecheck
*.tsbuildinfo

# Compiled test helpers (TypeScript artifacts)
packages/*/tests/**/*.js
packages/*/tests/**/*.js.map
packages/*/tests/**/*.d.ts
packages/*/tests/**/*.d.ts.map

# Compiled TypeScript in source directories (should go to dist/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
!packages/*/src/**/*.generated.ts
# E2E tests use dual .ts/.js files (noEmit tsconfig, manually maintained JS)
!packages/e2e-tests/src/**/*.js
!packages/e2e-tests/src/**/*.d.ts
# Hand-authored ambient declarations, which are SOURCE and must ship. The rule
# above exists to keep COMPILER-EMITTED .d.ts out of src/; it silently swallowed
# packages/cli/src/types/py-modules.d.ts, so tsc passed locally and would have
# failed in CI on a file that was never committed.
!packages/*/src/types/*.d.ts

# Desktop package compiled config
packages/desktop/*.js
packages/desktop/*.d.ts
packages/desktop/out/

# Astro cache
.astro/

# Wrangler local state
.wrangler/

# Workers staging builds
workers/www/staging/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
*.sw?
*.swp
*.swo

# Environment variables
.env
.env.local
secrets.env
.rdc-dev/
.rdc-bench/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Self-hosted submodules (migrated to GitLab, cloned manually)
private/growth/
private/generative/

# Temporary files
*.tmp
.claude/scheduled_tasks.lock
.backend-state
.provision-state
.service-state
.account-state
.devbox-state
.account-logs/
.vm-info

# Generated SEA config (platform-specific, created during CI build)
sea-config.generated.json

# Build artifacts
.build_cache/
playwright/conf.conf
playwright/.venv/
.venv/
playwright/venv/
playwright_venv/
# Python
__pycache__/
# ruff writes this whenever check:ci-python-lint runs (or anyone runs ruff
# by hand); it is a local cache, never an artifact.
.ruff_cache/
*.py[cod]
*$py.class
*.pyc
playwright/__pycache__/

# Test artifacts (consolidated)
playwright/artifacts/
logs/
packages/cli/tests/reports/
packages/cli/test-results/
**/test-results/
packages/e2e/utils/data/.created-users.json

# Screenshots (removed from tracking)
error_screenshot.png
debug_screenshot.png
repositories_screenshot.png
playwright/screenshots/
artifacts/
screenshots/

# Docker volume artifacts (prevent accidental directory creation)
playwright/*.py/
playwright/**/*.png
playwright_env/
.playwright-mcp/
packages/cli/reports/
reports/

.ci/cache/

# Git worktrees
.worktrees/

# D1 database backups (local exports via scripts/dev/backup-d1.sh)
.backups/

# SQLite databases (account E2E artifacts)
*.db
*.db-shm
*.db-wal

# npm audit output (generated by .ci/scripts/security/audit.sh; uploaded as CI artifact)
audit-prod.json
audit-report.json
# GHSA detail cache populated by audit.sh (transient per-run data)
.audit-advisory-cache/

# i18n naturalization-ledger flock sidecar (private/growth/i18n_pipeline ledger.update)
packages/www/src/i18n/translations/*.lock

# reggate effort-cap ledger flock sidecar. The LEDGER itself
# (agent/reggate/<branch>.jsonl) is deliberately TRACKED -- it rides the PR so a
# reviewer sees the deferred gate debts in the diff, and a CI gate can read it.
# Only the lock is an artifact. Third instance of this same shape; no .lock file
# is tracked anywhere in this repo.
agent/reggate/*.lock

# NO RULE FOR AGENT WORKING NOTES, deliberately, and this note is here so the
# absence reads as a decision rather than an oversight. They used to live in a
# gitignored `.agent/`; they now live in the TRACKED `agent/<session-prefix>/`
# (plus `agent/RULES.md`, `agent/PLAN-*.md` and `agent/programs/<slug>/`), so
# the tree is reviewable and survives a worktree. Its CI cost is paid by a
# zero-job `agent` module in .ci/scripts/ci/scope-map.cjs, NOT by hiding it from
# git: an ignore rule here would make every session's STATE.md invisible to the
# thing that is supposed to keep it honest.

# Transient per-session render backups (another session writes these mid-campaign;
# a blanket sweep once committed one into an unrelated PR, review finding on #546).
.backup-render-*/

# Built by .ci/scripts/private/license-e2e.sh; an 11MB Go binary, never committed.
.ci/scripts/private/license-mint/license-mint

# Stop-hook RUNTIME sidecars. These are per-session state written by
# .claude/hooks/stop/* at run time -- session briefs, waiter heartbeats, poll
# marks. wl_store.py:36 lists them as sidecars alongside .requests and .loop.
# They are machine-local and MUST NOT be tracked: a committed heartbeat is a
# lie about a process that is not running, and a committed brief describes a
# session that no longer exists. A `git add -A` swept two of them in once.
.claude/hooks/stop/.sessions
.claude/hooks/stop/.waiter-*
.claude/hooks/stop/.requests
.claude/hooks/stop/.loop

# Byproducts of the worklist hook's own test suite (.claude/hooks/stop/test-worklist-v5.sh).
# The harness writes a `<worklist>.events.jsonl` beside its fixture worklist and stages
# synthetic TRAPS.md trees under capfix-*/; both carry `deadbeef` fixture data, not state.
.claude/hooks/stop/.events.jsonl
.claude/hooks/stop/capfix-at/
.claude/hooks/stop/capfix-over/
