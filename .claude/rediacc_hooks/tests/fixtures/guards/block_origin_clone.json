{
  "EDGE_CASES": [
    ["the origin", "git clone https://github.com/@WK_GH_REPO@.git /tmp/x"],
    ["a submodule", "git clone git@github.com:@WK_RENET_REPO@.git /tmp/x"],
    ["the mirror", "git clone https://gitlab.rediacc.@~@io/rediacc-org/github/console.git /tmp/x"],
    ["gh", "gh repo clone @WK_GH_REPO@"],
    ["a wrapper", "sh -c 'git clone https://github.com/@WK_GH_REPO@ /tmp/x'"],
    ["init and fetch", "git init /tmp/x && git -C /tmp/x fetch https://github.com/@WK_GH_REPO@.git"],
    ["program text", "python3 -c \"import os; os.system('git clone https://github.com/@WK_GH_REPO@ /x')\""],
    ["control: a fixture", "git clone /tmp/fixture /tmp/y"],
    ["control: an unrelated url", "git clone https://example.invalid/a.git /tmp/y"],
    ["control: prose", "echo git clone https://github.com/@WK_GH_REPO@.git /tmp/x"],
    ["control: a heredoc body", "cat > n.md <<'EOF'\ngit clone https://github.com/@WK_GH_REPO@.git /tmp/x\nEOF"]
  ]
}
