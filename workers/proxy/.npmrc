# The repo root pins ignore-scripts=true as a supply-chain control. That is the
# right default, but workerd and esbuild are distributed as prebuilt binaries
# fetched by a postinstall script, so wrangler cannot run at all without it.
#
# Scope of the exception: this directory only, and only for the local dev and
# dry-run tooling. Nothing here ships to a machine. The container image built by
# the Dockerfile still installs with --ignore-scripts and rebuilds the three
# native packages explicitly, so the production path keeps the control.
ignore-scripts=false
# loglevel: npm 12 logs every run as `npm notice run ...` on stderr; notices stay off, as in the repo-root .npmrc.
loglevel=warn
