{
  // Wired into `npm run typecheck` through .ci/scripts/quality/typecheck-workers.sh,
  // which installs this project's deps first: `types` below resolves only from THIS
  // directory's node_modules, never the repo root.
  "compilerOptions": {
    "target": "ES2022",
    // ESNext, not ES2022: src/__tests__ reaches private/account/src/i18n/index.ts, which
    // uses IMPORT ATTRIBUTES (`with { type: 'json' }`). Under ES2022 tsc reports TS2823
    // thirteen times for a file that is not this worker's and is not broken -- it is a
    // module-setting mismatch, not a defect. `moduleResolution: bundler` below already
    // requires an esnext-family module setting, so this also makes the pair consistent.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
