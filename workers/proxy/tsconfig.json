{
  // NOT YET IN `npm run typecheck`, and the reason is an install rather than a config.
  // This worker declares @cloudflare/workers-types in its package.json but has no
  // node_modules in this checkout -- only workers/www does -- so `tsc -p` here reports
  // TS2688 "Cannot find type definition file". Wiring it into the root typecheck would
  // therefore break typecheck on any machine (CI included) that has not installed this
  // worker's deps. The missing piece is an install step, not this file. See worklist.
  "compilerOptions": {
    "target": "ES2022",
    // ESNext, not ES2022: src/__tests__ reaches private/account/src/i18n/index.ts, which
    // uses IMPORT ATTRIBUTES (`with { type: 'json' }`). Under ES2022 tsc reports TS2823
    // thirteen times for a file that is not this worker's and is not broken -- it is a
    // module-setting mismatch, not a defect. `moduleResolution: bundler` below already
    // requires an esnext-family module setting, so this also makes the pair consistent.
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src"]
}
