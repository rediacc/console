# The repo root pins ignore-scripts=true as a supply-chain control. That is the
# right default, but workerd and esbuild are distributed as prebuilt binaries
# fetched by a postinstall script, so wrangler cannot run at all without it.
#
# Scope of the exception: this directory only, and only for the local dev, test and
# deploy tooling (wrangler, vitest). The Worker bundle that wrangler uploads holds
# no dependency lifecycle script, and no container image is built from here.
ignore-scripts=false
