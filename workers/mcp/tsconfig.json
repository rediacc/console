{
  // Wired into `npm run typecheck` through `rediacc_ci.quality.typecheck_workers`, which installs this
  // project's deps first: `types` below resolves only from THIS directory's node_modules.
  "compilerOptions": {
    "target": "ES2022",
    // ESNext because `moduleResolution: bundler` requires an esnext-family module setting, and the
    // shared registry imports its JSON with an import attribute.
    "module": "ESNext",
    "moduleResolution": "bundler",
    // DOM beside the Workers types: the shared config-crypto module (the agent bearer parse and the auth tag,
    // Design 3) is typed against the DOM Web Crypto names (`AesGcmParams`, the `generateKey` overloads), which
    // @cloudflare/workers-types alone does not declare.
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "vitest.config.ts"]
}
