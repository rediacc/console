{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteProperties": "asNeeded",
      "jsxQuoteStyle": "double"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100,
      "quoteStyle": "single"
    }
  },
  "files": {
    "includes": [
      "scripts/**/*.js",
      "scripts/**/*.cjs",
      "scripts/**/*.ts",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "packages/**/*.jsx",
      "packages/**/*.mjs",
      "packages/**/*.cjs",
      "packages/www/scripts/**/*.js",
      "packages/locales/*.js",
      "packages/www/public/**/*.js",
      ".ci/**/*.js",
      ".ci/**/*.cjs",
      ".ci/**/*.mjs",
      ".ci/**/*.ts",
      "vitest.config.mjs",
      "eslint-rules/**/*.js",
      "workers/**/*.ts",
      ".github/actions/**/*.js",
      "packages/**/*.json",
      "packages/**/*.css",
      "private/account/**/i18n/locales/**/*.json",
      "!.ci/cache/**",
      "!.claude/worktrees/**",
      "!private/growth/**",
      "!packages/www/src/i18n/client/**",
      "!packages/www/src/i18n/client-route/**",
      "!**/.translation-hashes.json",
      "!**/.naturalized-hashes.json",
      "!**/node_modules/**",
      "!**/dist/**",
      "!**/bin/**",
      "!**/out/**",
      "!**/test-results/**",
      "!**/reports/**",
      "!**/screenshots/**",
      "!**/playwright-report/**",
      "!packages/**/*.js.map",
      "!packages/**/*.d.ts",
      "!packages/**/*.d.ts.map",
      "!**/*.min.js",
      "!**/*.min.css",
      "!**/*.generated.ts",
      "!**/api-schema.zod.ts",
      "!**/renet-contract/data/*.schema.ts",
      "!**/cli-contract/data/**",
      "!**/search-index.json",
      "!**/search-index-*.json",
      "!packages/www/public/assets/tutorials/video/**",
      "!packages/www/public/assets/tutorials/audio/**",
      "!packages/www/public/assets/videos/solutions/**",
      "!**/*.astro",
      "!packages/www/.astro/**",
      "!packages/*/templates/**",
      "private/account/src/**/*.ts",
      "private/account/tests/**/*.ts",
      "private/account/scripts/**/*.ts",
      "private/account/e2e/src/**/*.ts",
      "private/account/e2e/tests/**/*.ts",
      "private/account/e2e/scripts/**/*.ts",
      "private/account/e2e/playwright.config.ts",
      "private/account/web/src/**/*.ts",
      "private/account/web/src/**/*.tsx",
      "private/account/web/src/**/*.css"
    ],
    "ignoreUnknown": true
  },
  "plugins": [
    {
      "path": "biome-plugins/no-d1-transaction.grit",
      "includes": ["**/private/account/**"]
    },
    {
      "path": "biome-plugins/no-route-db-dynamic-import.grit",
      "includes": ["**/private/account/src/routes/**", "!**/private/account/src/routes/test.ts"]
    },
    {
      "path": "biome-plugins/no-email-literal-copy.grit",
      "includes": ["**/private/account/src/services/email.service.ts"]
    }
  ],
  "overrides": [
    {
      "includes": ["private/account/**/*.ts", "private/account/**/*.tsx"],
      "linter": {
        "enabled": true,
        "rules": {
          "preset": "recommended",
          "nursery": {
            "noFloatingPromises": "error"
          },
          "a11y": {
            "noAutofocus": "warn",
            "noStaticElementInteractions": "warn"
          }
        }
      },
      "assist": {
        "actions": {
          "source": {
            "organizeImports": {
              "level": "on"
            }
          }
        }
      }
    },
    {
      "includes": ["private/account/web/src/hooks/**/*.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/cli/tests/**/*.ts"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": {
              "level": "off"
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cli/src/services/__tests__/persist-unification.test.ts"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": {
              "level": "off"
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!private/account/**", "!packages/shared/src/**/__tests__/**"],
      "plugins": [
        "biome-plugins/no-constant-alias.grit",
        "biome-plugins/no-ant-css-var.grit",
        "biome-plugins/no-t-default-value.grit",
        "biome-plugins/no-inline-style-prop.grit",
        "biome-plugins/no-exported-type-alias.grit"
      ]
    },
    {
      "includes": ["**", "!private/account/**"],
      "linter": {
        "enabled": true,
        "domains": {
          "react": "none"
        },
        "rules": {
          "preset": "none",
          "correctness": {
            "noUnusedVariables": "error",
            "noUnusedImports": "error",
            "noUnusedFunctionParameters": "error",
            "noChildrenProp": "error",
            "noRenderReturnValue": "error",
            "useJsxKeyInIterable": "error",
            "useHookAtTopLevel": "error",
            "useExhaustiveDependencies": "error",
            "noNestedComponentDefinitions": "error",
            "noEmptyCharacterClassInRegex": "error",
            "noRestrictedElements": {
              "level": "error",
              "options": {
                "elements": {
                  "div": "Use Flex, Card, or other antd layout components.",
                  "span": "Use Typography.Text.",
                  "button": "Use antd Button component.",
                  "input": "Use antd Input component.",
                  "select": "Use antd Select component."
                }
              }
            },
            "noComponentHookFactories": "error"
          },
          "suspicious": {
            "noTsIgnore": "error",
            "noNonNullAssertedOptionalChain": "error",
            "noUnsafeDeclarationMerging": "error",
            "noUnusedExpressions": "error",
            "noExplicitAny": "error",
            "noDeprecatedImports": "error",
            "noConsole": {
              "level": "error",
              "options": {
                "allow": ["warn", "error"]
              }
            },
            "noDebugger": "error",
            "noUnnecessaryConditions": "error",
            "useAwait": "error",
            "useArraySortCompare": "error",
            "noDuplicateJsxProps": "error",
            "noCommentText": "error",
            "noDoubleEquals": {
              "level": "error",
              "options": {
                "ignoreNull": true
              }
            },
            "noVar": "error",
            "noGlobalIsNan": "error",
            "noGlobalIsFinite": "error",
            "noDuplicateObjectKeys": "error",
            "noReactStringRefs": "error"
          },
          "complexity": {
            "useOptionalChain": "error",
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 10
              }
            },
            "useArrowFunction": "error",
            "noImplicitCoercions": {
              "level": "error",
              "options": {
                "allowDoubleNegation": true
              }
            },
            "noUselessFragments": "error",
            "noAdjacentSpacesInRegex": "error",
            "noUselessEscapeInRegex": "error",
            "noExcessiveNestedCallbacks": {
              "level": "error",
              "options": {
                "max": 3
              }
            }
          },
          "nursery": {
            "noFloatingPromises": "error",
            "useAwaitThenable": "error",
            "noMisusedPromises": "error",
            "useNullishCoalescing": "error",
            "useIncludes": "error",
            "useStringStartsEndsWith": "error",
            "useRegexpExec": "error"
          },
          "style": {
            "noInferrableTypes": "error",
            "useConsistentArrayType": {
              "level": "error",
              "options": {
                "syntax": "shorthand"
              }
            },
            "useReadonlyClassProperties": "error",
            "noNamespace": "error",
            "noCommonJs": "error",
            "useForOf": "error",
            "useConst": "error",
            "useConsistentObjectDefinitions": {
              "level": "error",
              "options": {
                "syntax": "shorthand"
              }
            },
            "useTemplate": "error",
            "noUselessElse": "error",
            "useCollapsedElseIf": "error",
            "noNestedTernary": "error",
            "useNodejsImportProtocol": "error",
            "useNumberNamespace": "error",
            "noNegationElse": "error",
            "useSelfClosingElements": "error",
            "useConsistentCurlyBraces": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "styled-components": {
                    "message": "Use Ant Design components with CSS utility classes (className) instead."
                  },
                  "antd": {
                    "importNames": ["Layout"],
                    "message": "Layout has default grey/dark backgrounds. Use Flex component instead."
                  },
                  "@rediacc/shared/types": {
                    "importNames": ["WithOptionalVault"],
                    "message": "WithOptionalVault is deprecated. vaultContent and vaultVersion are now optional with SQL defaults in generated types. Use CreateXxxParams directly."
                  }
                },
                "patterns": [
                  {
                    "group": ["styled-components/*"],
                    "message": "Use Ant Design components instead."
                  },
                  {
                    "group": [
                      "antd/es/layout",
                      "antd/es/layout/*",
                      "antd/lib/layout",
                      "antd/lib/layout/*"
                    ],
                    "message": "Layout has default grey/dark backgrounds. Use Flex component instead."
                  }
                ]
              }
            }
          },
          "a11y": {
            "useButtonType": "error"
          },
          "security": {
            "noBlankTarget": "error",
            "noDangerouslySetInnerHtmlWithChildren": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.js", "**/*.mjs", "**/*.cjs", "!private/account/**"],
      "linter": {
        "rules": {
          "preset": "recommended",
          "correctness": {
            "noUndeclaredVariables": "error"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts", "scripts/**/*.cjs"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "useAwait": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noAdjacentSpacesInRegex": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          },
          "style": {
            "useNumberNamespace": "off",
            "noNegationElse": "off",
            "noNestedTernary": "off",
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/scripts/**/*.js",
        "packages/*/scripts/**/*.cjs",
        "packages/*/scripts/**/*.mjs",
        "packages/*/scripts/**/*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noAdjacentSpacesInRegex": "off"
          },
          "style": {
            "useNumberNamespace": "off",
            "noNegationElse": "off",
            "noNestedTernary": "off",
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": [
        ".ci/**/*.js",
        ".ci/**/*.cjs",
        ".ci/**/*.mjs",
        ".ci/**/*.ts",
        "eslint-rules/**/*.js",
        "eslint-rules/**/*.cjs",
