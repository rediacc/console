# Copy to secrets.env (chmod 600) and fill in. Never commit secrets.env.

# Public names. ELITE_STORE_DOMAIN serves presigned backup URLs to machines outside this host.
ELITE_DOMAIN=elite.example.com
ELITE_STORE_DOMAIN=store.elite.example.com

# Image: a release tag, or ELITE_IMAGE for a locally loaded image (images/server.tar).
TAG=latest
# ELITE_IMAGE=rediacc-server-onprem:dev

# Object store credentials and the config-store sealing key.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
ACCOUNT_CONFIG_SERVER_KEY=

# Enrolment: the licence-signing pairs, API key, JWT secret and the delegation cert.
ACCOUNT_ED25519_PRIVATE_KEY=
ACCOUNT_ED25519_PUBLIC_KEY=
ACCOUNT_X25519_PRIVATE_KEY=
ACCOUNT_X25519_PUBLIC_KEY=
ACCOUNT_SERVER_API_KEY=
ACCOUNT_JWT_SECRET=
# DELEGATION_CERT_BASE64 stays empty on the free tier.
DELEGATION_CERT_BASE64=

# Owner account email: the user registered with it is promoted to root, which `rdc server licence` needs.
ROOT_EMAIL=
# Set to "provided" when the router certificates were installed by hand (`rdc server install --tls byo`).
ELITE_TLS=
# On-premise mode: "true" turns off the terms gate and serves the on-prem licence route; `rdc server install` writes true and the default is true.
ON_PREMISE_MODE=true
# Optional: the key pair auto-renew signs with (the delegated pair); empty leaves auto-renew off.
# Like ACCOUNT_ED25519_PRIVATE_KEY, it reaches the server as an environment variable, so anyone with docker access on the box can read it.
ON_PREMISE_PRIVATE_KEY=
ON_PREMISE_PUBLIC_KEY=

# Optional: connected renewal against the upstream account server.
UPSTREAM_URL=
UPSTREAM_API_KEY=
UPSTREAM_PUBLIC_KEY=

# Optional: outgoing mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
