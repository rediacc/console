// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildKeyDeploymentScript > produces the exact deployment script (byte-identical snapshot) 1`] = `"set -e; SSH_DIR="$HOME/.ssh"; AUTH_KEYS="$SSH_DIR/authorized_keys"; mkdir -p "$SSH_DIR" && chmod 700 "$SSH_DIR"; KEY_BLOB="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"; if [ -f "$AUTH_KEYS" ] && awk -v b="$KEY_BLOB" '{ for (i = 1; i <= NF; i++) if ($i == b) f = 1 } END { exit !f }' "$AUTH_KEYS"; then TEMP=$(mktemp) && awk -v b="$KEY_BLOB" '{ for (i = 1; i <= NF; i++) if ($i == b) next } 1' "$AUTH_KEYS" > "$TEMP" && mv "$TEMP" "$AUTH_KEYS"; fi; echo 'command="/usr/lib/rediacc/renet/current/renet sandbox-gateway myrepo --guid guid-123 --datastore /mnt/rediacc" ssh-ed25519 AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA test@rediacc' >> "$AUTH_KEYS"; chmod 600 "$AUTH_KEYS""`;
