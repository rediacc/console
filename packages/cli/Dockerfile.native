# CI Dockerfile for the rdc CLI — a SEA single-binary image.
#
# `rdc` here is the Node SEA (single executable app), which EMBEDS renet for both
# linux arches. So `docker run ghcr.io/rediacc/rdc <cmd>` is a fully working CLI
# that can provision renet to remote machines with zero host installs — unlike
# the old node+JS-bundle image, where `isSEA()` was false and any renet
# provisioning threw "not running as SEA".
#
# The SEA is a stripped, dynamically-linked *musl* `node` copy
# (rdc-linux-musl-<arch>), so it runs on an Alpine base. CI stages the
# arch-appropriate musl SEA into ./bin/rdc before each per-arch buildx build.
#
# Usage in CI (see build-cli-docker in ci-build-docker.yml):
#   cp dist/cli/rdc-linux-musl-x64 bin/rdc
#   docker buildx build --file packages/cli/Dockerfile.native \
#     --platform linux/amd64 --tag ghcr.io/rediacc/rdc:<tag>-amd64 --push .
ARG ALPINE_IMAGE=alpine:3.20
FROM ${ALPINE_IMAGE}

# libstdc++/libgcc: the SEA (node) links them dynamically. ca-certificates:
# TLS to the account server / registries.
RUN apk add --no-cache libstdc++ libgcc ca-certificates

COPY ./bin/rdc /usr/local/bin/rdc
RUN chmod +x /usr/local/bin/rdc

ENTRYPOINT ["rdc"]
