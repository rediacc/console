{
  "version": 1,
  "tutorial": "tutorial-backup-restore",
  "nextTutorialKey": "tutorial-networking",
  "scenes": [
    {
      "id": "intro",
      "type": "title",
      "narrationKey": "intro",
      "narrationRole": "intro"
    },
    {
      "id": "three-steps",
      "type": "slide",
      "src": "slide-1.svg",
      "narrationKey": "three-steps",
      "narrationRole": "slide-explainer"
    },
    {
      "id": "cast-step-0",
      "type": "cast-narrated",
      "markerIndex": 0,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "cat orders.txt",
        "commandFull": "rdc term connect my-app --command 'cat orders.txt'"
      }
    },
    {
      "id": "cast-step-1",
      "type": "cast-narrated",
      "markerIndex": 1,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "rdc repo push",
        "commandFull": "rdc repo push my-app --to machine-12"
      }
    },
    {
      "id": "cast-step-2",
      "type": "cast-narrated",
      "markerIndex": 2,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "rdc repo list",
        "commandFull": "rdc repo list --machine machine-12"
      }
    },
    {
      "id": "cast-step-3",
      "type": "cast-narrated",
      "markerIndex": 3,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "rdc repo down",
        "commandFull": "rdc repo down my-app --unmount"
      }
    },
    {
      "id": "cast-step-4",
      "type": "cast-narrated",
      "markerIndex": 4,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "rdc backup restore",
        "commandFull": "rdc backup restore my-app@machine-12 --as my-app-restored --machine machine-12 --yes"
      }
    },
    {
      "id": "cast-step-5",
      "type": "cast-narrated",
      "markerIndex": 5,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "rdc repo up",
        "commandFull": "rdc repo up my-app-restored --no-start"
      }
    },
    {
      "id": "cast-step-6",
      "type": "cast-narrated",
      "markerIndex": 6,
      "holdSec": 0.8,
      "narrationRole": "step",
      "card": {
        "command": "cat orders.txt",
        "commandFull": "rdc term connect my-app-restored --command 'cat orders.txt'"
      }
    },
    {
      "id": "cast-step-7",
      "type": "cast-narrated",
      "markerIndex": 7,
      "holdSec": 0.8,
      "narrationRole": "transition",
      "card": {
        "command": "rdc backup snapshot",
        "commandFull": "rdc backup snapshot my-app"
      }
    },
    {
      "id": "outro",
      "type": "outro",
      "narrationKey": "next-tutorial",
      "narrationRole": "outro"
    }
  ]
}
