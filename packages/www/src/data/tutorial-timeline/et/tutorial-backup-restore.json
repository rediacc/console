  "steps": [
    {
      "id": "tutorial-backup-restore-01",
      "markerIndex": 0,
      "replayStartSec": 2.799671,
      "replayEndSec": 9.00514,
      "narrationText": "Alustame sellest, mis peab üle elama. Töötavas repository's on fail, milles on üks ainus tellimuse rida. Jälgi seda, sest kohe võtame selle masina võrguühenduseta ja toome selle rea kuskilt mujalt tagasi.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-01.9eb9556b.mp3",
      "textHash": "9eb9556b252c9dbd651d83a2d187afb8f0b12c6be82a0e76b1af2e0583879d0f",
      "audioDurationSec": 16.032,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-01-after.bbf6d30b.mp3",
      "afterAudioDurationSec": 5.304,
      "afterTextHash": "bbf6d30b5d1ed8af03b951c81a14cb0630a827bf5423a91ae15de4fde1d74b2f"
    },
    {
      "id": "tutorial-backup-restore-02",
      "markerIndex": 1,
      "replayStartSec": 9.00514,
      "replayEndSec": 17.993741,
      "narrationText": "Kopeeri terve repository teise masinasse. Esimene koopia kannab üle kogu krüpteeritud image'i SSH kaudu, siin umbes kaks gigabaiti poole minutiga. Teisele poole jõuab varukoopia artefakt, mitte teine töötav rakendus.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-02.53262735.mp3",
      "textHash": "53262735c106a709a4d7ecb2ca9d682588c4981ea3d767a91db5ff2a7ca01184",
      "audioDurationSec": 14.592,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-02-after.9ee6a377.mp3",
      "afterAudioDurationSec": 2.592,
      "afterTextHash": "9ee6a377bbe238cc19a9e9485479d4efa7662a145351f63809a551598fa6339a"
    },
    {
      "id": "tutorial-backup-restore-03",
      "markerIndex": 2,
      "replayStartSec": 17.993741,
      "replayEndSec": 23.318642,
      "narrationText": "Küsi varundusmasinalt, mida ta hoiab. Repository on seal, oma nime all. Teine rida, mis näitab toorest identifikaatorit, on säilitatud baas, mis lubab järgmisel tõukel saata ainult muutunu.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-03.03bfaab4.mp3",
      "textHash": "03bfaab4af1e9cd84e9fa8f6418f805b0065f2af5c13413e1cd95d014800a252",
      "audioDurationSec": 12.672,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-03-after.6d7a9191.mp3",
      "afterAudioDurationSec": 4.992,
      "afterTextHash": "6d7a9191886e9caac1ea6ec1570453dc353ef6f5f8938584cced53853b0bb466"
    },
    {
      "id": "tutorial-backup-restore-04",
      "markerIndex": 3,
      "replayStartSec": 23.318642,
      "replayEndSec": 28.951964,
      "narrationText": "Nüüd katastroof. Peata peamasin ja ühenda selle krüpteeritud köide lahti. Selle masina jaoks on rakendus kadunud.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-04.9d2c0ff9.mp3",
      "textHash": "9d2c0ff94ce2d8276eee12aa09310a5ec7ce59d57d03e570c5d74de09b597802",
      "audioDurationSec": 8.52,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-04-after.534b3b4b.mp3",
      "afterAudioDurationSec": 3.72,
      "afterTextHash": "534b3b4b1e58cab2349db29849859a68cd926074d26073454c10c8d9087bc851"
    },
    {
      "id": "tutorial-backup-restore-05",
      "markerIndex": 4,
      "replayStartSec": 28.951964,
      "replayEndSec": 39.005334,
      "narrationText": "Muuda artefakt töötavaks repository'ks. Restore on käsk, mis seda teeb. Üks lipp nimetab uue repository, teine paigutab selle varundusmasinasse ja kolmas jätab kinnituse vahele.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-05.adb99f6c.mp3",
      "textHash": "adb99f6c7d684c3757f38541e214911416ce238e640ff06cdc6816689fc711b9",
      "audioDurationSec": 13.32,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-05-after.80c34e40.mp3",
      "afterAudioDurationSec": 3.72,
      "afterTextHash": "80c34e400b5c6f26736cd9f94ee30f48128ffee81356b47dbd63b32d74a217f7"
    },
    {
      "id": "tutorial-backup-restore-06",
      "markerIndex": 5,
      "replayStartSec": 39.005334,
      "replayEndSec": 46.52408,
      "narrationText": "Ühenda taastatud repository. Me ei käivita teadlikult selle konteinereid, sest tõestus, mida soovime, on andmed, mitte rakendus.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-06.05171d71.mp3",
      "textHash": "05171d71019f13c1c032538158ed92a796677b578e4fa63697735cf753f11f5d",
      "audioDurationSec": 7.224,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-06-after.40af2f05.mp3",
      "afterAudioDurationSec": 1.944,
      "afterTextHash": "40af2f05a18ab8e2bc74dfe5b84c40091d4af01698e2dbe46e37ad878e724a9d"
    },
    {
      "id": "tutorial-backup-restore-07",
      "markerIndex": 6,
      "replayStartSec": 46.52408,
      "replayEndSec": 52.091103,
      "narrationText": "Sama käsk, mille käivitasime alguses, seekord repository vastu, mida kaks käsku tagasi veel ei eksisteerinud. Sama fail, sama rida, sama tellimus.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-07.e93bea27.mp3",
      "textHash": "e93bea277a21e47119b46370f1687d0a094ac010de613770734801eb20e8caaa",
      "audioDurationSec": 12.672,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-07-after.7141bc5a.mp3",
      "afterAudioDurationSec": 4.344,
      "afterTextHash": "7141bc5a50e1bd7121b5cacf66a8b23112fd5a774df0f89a30674b7aadb67adb"
    },
    {
      "id": "tutorial-backup-restore-08",
      "markerIndex": 7,
      "replayStartSec": 52.091103,
      "replayEndSec": 53.948429,
      "narrationText": "Veel üks, varukoopiate jaoks, mille kaudu saad ajas tagasi kerida. Hetktõmmised lähevad chunk-hoidlasse, kus esimene käivitus laadib üles kõik ja iga järgnev käivitus laadib üles ainult muutunud plokid. Iga hetktõmmis taastub iseseisvalt. Selleks on vaja kontot ja litsentseeritud repository't, seega on see siin ainult kirjutatud, mitte käivitatud.",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-08.c4ef97da.mp3",
      "textHash": "c4ef97da093de4b2f80c9485696ea0faa3207977830164e621509e23daaa3f12",
      "audioDurationSec": 22.56,
      "afterAudioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/tutorial-backup-restore-08-after.b6f48577.mp3",
      "afterAudioDurationSec": 3.864,
      "afterTextHash": "b6f485774e6b57a97204fe128fa93b86bb074a250ce0a06615547ea31b47222a"
    }
  ],
  "narrationAudio": [
    {
      "id": "intro",
      "textHash": "234ea5464f921589fcf29f9ee48186f119112f651b3eb47ef707c75ab37554d6",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/intro.234ea546.mp3",
      "narrationText": "Sinu rakendus on töös, nii et veendume, et sa seda kunagi ei kaota! Selles õpetuses kopeerime terve repository teise masinasse, viime esimese võrguühenduseta ja toome andmed tagasi.",
      "audioDurationSec": 10.752
    },
    {
      "id": "three-steps",
      "textHash": "904e247fecad806aa28b101f84c9ce57a3e242690878c349fd16d1e0dffa3f12",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/three-steps.904e247f.mp3",
      "narrationText": "Kõik taandub kolmele sammule. Kopeeri repository masinasse, mida sa kontrollid, taasta see koopia omaette repository'ks ja tõesta seda, lugedes oma andmed tagasi välja.",
      "audioDurationSec": 10.272
    },
    {
      "id": "next-tutorial",
      "textHash": "2fe4f011475bef1884ec005ac7839785b52ff75876632148024bf2c250a303da",
      "audioSrc": "/assets/tutorials/audio/et/tutorial-backup-restore/next-tutorial.2fe4f011.mp3",
      "narrationText": "Sinu andmed on turvalised ja masinate vahel kaasaskantavad. Kohtumiseni järgmises!",
      "audioDurationSec": 4.512,
