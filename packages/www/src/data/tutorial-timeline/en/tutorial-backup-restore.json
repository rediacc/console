  "sampleRateHz": 48000,
  "voiceFingerprint": "6c6cf1ee371d",
  "transcriptHash": "b126848300fd9b82591d4c9c87b2fabf15c857a312e36e808b17e6f6884caee1",
  "steps": [
    {
      "id": "tutorial-backup-restore-01",
      "markerIndex": 0,
      "replayStartSec": 2.416144,
      "replayEndSec": 7.552816,
      "narrationText": "Start with the thing that has to survive. Inside the live repository there is a file holding a single order line. Keep an eye on it, because we are about to take this machine offline and get that line back from somewhere else.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-01.8161808d.mp3",
      "textHash": "8161808d7dea147dc5bd814cc7af5147726e957d92e51016303683cc40bf526a",
      "audioDurationSec": 12.672,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-01-after.b2a5fcf6.mp3",
      "afterAudioDurationSec": 3.384,
      "afterTextHash": "b2a5fcf6c0c7a8ca06ae75199de8e90cc6bdc795310b03d56db07246691a39b6"
    },
    {
      "id": "tutorial-backup-restore-02",
      "markerIndex": 1,
      "replayStartSec": 7.552816,
      "replayEndSec": 15.166453,
      "narrationText": "Copy the whole repository to a second machine. The first copy carries the entire encrypted image over SSH, about two gigabytes in half a minute here. What lands on the other side is a backup artifact, not a second running app.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-02.f9a24d09.mp3",
      "textHash": "f9a24d0918a90d2facca291133cef24d744c4ba774d40895c4a8af80dc86180b",
      "audioDurationSec": 12.984,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-02-after.62d70c0e.mp3",
      "afterAudioDurationSec": 3.384,
      "afterTextHash": "62d70c0eb6afe6023447b10f85f89dc97dcc3d2bde8224fdbf461e3d1bb29bf5"
    },
    {
      "id": "tutorial-backup-restore-03",
      "markerIndex": 2,
      "replayStartSec": 15.166453,
      "replayEndSec": 20.269124,
      "narrationText": "Ask the backup machine what it is holding. The repository is there under its own name. The second row, the one showing a raw identifier, is the retained base that lets the next push send only what changed.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-03.ec49584f.mp3",
      "textHash": "ec49584fe939105984b5fcdb4aa7c073f5af2951e148354a58c59db3b84729bc",
      "audioDurationSec": 12.36,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-03-after.0fed4a42.mp3",
      "afterAudioDurationSec": 4.992,
      "afterTextHash": "0fed4a422d09b3d5ce39bf884933ed2aee03b7e791b023b1a67f3d6515e71ca0"
    },
    {
      "id": "tutorial-backup-restore-04",
      "markerIndex": 3,
      "replayStartSec": 20.269124,
      "replayEndSec": 25.688963,
      "narrationText": "Now the disaster. Stop the primary and unmount its encrypted volume. As far as this machine is concerned, the application is gone.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-04.522e214c.mp3",
      "textHash": "522e214cf4c731d3fb1794f5e8c97181b56ac34c03bebe6b95765648a241bbd6",
      "audioDurationSec": 6.912,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-04-after.cfccf629.mp3",
      "afterAudioDurationSec": 4.344,
      "afterTextHash": "cfccf62921554cf9ebb8a0925e4e245f08ede663872ddcb468b3c7a90bb87844"
    },
    {
      "id": "tutorial-backup-restore-05",
      "markerIndex": 4,
      "replayStartSec": 25.688963,
      "replayEndSec": 34.978427,
      "narrationText": "Turn the artifact into a running repository. Restore is the verb that does it. One flag names the new repository, one places it on the backup machine, and one skips the confirmation.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-05.01e91173.mp3",
      "textHash": "01e911736d8d7806da8306c8477e0f66c54692a9ee868b8f8ba60f697c0490e5",
      "audioDurationSec": 10.584,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-05-after.981ece70.mp3",
      "afterAudioDurationSec": 3.384,
      "afterTextHash": "981ece706cfa479248ebab1ef6c7071198a62930d2fc61c36697f1e6ca7a9707"
    },
    {
      "id": "tutorial-backup-restore-06",
      "markerIndex": 5,
      "replayStartSec": 34.978427,
      "replayEndSec": 40.371515,
      "narrationText": "Mount the restored repository. We are deliberately not starting its containers, because the proof we want is the data, not the application.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-06.2fd99414.mp3",
      "textHash": "2fd994148d4bc97d6fba1e44eb5a59236348c469bb963f6be3bf8033fa04c462",
      "audioDurationSec": 8.184,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-06-after.c37cc348.mp3",
      "afterAudioDurationSec": 2.28,
      "afterTextHash": "c37cc3484bd0fd782366bb18bcb7b29daa57c7d9aaccc2a9e9a0b3f499b228ca"
    },
    {
      "id": "tutorial-backup-restore-07",
      "markerIndex": 6,
      "replayStartSec": 40.371515,
      "replayEndSec": 45.900768,
      "narrationText": "The same command we ran at the start, against a repository that did not exist two commands ago. Same file, same line, same order.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-07.fee1dbee.mp3",
      "textHash": "fee1dbee463dd87686a8ef62e12a9dfec6cadd371b10f2fbf87c2bc051d0f115",
      "audioDurationSec": 8.04,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-07-after.61a8714c.mp3",
      "afterAudioDurationSec": 3.072,
      "afterTextHash": "61a8714ca70b80a4429976bc5eec4e2b9fa1782a21c66ad86c8c112b963c32f3"
    },
    {
      "id": "tutorial-backup-restore-08",
      "markerIndex": 7,
      "replayStartSec": 45.900768,
      "replayEndSec": 47.739462,
      "narrationText": "One more, for backups you can roll back through. Snapshots go to the chunk store, where the first run uploads everything and every run after it uploads only the blocks that changed. Any snapshot restores on its own. It needs an account and a licensed repository, so here it is typed rather than run.",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-08.fc9b7855.mp3",
      "textHash": "fc9b785588982ff6c00682ee970e6fc32580f866456577f52c80f50b4cc3b5e1",
      "audioDurationSec": 16.632,
      "afterAudioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/tutorial-backup-restore-08-after.b8b12b94.mp3",
      "afterAudioDurationSec": 3.864,
      "afterTextHash": "b8b12b94f8287056e0a8f73f4034fc47cd6067b72b4253090eeb809869eb417f"
    }
  ],
  "narrationAudio": [
    {
      "id": "intro",
      "textHash": "97dd3f28f1af9cdbe37125595e1b809f04ef59e0818af4a3a7a06432878584da",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/intro.97dd3f28.mp3",
      "narrationText": "Your app is live, so let's make sure you never lose it! In this tutorial we copy a whole repository to a second machine, take the first one offline, and bring the data back.",
      "audioDurationSec": 9.48
    },
    {
      "id": "three-steps",
      "textHash": "3b8ab69581c5df30b8075e59406952d75bccd72a1281aa073d238586a0b1c84e",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/three-steps.3b8ab695.mp3",
      "narrationText": "It comes down to three steps. Copy the repository to a machine you control, restore that copy into a repository of its own, and then prove it by reading your data back out.",
      "audioDurationSec": 10.104
    },
    {
      "id": "next-tutorial",
      "textHash": "88f7b69c771d7b8c305781e0c8ec89f63bc9324574e00a9777f22482dc2341de",
      "audioSrc": "/assets/tutorials/audio/en/tutorial-backup-restore/next-tutorial.88f7b69c.mp3",
      "narrationText": "Your data is safe and portable across machines. See you in the next one!",
      "audioDurationSec": 4.2,
