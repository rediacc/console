    {
      "id": "blocks-not-bytes",
      "textHash": "64bc0c172f3dd3d370179b1590fc1530a23c3440fe004daabc49292f18031da6",
      "audioSrc": "/assets/tutorials/audio/tr/tutorial-delta-transfer/blocks-not-bytes.64bc0c17.mp3",
      "narrationText": "Püf nokta kurulumda. İlk push'tan sonra CLI, her iki makinede de özdeş değiştirilemez bir taban imajı tutar. Sonraki push, blokları bu tabana göre karşılaştırır ve yalnızca farkı gönderir. Bayrak yok, kayıt tutma yok, aynı push komutu.",
      "audioDurationSec": 15.552,
