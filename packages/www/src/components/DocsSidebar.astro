---
import { getCollection } from 'astro:content';
import type { Language } from '../i18n/types';
import { createTranslator } from '../i18n/utils';
import { getBaseSlug } from '../utils/slug';
import { makeCategoryLabel, makeSubcategoryLabel, subcategoriesFor } from '../utils/docs-categories';
import '../styles/sidebar-shared.css';

interface Props {
  currentLang: Language;
  currentUrl: string;
  visibleCategory?: string;
}

const { currentLang, currentUrl, visibleCategory } = Astro.props as Props;

// Fetch all docs for navigation
const allDocs = await getCollection('docs');
const docs = allDocs
  .filter((doc) => doc.data.language === currentLang)
  .sort((a, b) => {
    const categorySort = (a.data.category || 'other').localeCompare(
      b.data.category || 'other'
    );
    if (categorySort !== 0) return categorySort;
    return (a.data.order ?? 999) - (b.data.order ?? 999);
  });

// Group docs by category
const docsByCategory = docs.reduce((acc, doc) => {
  const category = doc.data.category || 'Other';
  if (!acc[category]) acc[category] = [];
  acc[category].push(doc);
  return acc;
}, {} as Record<string, typeof docs>);

// Sidebar order, deliberately NOT the browse page's order (utils/docs-categories exports
// CATEGORY_ORDER for that): the sidebar opens on Guides because that is where a reader
// already inside the docs continues, while browse opens on Tutorials.
// 'Use Cases' was missing and fell through to the `?? 99` bucket, sorting below Legal.
// The gap at 4, between Tutorials and Legal, is where it belongs.
const categoryOrder: Record<string, number> = {
  'Guides': 0,
  'Concepts': 1,
  'Reference': 2,
  'Tutorials': 3,
  'Use Cases': 4,
  'Legal': 5,
};
const categories = Object.keys(docsByCategory).sort((a, b) => {
  const pa = categoryOrder[a] ?? 99;
  const pb = categoryOrder[b] ?? 99;
  if (pa !== pb) return pa - pb;
  return a.localeCompare(b);
});
const visibleCategories = visibleCategory
  ? categories.filter((category) => category === visibleCategory)
  : categories;

// Get current doc slug for active state
const currentSlug = getBaseSlug(currentUrl);

// Get translator
const { t } = createTranslator(currentLang);

// The category vocabulary is shared with the docs browse page; see utils/docs-categories.
const categoryLabel = makeCategoryLabel(t);

// The subcategory vocabulary is shared with the browse page and with the schema's
// per-category legality check; see utils/docs-categories.
const subcategoryLabel = makeSubcategoryLabel(t);

// A localized doc that carries no `subcategory` resolves through the ENGLISH doc for the
// same base slug: the field is an identifier, English frontmatter is its source of truth,
// and the translation pipeline copies frontmatter on its own schedule. A value that is
// not legal for the doc's category is treated as unset rather than rendered as an
// unknown heading.
const englishSubcategoryBySlug = new Map<string, string>();
for (const doc of allDocs) {
  if ((doc.data.language ?? 'en') === 'en' && doc.data.subcategory) {
    englishSubcategoryBySlug.set(getBaseSlug(doc.slug), doc.data.subcategory);
  }
}

type DocEntry = (typeof docs)[number];

function resolveSubcategory(category: string, doc: DocEntry): string | undefined {
  const sub = doc.data.subcategory ?? englishSubcategoryBySlug.get(getBaseSlug(doc.slug));
  return sub && (subcategoriesFor(category) as readonly string[]).includes(sub)
    ? sub
    : undefined;
}

/**
 * Group a category's docs onto its shelves, in vocabulary order; docs keep their `order`
 * sort from above. Docs with no resolvable shelf render FLAT after the shelved ones, so
 * a locale whose frontmatter lags degrades to a plain list rather than to a wrong
 * heading. `groups: null` (nothing resolved at all) is the flat-render path.
 */
function groupBySubcategory(
  category: string,
  entries: DocEntry[]
): { groups: { key: string; entries: DocEntry[] }[] | null; rest: DocEntry[] } {
  const shelves = subcategoriesFor(category);
  if (shelves.length === 0) return { groups: null, rest: entries };
  const buckets = new Map<string, DocEntry[]>();
  const rest: DocEntry[] = [];
  for (const doc of entries) {
    const sub = resolveSubcategory(category, doc);
    if (sub) {
      if (!buckets.has(sub)) buckets.set(sub, []);
      buckets.get(sub)!.push(doc);
    } else {
      rest.push(doc);
    }
  }
  if (buckets.size === 0) return { groups: null, rest: entries };
  const groups = shelves
    .filter((shelf) => buckets.has(shelf))
    .map((shelf) => ({ key: shelf as string, entries: buckets.get(shelf)! }));
  return { groups, rest };
}

// Pre-calculate category states to avoid JSX parsing issues
const categoryStates = visibleCategories.map(category => {
  const itemCount = docsByCategory[category].length;
  const categoryId = `category-${category.toLowerCase().replace(/\s+/g, '-')}`;
  const hasActiveDoc = docsByCategory[category].some(doc => {
    const docSlug = getBaseSlug(doc.slug);
    return docSlug === currentSlug;
  });
  const isSmall = itemCount <= 3;
  const alwaysExpanded = category === 'Guides';
  const initialExpanded = hasActiveDoc || isSmall || alwaysExpanded;

  const grouped = groupBySubcategory(category, docsByCategory[category]);
  const subgroups = grouped.groups
    ? grouped.groups.map((group, index) => {
        const groupId = `${categoryId}-${group.key}`;
        const groupHasActive = group.entries.some((doc) => getBaseSlug(doc.slug) === currentSlug);
        return {
          key: group.key,
          groupId,
          label: subcategoryLabel(group.key),
          entries: group.entries,
          // The first shelf and the one holding the current page open; the rest start
          // closed, so a seven-shelf category reads as seven headings, not thirty links.
          expandedAttr: (groupHasActive || index === 0 ? 'true' : 'false') as 'true' | 'false',
        };
      })
    : null;
  const ungrouped = grouped.groups ? grouped.rest : docsByCategory[category];

  return {
    category,
    itemCount,
    categoryId,
    hasActiveDoc,
    expandedAttr: initialExpanded ? 'true' as const : 'false' as const,
    subgroups,
    ungrouped,
  };
});
---

<aside class="sidebar-base docs-sidebar" id="docs-sidebar-nav">
  <nav class="sidebar-nav docs-nav" role="navigation" aria-label={t('common.aria.documentationNavigation')}>
    <h2 class="sidebar-title">{t('pages.docs.title')}</h2>

    {/* The substring filter that used to sit here is gone. It was visible on
        phones only, it matched link text and nothing else (not body copy, not
        headings, not other categories once one was scoped away), and the docs
        header now carries a real search that queries the same index the
        site-wide modal does. Its two translation keys were not orphaned: the
        header trigger reuses both. */}

    <ul class="sidebar-list category-list">
      {categoryStates.map(({ category, itemCount, categoryId, hasActiveDoc, expandedAttr, subgroups, ungrouped }) => {

        return (
          <li
            class="sidebar-item category-item"
            data-category={category}
            data-item-count={String(itemCount)}
            data-is-active={hasActiveDoc ? 'true' : 'false'}
            aria-expanded={expandedAttr}
          >
            <button
              class="category-header"
              aria-expanded={expandedAttr}
              aria-controls={categoryId}
              data-collapsible={itemCount > 0 ? 'true' : 'false'}
            >
              {categoryLabel(category)}
              <span class="category-chevron" aria-hidden="true">▶</span>
            </button>
            <ul class="sidebar-list collapsible-list doc-list" id={categoryId}>
              {subgroups &&
                subgroups.map((group) => (
                  <li
                    class="sidebar-item subcategory-item"
                    data-subcategory={group.key}
                    aria-expanded={group.expandedAttr}
                  >
                    <button
                      class="subcategory-header"
                      aria-expanded={group.expandedAttr}
                      aria-controls={group.groupId}
                    >
                      {group.label}
                      <span class="subcategory-chevron" aria-hidden="true">▶</span>
                    </button>
                    <ul class="sidebar-list collapsible-list doc-list" id={group.groupId}>
                      {group.entries.map((doc) => {
                        const docSlug = getBaseSlug(doc.slug);
                        const isActive = docSlug === currentSlug;
                        // The number prefix is a CURRICULUM affordance and Tutorials is
                        // the only category that is one. Elsewhere `order` is a bare
                        // sort key: Guides runs -1, 0, 1, 3... and repeats values
                        // across shelves, so rendering it reads as a defect.
                        const num = category === 'Tutorials' ? doc.data.order : undefined;
                        return (
                          <li class="sidebar-item">
                            <a
                              href={`/${currentLang}/docs/${docSlug}`}
                              class={`sidebar-link doc-link ${isActive ? 'active' : ''}`}
                              aria-current={isActive ? 'page' : undefined}
                            >
                              {num !== undefined && (
                                <span class="doc-link-num" aria-hidden="true">{num}.</span>
                              )}
                              <span class="doc-link-text">{doc.data.title}</span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  </li>
                ))}
              {/* Docs with no resolvable shelf: a flat tail after the shelved groups, so
                  a lagging locale degrades to a plain list, never to a wrong heading. */}
              {ungrouped.map(doc => {
                const docSlug = getBaseSlug(doc.slug);
                const isActive = docSlug === currentSlug;
                return (
                  <li class="sidebar-item">
                    <a
                      href={`/${currentLang}/docs/${docSlug}`}
                      class={`sidebar-link doc-link ${isActive ? 'active' : ''}`}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {doc.data.title}
                    </a>
                  </li>
                );
              })}
            </ul>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<style>
  /* DocsSidebar specific overrides */
  .docs-sidebar {
    /* Uses shared sidebar-base styles from sidebar-shared.css */
  }

  .docs-nav {
    /* Uses shared sidebar-nav styles from sidebar-shared.css */
  }

  /* Add extra margin to category items for spacing */
  .category-item {
    margin-bottom: var(--space-6);
  }

  /* Subcategory groups inside Tutorials */
  .subcategory-item {
    margin: var(--space-2) 0 var(--space-3) 0;
  }

  .subcategory-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-1) var(--space-2);
    background: none;
    border: none;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
  }

  .subcategory-header:hover {
    color: var(--color-text);
  }

  .subcategory-chevron {
    font-size: 0.6em;
    transition: transform var(--transition-speed);
  }

  .subcategory-item[aria-expanded="true"] .subcategory-chevron {
    transform: rotate(90deg);
  }

  .subcategory-item[aria-expanded="false"] > .collapsible-list {
    display: none;
  }

  /* Order-number prefix on tutorial doc links */
  .doc-link-num {
    display: inline-block;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    margin-inline-end: var(--space-1);
    min-width: 1.6em;
  }

  .doc-link.active .doc-link-num {
    color: inherit;
  }

  /* Responsive Design */
  @media (max-width: 48rem) {
    .docs-sidebar {
      position: static;
      max-height: none;
      overflow-y: visible;
    }
  }
</style>

<script is:inline>
  (function() {
    // No `window.rediaccDocsSidebarInitialized` guard. It made init run once
    // per page LOAD rather than once per page, so after an Astro view
    // transition the freshly rendered categories had no click handlers at all
    // and the rail stopped collapsing. Re-entry is handled where it belongs
    // instead: every init below is idempotent per element, via the
    // `data-initialized` marks that were already there.

    /**
     * Set collapsed/expanded state of a category
     */
    function setCollapsedState(categoryItem, isCollapsed) {
      const button = categoryItem.querySelector('.category-header');
      if (!button) return;

      if (isCollapsed) {
        button.setAttribute('aria-expanded', 'false');
        categoryItem.setAttribute('aria-expanded', 'false');
      } else {
        button.setAttribute('aria-expanded', 'true');
        categoryItem.setAttribute('aria-expanded', 'true');
      }
    }

    /**
     * Initialize collapsible category menus
     */
    function initCollapsibleCategories() {
      const categoryItems = document.querySelectorAll('[data-category][data-item-count]');

      categoryItems.forEach(item => {
        // Skip if already initialized
        if (item.dataset.initialized === 'true') return;
        item.dataset.initialized = 'true';

        const button = item.querySelector('.category-header');
        const category = item.dataset.category;

        if (!button) return;

        // Check sessionStorage for saved state
        const storageKey = `rediacc_docs_cat_${category}`;
        const savedState = sessionStorage.getItem(storageKey);

        if (savedState !== null) {
          // Apply saved state
          const isExpanded = savedState === 'true';
          setCollapsedState(item, !isExpanded);
        }
        // Otherwise, keep the HTML's initial state (no flash)

        // Click handler
        button.addEventListener('click', function(e) {
          e.preventDefault();
          const currentExpanded = item.getAttribute('aria-expanded') === 'true';
          const newExpanded = !currentExpanded;

          setCollapsedState(item, !newExpanded);
          sessionStorage.setItem(storageKey, newExpanded ? 'true' : 'false');
        });

        // Keyboard navigation
        button.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            button.click();
          }
        });
      });
    }

    /**
     * Initialize collapsible subcategory sub-headings (the per-category shelves).
     */
    function initCollapsibleSubcategories() {
      const subItems = document.querySelectorAll('[data-subcategory]');
      subItems.forEach((item) => {
        if (item.dataset.initialized === 'true') return;
        item.dataset.initialized = 'true';

        const button = item.querySelector('.subcategory-header');
        const sub = item.dataset.subcategory;
        if (!button || !sub) return;

        // Keyed by the group's DOM id (category + shelf), not the bare shelf id:
        // shelf identifiers repeat across categories (`ai-agents` shelves exist in
        // three), and one shared key would collapse them in lockstep.
        const storageKey = `rediacc_docs_sub_${button.getAttribute('aria-controls') || sub}`;
        const savedState = sessionStorage.getItem(storageKey);
        if (savedState !== null) {
          const isExpanded = savedState === 'true';
          item.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
          button.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        }

        button.addEventListener('click', (e) => {
          e.preventDefault();
          const isExpanded = item.getAttribute('aria-expanded') === 'true';
          const next = !isExpanded;
          item.setAttribute('aria-expanded', next ? 'true' : 'false');
          button.setAttribute('aria-expanded', next ? 'true' : 'false');
          sessionStorage.setItem(storageKey, next ? 'true' : 'false');
        });

        button.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            button.click();
          }
        });
      });
    }

    /**
     * Put the current page's link inside the visible part of the rail.
     *
     * Deliberately NOT Element.scrollIntoView: that walks every scrollable
     * ancestor including the document, so nudging a link inside a 250px rail
     * also scrolled the article. Arithmetic on the rail's own scrollTop moves
     * the rail and nothing else. Guarded on the rail actually being a scroll
     * container, because with a max-height rail a short category is not one.
     */
    function revealActiveDoc() {
      const nav = document.querySelector('.docs-sidebar .sidebar-nav');
      const active = nav && nav.querySelector('.doc-link.active');
      if (!nav || !active) return;
      if (nav.scrollHeight <= nav.clientHeight) return;

      const navBox = nav.getBoundingClientRect();
      const linkBox = active.getBoundingClientRect();
      const margin = 24;
      if (linkBox.top < navBox.top + margin) {
        nav.scrollTop -= (navBox.top + margin) - linkBox.top;
      } else if (linkBox.bottom > navBox.bottom - margin) {
        nav.scrollTop += linkBox.bottom - (navBox.bottom - margin);
      }
    }

    // Initialize on various events
    function init() {
      initCollapsibleCategories();
      initCollapsibleSubcategories();
      revealActiveDoc();
    }

    // Astro View Transitions support
    document.addEventListener('astro:page-load', init);

    // Initial load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
