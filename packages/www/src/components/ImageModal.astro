---
import { createTranslator } from '../i18n/utils';
import type { Language } from '../i18n/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { t } = createTranslator(lang);
---

<div
  class="image-modal"
  id="image-modal"
  role="dialog"
  aria-hidden="true"
  aria-modal="true"
  aria-label={t('common.aria.imageViewer')}
>
  <div class="image-modal-content" id="image-modal-content">
    <button class="btn--icon image-modal-close" id="image-modal-close-btn" aria-label={t('common.aria.closeImageModal')}>×</button>
    <button class="btn--icon nav-btn nav-prev" id="image-modal-prev-btn" aria-label={t('common.aria.previousImage')}>‹</button>
    <button class="btn--icon nav-btn nav-next" id="image-modal-next-btn" aria-label={t('common.aria.nextImage')}>›</button>
    <div class="zoom-controls">
      <button class="btn--icon zoom-btn zoom-in" id="image-modal-zoom-in-btn" aria-label={t('common.aria.zoomIn')}>+</button>
      <button class="btn--icon zoom-btn zoom-out" id="image-modal-zoom-out-btn" aria-label={t('common.aria.zoomOut')}>−</button>
      <button class="btn--icon zoom-btn zoom-reset" id="image-modal-zoom-reset-btn" aria-label={t('common.aria.resetZoom')}>⌂</button>
    </div>
    <div class="image-container">
      <img id="modal-image" src="" alt="" class="modal-image" loading="lazy" decoding="async" />
    </div>
    <div class="image-indicator">
      <span class="indicator-text" id="image-indicator"></span>
    </div>
  </div>
</div>

<style>
  /* THE aria-hidden-focus FIX.
     This dialog is mounted on EVERY page of the site with aria-hidden="true"
     while containing six focusable buttons, which axe-core reports as a
     serious violation site-wide. The closed state used to be
     `opacity: 0; pointer-events: none`, and neither of those takes an element
     out of the tab order, so a keyboard user tabbed through six invisible
     controls on every page. `visibility: hidden` does take them out, and the
     zero-duration visibility transition is delayed on the way out so the
     fade still plays. No JavaScript change: the same aria-hidden attribute
     the existing script already toggles drives it. */
  .image-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-toast);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, var(--opacity-85));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--transition-duration-base) ease,
      visibility 0s linear var(--transition-duration-base);
  }
  .image-modal[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity var(--transition-duration-base) ease,
      visibility 0s;
  }
  .image-modal-content {
    position: relative;
    width: min(92vw, 1400px);
    height: min(90vh, 900px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-in;
  }
  .image-container:active {
    cursor: grabbing;
  }
  .modal-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transform-origin: center center;
    transition: transform var(--transition-duration-fast) ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* Shape, hit area, focus ring and hover come from .btn--icon in main.css.
     What is left is the skin these six need to be legible on a near-black
     backdrop, which is the one thing the light-surface primitive cannot give
     them. */
  .image-modal-close,
  .nav-btn,
  .zoom-btn {
    position: absolute;
    background: rgba(255, 255, 255, var(--opacity-12));
    border-color: var(--color-border-on-dark);
    color: var(--gray-0);
  }
  .image-modal-close:hover,
  .nav-btn:hover:not(:disabled),
  .zoom-btn:hover {
    background: rgba(255, 255, 255, var(--opacity-25));
    border-color: rgba(255, 255, 255, var(--opacity-45));
    color: var(--gray-0);
  }
  .image-modal-close {
    top: calc(-1 * var(--space-10));
    inset-inline-end: 0;
  }
  .nav-btn {
    top: 50%;
    transform: translateY(-50%);
    height: var(--space-16);
  }
  .nav-prev {
    inset-inline-start: calc(-1 * var(--space-16));
  }
  .nav-next {
    inset-inline-end: calc(-1 * var(--space-16));
  }
  .nav-btn:disabled {
    opacity: var(--opacity-35);
    cursor: not-allowed;
  }
  .zoom-controls {
    position: absolute;
    bottom: calc(-1 * var(--space-12));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: var(--space-2);
  }
  .zoom-btn {
    position: static;
  }
  .image-indicator {
    position: absolute;
    bottom: calc(-1 * var(--space-12));
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    height: var(--touch-target-preferred);
    color: var(--color-text-on-dark-muted);
    font-size: var(--font-size-sm);
    font-family: var(--font-family-mono);
  }
  .indicator-text:empty {
    display: none;
  }
  /* Hide prev/next when a single-image view is active */
  .image-modal[data-single='true'] .nav-prev,
  .image-modal[data-single='true'] .nav-next {
    display: none;
  }
  @media (max-width: 48rem) {
    .image-modal-content {
      width: 96vw;
      height: 80vh;
    }
    .nav-prev {
      inset-inline-start: var(--space-1);
    }
    .nav-next {
      inset-inline-end: var(--space-1);
    }
    .image-modal-close {
      top: var(--space-1);
      inset-inline-end: var(--space-1);
    }
    .zoom-controls {
      bottom: var(--space-2);
    }
    .image-indicator {
      bottom: var(--space-2);
      inset-inline-end: var(--space-2);
    }
  }
</style>
