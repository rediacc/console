---
import { EXTERNAL_LINKS } from '../config/constants';
import { createTranslator } from '../i18n/utils';
import type { Language } from '../i18n/types';
import AccountLink from './AccountLink.astro';

interface Props {
  plan: {
    id: string;
    monthly: number;
    annual: number;
    /**
     * Show "Contact us" instead of a price. This used to be `plan.id ===
     * 'enterprise'`, which meant renaming a tier silently published the
     * placeholder number the branch existed to hide.
     */
    contactOnly?: boolean;
  };
  metrics: Array<{ label: string; tooltip?: string; value: string }>;
  lang: Language;
  /**
   * Which catalog branch the card's copy comes from. A closed union, not a free
   * string: it used to be a plain namespace string, and every key reached
   * through it was invisible to check-dead-translation-keys, which reported
   * seven live keys as unreachable because a component prop is not a literal it
   * can resolve. The two branches below spell their paths out.
   */
  namespace?: 'pricing' | 'disasterRecovery';
  useCheckout?: boolean;
}

const { plan, metrics, lang, namespace = 'pricing', useCheckout = false } = Astro.props;
const { t } = createTranslator(lang);

const isDr = namespace === 'disasterRecovery';
const planName = isDr
  ? t(`pages.disasterRecovery.plans.${plan.id}.name`)
  : t(`pages.pricing.plans.${plan.id}.name`);
const contactUs = isDr
  ? t('pages.disasterRecovery.ui.contactUs')
  : t('pages.pricing.ui.contactUs');
const contactUsSub = isDr
  ? t('pages.disasterRecovery.ui.contactUsSub')
  : t('pages.pricing.ui.contactUsSub');
// Resolved lazily. Hoisting this out of the branch asked for
// pages.pricing.ui.cta.<plan>.primary on every card, including the two that
// render the checkout button instead, and the build printed
// "Translation key not found" 26 times per page for keys nothing displays.
const ctaLabel = () =>
  isDr
    ? t(`pages.disasterRecovery.ui.cta.${plan.id}.primary`)
    : t(`pages.pricing.ui.cta.${plan.id}.primary`);

const priceFormatter = new Intl.NumberFormat(lang === 'en' ? 'en-US' : lang, {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
});
const formatPrice = (amount: number) => priceFormatter.format(amount);

const usesCheckout = useCheckout && !plan.contactOnly;
---

<div
  class="cf-pricing-card"
  data-monthly-price={plan.monthly}
  data-annual-price={plan.annual}
>
  <h3 class="cf-plan-name">{planName}</h3>
  <div class="cf-price-block">
    {plan.contactOnly ? (
      <>
        <div class="cf-price cf-contact-us">{contactUs}</div>
        <div class="cf-price-subtitle">{contactUsSub}</div>
      </>
    ) : (
      <>
        <div class="cf-price-line">
          <span class="cf-price" data-monthly={formatPrice(plan.monthly)} data-annual={formatPrice(plan.annual)}>{formatPrice(plan.monthly)}</span>
          <span class="cf-price-period" data-monthly="/mo" data-annual="/yr">/mo</span>
        </div>
        <div class="cf-price-subtitle cf-annual-note" data-monthly={`or ${formatPrice(plan.annual)}/yr`} data-annual={`or ${formatPrice(plan.monthly)}/mo`}>
          or {formatPrice(plan.annual)}/yr
        </div>
      </>
    )}
  </div>
  <ul class="cf-features">
    {metrics.map((metric) => (
      <li>
        <span
          class="cf-feature-info"
          data-tooltip={metric.tooltip ?? metric.label}
          aria-label={metric.tooltip ?? metric.label}
          tabindex="0"
        >
          i
        </span>
        <span><strong>{metric.value}</strong> {metric.label}</span>
      </li>
    ))}
  </ul>
  {plan.contactOnly ? (
    <a
      href={EXTERNAL_LINKS.SCHEDULE_CONSULTATION}
      target="_blank"
      rel="noopener noreferrer"
      class="cf-cta-btn"
      data-track="cta_click"
      data-track-label="pricing-cta"
      data-track-dest={plan.id}
    >
      {ctaLabel()}
    </a>
  ) : usesCheckout ? (
    <button
      type="button"
      class="cf-cta-btn"
      data-checkout={plan.id}
      data-track="cta_click"
      data-track-label="pricing-checkout"
      data-track-dest={plan.id}
    >
      {t('pages.pricing.ui.startTrial')}
    </button>
  ) : (
    <AccountLink
      label={ctaLabel()}
      className="cf-cta-btn"
      trackEvent="cta_click"
      trackLabel="pricing-cta"
      trackDest={plan.id}
    />
  )}
</div>

<script>
  // Self-contained handlers for the card's CTAs. Astro deduplicates this
  // script — it runs once regardless of how many cards are rendered.
  document.addEventListener('DOMContentLoaded', () => {
    // Stripe checkout buttons (Professional and Business plans).
    // Marketing-host detection delegated to window.__rediaccIsMarketingHost
    // (defined in BaseLayout.astro, mirrors src/utils/marketing-host.ts).
    // On marketing hosts (www / localhost / *.rediacc.workers.dev) we open
    // the region picker; on portal hosts (regional / edge / bench / on-prem)
    // we navigate directly. Fallback to direct nav if the helper is missing.
    const isMarketing =
      typeof window.__rediaccIsMarketingHost === 'function' &&
      window.__rediaccIsMarketingHost(window.location.hostname);

    document.querySelectorAll<HTMLButtonElement>('[data-checkout]').forEach((btn) => {
      if (btn.dataset.checkoutBound) return;
      btn.dataset.checkoutBound = 'true';

      btn.addEventListener('click', () => {
        const planId = btn.dataset.checkout!;
        const activeToggle = document.querySelector('.billing-toggle-btn.active') as HTMLElement | null;
        const billingPeriod = activeToggle?.dataset.period === 'annual' ? 'annual' : 'monthly';

        window.plausible?.('checkout_start', { props: { plan: planId, period: billingPeriod } });

        const params = new URLSearchParams({
          checkout: planId.toUpperCase(),
          period: billingPeriod,
          returnUrl: window.location.href,
        });
        const targetPath = `/account/?${params}`;

        if (!isMarketing) {
          window.location.href = targetPath;
        } else {
          window.openRegionPicker?.(targetPath);
        }
      });
    });
  });
</script>
