---
import { createTranslator } from '../i18n/utils';
import type { Language } from '../i18n/types';

interface Props {
  lang?: Language;
}

type PlanKey = 'professional' | 'business' | 'enterprise';

const { lang = 'en' } = Astro.props;
const { t, to } = createTranslator(lang);

const comparison = to('pages.pricing.comparison');
// Cells are booleans, not glyphs. Storing the tick and dash characters as
// translated values put a bare em dash in all 13 catalogs and made a screen
// reader announce the dash character instead of "not included".
const rows = comparison?.rows as
  | Array<{ label: string } & Record<PlanKey, boolean>>
  | undefined;
const included = t('pages.pricing.comparison.included');
const notIncluded = t('pages.pricing.comparison.notIncluded');

// The three buyable columns, in card order. Community is gone: it is the
// post-cancellation fallback state, not a plan, and giving it a full column of
// real values advertised something a visitor has no way to select.
const planColumns: Array<{ key: PlanKey; label: string }> = [
  { key: 'professional', label: t('pages.pricing.plans.professional.name') },
  { key: 'business', label: t('pages.pricing.plans.business.name') },
  { key: 'enterprise', label: t('pages.pricing.plans.enterprise.name') },
];
---

{rows && rows.length > 0 && (
  <section class="comparison-section section-light" id="compare">
    <div class="container">
      <div class="comparison-header">
        <h2>{comparison?.heading}</h2>
      </div>

      <!-- One flat table, no accordions and no mobile plan picker. It carried
           20 rows across 5 collapsibles, of which 10 read identically in every
           column and 3 more only repeated what the card already prints. What
           is left is the set that actually decides between the plans. -->
      <div class="comparison-table-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <td></td>
              {planColumns.map((plan) => (
                <th scope="col">{plan.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row" class="comparison-row-label">{row.label}</th>
                {planColumns.map((plan) => (
                  <td>
                    <span aria-hidden="true">{row[plan.key] ? '\u2713' : '\u2014'}</span>
                    <span class="sr-only">{row[plan.key] ? included : notIncluded}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}
