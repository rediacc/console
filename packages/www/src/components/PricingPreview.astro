---
import { createTranslator } from '../i18n/utils';
import type { Language } from '../i18n/types';
import BillingToggle from './BillingToggle.astro';
import CfPricingCard from './CfPricingCard.astro';
import CorporateGuarantee from './CorporateGuarantee.astro';
import { buildMetricsFor, buildPlans } from './pricing-plans';
import '../styles/pricing-page.css';

interface Props {
  lang?: Language;
}

const { lang = 'en' } = Astro.props;
const { t } = createTranslator(lang);

const plans = buildPlans();
const buildMetrics = buildMetricsFor(lang);
---

<section class="cf-pricing-section" id="pricing">
  <div class="cf-pricing-container" data-pricing-scope>
    <div class="section-header reveal">
      <h2 class="section-title">{t('pricingPreview.title')}</h2>
      <p class="section-subtitle">{t('pricingPreview.subtitle')}</p>
    </div>
    <BillingToggle lang={lang} class="reveal" />
    <div class:list={['cf-pricing-grid reveal', plans.length === 2 && 'two-up', plans.length === 3 && 'three-up']}>
      {plans.map(plan => (
        // useCheckout matches the pricing page. Without it this card fell back
        // to a generic /account/ link, so a visitor who bought from the home
        // page landed on the portal root with no plan and no billing period.
        <CfPricingCard plan={plan} metrics={buildMetrics(plan.id)} lang={lang} useCheckout={true} />
      ))}
    </div>
    <p class="pricing-tax-note">{t('pages.pricing.ui.taxDisclaimer')}</p>
    <a href={`/${lang}/pricing`} class="pricing-preview-compare" data-track="cta_click" data-track-label="pricing-compare">
      {t('pricingPreview.compareAll')} &rarr;
    </a>
    <CorporateGuarantee lang={lang} />
  </div>
</section>
