---
/**
 * Renders a docs page as a printable cheat-sheet card grid.
 *
 * The slot is the rendered markdown of the page's own locale; it is split at
 * top-level `<h2>` boundaries and each chunk becomes a card.  Tints cycle by
 * card index, so no authoring directive is needed in the markdown.
 */
import { splitIntoCards } from '../utils/card-grid';
import '../styles/cheatsheet.css';

interface Props {
  /** Localized document title, repeated as the print-only page header. */
  title: string;
}

const { title } = Astro.props as Props;

const TINTS = ['cat-blue', 'cat-green', 'cat-amber', 'cat-purple', 'cat-rose', 'cat-teal'];

const cards = splitIntoCards(await Astro.slots.render('default'));
---

<div class="print-page-header" aria-hidden="true">{title}</div>

<div class="cs-cards">
  <div class="cs-grid">
    {cards.map((card, index) => (
      <section
        class={index === 0 ? 'cs-card' : `cs-card ${TINTS[(index - 1) % TINTS.length]}`}
        set:html={card}
      />
    ))}
  </div>
</div>

<!--
  is:inline is load-bearing, do NOT turn this into a scoped <style>.

  These rules deliberately reach OUTSIDE the component (the DocsLayout chrome,
  `html`/`body`, and a selector-less `@page`), so Astro cannot scope them.  A
  processed <style> is bundled into the stylesheet shared by every page built
  from [slug].astro -- 1015 docs pages -- which would hand all of them
  `@page { size: A4 landscape }` and an unscoped
  `.docs-article { max-width: none !important }`.  Measured, not theorised:
  that is what the first build of this component produced.  Inline keeps the
  rules in the 13 cheat-sheet pages that render it.
-->
<style is:inline>
  /* ------------------------------------------------------------------ */
  /* Print-only page header — repeats on every printed page              */
  /* ------------------------------------------------------------------ */
  .print-page-header {
    display: none;
  }

  /* ------------------------------------------------------------------ */
  /* Override DocsLayout constraints for full-width cheat sheet           */
  /* ------------------------------------------------------------------ */

  /*
    .docs-article has max-width: var(--container-md) which clips the 3-col
    grid.  Override it and the article-content wrapper to use full width.
  */
  .docs-article {
    max-width: none !important;
  }

  .article-content .cs-cards {
    max-width: none;
    width: 100%;
  }

  /* ------------------------------------------------------------------ */
  /* Grid layout — one card per top-level section                        */
  /* ------------------------------------------------------------------ */

  .cs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  /* First section: branding header — full-bleed, docked left to right */
  .cs-grid section:first-child {
    border-radius: 0;
    margin-left: -0.5rem;
    margin-right: -0.5rem;
    padding-left: 1rem !important;
    padding-right: 1rem !important;
    width: calc(100% + 1rem);
  }

  /* Keep cards in normal flow at their natural height. */
  .cs-grid section {
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    overflow: hidden !important;
    position: static !important;
    container-type: normal !important;
    box-sizing: border-box;
  }

  .cs-grid section > * {
    position: static !important;
  }

  /* Prevent long code lines from overflowing card boundaries */
  .cs-grid pre {
    overflow: hidden !important;
  }

  .cs-grid pre code {
    white-space: pre-wrap !important;
    word-break: break-all !important;
  }

  /* Scroll margin for TOC anchor links */
  .cs-grid section h2 {
    scroll-margin-top: calc(var(--nav-height, 60px) + 1rem);
  }

  /* Already 1 column — no responsive breakpoints needed */

  /* ------------------------------------------------------------------ */
  /* Print — A4 landscape, 3-column grid with row-aligned cards          */
  /* ------------------------------------------------------------------ */
  @page {
    size: A4 landscape;
    margin: 4mm;
  }

  @media print {
    /* Repeated page header — position:fixed repeats on every printed page */
    .print-page-header {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 10px;
      line-height: 10px;
      font-family: var(--cs-font, 'Inter', sans-serif);
      font-size: 7px;
      font-weight: 600;
      color: #0e7490;
      text-align: center;
      border-bottom: 0.5px solid #ccc;
      background: #fff;
      z-index: 9999;
    }

    /* Strip ALL layout chrome — full page for content */
    html, body {
      margin: 0 !important;
      padding: 0 !important;
      font-size: 6.5px !important;
      line-height: 1.15 !important;
      overflow: visible !important;
    }

    .site-footer, .footer, [class*="footer"] {
      display: none !important;
      height: 0 !important;
    }

    header, nav, aside, footer,
    .docs-shell-top, .docs-header-row,
    .article-header, .fallback-notice,
    .sidebar-base, .toc-sidebar {
      display: none !important;
    }

    .docs-shell {
      max-width: none !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .docs-layout {
      display: block !important;
    }

    .docs-article {
      max-width: none !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .docs-content {
      padding: 0 !important;
      margin: 0 !important;
    }

    .article-content {
      max-width: none !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    .article-content .cs-cards {
      margin: 0;
      padding-top: 12px;
    }

    /* 2-column CSS columns for print */
    .cs-grid {
      display: block !important;
      columns: 2;
      column-gap: 3px;
      column-fill: balance;
    }

    /* Header spans full width above columns */
    .cs-grid section:first-child {
      column-span: all;
      border-radius: 0;
      margin: 0 0 2px 0;
      padding: 2px 6px !important;
      width: 100%;
    }

    .cs-grid section {
      display: inline-block;
      width: 100%;
      padding: 2px 4px !important;
      margin: 0 0 2px 0;
      break-inside: avoid;
      page-break-inside: avoid;
    }

    .cs-grid section:last-child {
      margin-bottom: 0;
    }

    /* Compact all typography for print */
    .cs-grid h2 {
      font-size: 7px !important;
      margin-bottom: 1px !important;
      padding-bottom: 1px !important;
    }

    .cs-grid h3 {
      font-size: 6.5px !important;
      margin-top: 1px !important;
      margin-bottom: 1px !important;
    }

    .cs-grid p {
      margin-bottom: 1px !important;
      font-size: 6.5px !important;
    }

    .cs-grid ul,
    .cs-grid ol {
      margin: 0 0 1px 0 !important;
      padding-left: 7px !important;
    }

    .cs-grid li {
      margin-bottom: 0 !important;
      font-size: 6.5px !important;
    }

    .cs-grid pre {
      padding: 1px 3px !important;
      margin: 1px 0 !important;
    }

    .cs-grid pre code {
      font-size: 6px !important;
      line-height: 1.15 !important;
    }

    .cs-grid code {
      font-size: 6px !important;
      padding: 0 1px !important;
    }

    .cs-grid table {
      font-size: 6px !important;
    }

    .cs-grid th,
    .cs-grid td {
      padding: 1px 2px !important;
      font-size: 6px !important;
    }

    .cs-grid blockquote {
      margin: 1px 0 !important;
      padding: 1px 3px !important;
    }

    .cs-grid blockquote p {
      font-size: 6px !important;
    }
  }
</style>
