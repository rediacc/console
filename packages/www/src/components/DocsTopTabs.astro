---
import { getCollection } from 'astro:content';
import type { Language } from '../i18n/types';
import { createTranslator } from '../i18n/utils';
import { getBaseSlug } from '../utils/slug';
import { CATEGORY_KEYS, categoryAnchor, groupByCategory, type DocCategory } from '../utils/docs-categories';

interface Props {
  currentLang: Language;
  currentCategory?: string;
  variant?: 'article' | 'index';
}

const {
  currentLang,
  currentCategory,
  variant = 'article',
} = Astro.props as Props;

const { t } = createTranslator(currentLang);

// The category vocabulary, its display order and the browse page's anchor transform all
// come from utils/docs-categories. This component used to carry a second copy of all
// three, which is the exact drift that module's header comment exists to prevent: the
// tabs and the browse page agreed on six categories and on `#use-cases` by coincidence,
// not by contract.
function categoryLabel(cat: string): string {
  const k = CATEGORY_KEYS[cat as DocCategory];
  // The schema (src/content/config.ts) restricts category to this vocabulary.
  // Failing loudly here keeps the invariant if the two lists ever drift: the
  // silent fallback used to render the raw frontmatter string as a seventh tab.
  // (docs-categories' makeCategoryLabel is deliberately LENIENT, which is right for
  // the browse page's headings and wrong for navigation chrome on 1,015 pages.)
  if (!k) throw new Error(`Unknown docs category "${cat}"; expected one of: ${Object.keys(CATEGORY_KEYS).join(', ')}`);
  return t(k);
}

const allDocs = await getCollection('docs');
// groupByCategory orders by CATEGORY_ORDER, sorts each group by frontmatter `order` and
// drops empty groups, which is precisely what the local reduce-plus-sort pair did.
const groups = groupByCategory(allDocs.filter((doc) => doc.data.language === currentLang));
---

<nav class="docs-top-tabs" aria-label={t('common.aria.docsSections')}>
  <ul class="docs-top-tabs-list">
    {groups.map(({ category, docs }) => {
      const anchor = categoryAnchor(category);
      const href = variant === 'index'
        ? `#${anchor}`
        : `/${currentLang}/docs/${getBaseSlug(docs[0].slug)}`;
      const isActive = variant === 'article' && currentCategory === category;

      return (
        <li class="docs-top-tabs-item">
          <a
            href={href}
            class={`docs-top-tab-link ${isActive ? 'active' : ''}`}
            data-docs-tab={anchor}
          >
            {categoryLabel(category)}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script is:inline>
  (function () {
    function initIndexTabActiveState() {
      const tabs = document.querySelectorAll('.docs-top-tab-link[data-docs-tab]');
      if (tabs.length === 0) return;

      const setActiveFromHash = () => {
        const hash = window.location.hash.replace('#', '');
        if (!hash) return;

        tabs.forEach((tab) => {
          const match = tab.getAttribute('data-docs-tab') === hash;
          tab.classList.toggle('active', match);
        });
      };

      setActiveFromHash();

      // `hashchange` alone was NEVER enough, and the tab highlight has therefore never
      // worked for a real click. Astro's client router intercepts same-origin link clicks
      // and updates the URL through the History API, which does not emit `hashchange`;
      // only a programmatic `location.hash = ...` did, which is why this read correct in
      // every console test. Measured on the built browse page: after clicking the
      // `Use Cases` tab the hash was `#use-cases` and NO tab carried `.active`.
      // The click path therefore sets the state from the link itself rather than waiting
      // for an event that will not arrive, and `hashchange` stays for back/forward.
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const wanted = tab.getAttribute('data-docs-tab');
          tabs.forEach((other) => {
            other.classList.toggle('active', other.getAttribute('data-docs-tab') === wanted);
          });
        });
      });
      window.addEventListener('hashchange', setActiveFromHash);
    }

    document.addEventListener('astro:page-load', initIndexTabActiveState);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initIndexTabActiveState);
    } else {
      initIndexTabActiveState();
    }
  })();
</script>

<style>
  /* `flex: 1 1 auto` with `min-width: 0`. The `flex: 1` here was inert until
     .docs-header-row became a real flex container; now that it is one, the
     min-width is what lets this strip shrink below its content width so the
     tabs scroll horizontally instead of pushing the search and theme controls
     off the end of the row. */
  .docs-top-tabs {
    border-bottom: none;
    overflow-x: auto;
    scrollbar-width: thin;
    flex: 1 1 auto;
    min-width: 0;
  }

  .docs-top-tabs-list {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    min-width: max-content;
  }

  .docs-top-tabs-item {
    margin: 0;
  }

  .docs-top-tab-link {
    display: inline-flex;
    align-items: center;
    /* Same token the sticky chrome's min-height and the anchor offset read, so
       a change to the chrome's height moves all three together. It used to be
       this literal 3rem in two files and a third copy inside a calc(). */
    height: var(--docs-chrome-height, 3rem);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    border-bottom: 2px solid transparent;
    transition: color var(--transition-duration-base), border-color var(--transition-duration-base);
  }

  .docs-top-tab-link:hover {
    color: var(--color-text);
  }

  .docs-top-tab-link.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .docs-top-tab-link:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
