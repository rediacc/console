---
import { getCollection } from 'astro:content';
import type { Language } from '../i18n/types';
import { createTranslator } from '../i18n/utils';
import { CATEGORY_KEYS, groupByCategory, type DocCategory } from '../utils/docs-categories';

interface Props {
  currentLang: Language;
  currentCategory?: string;
}

const {
  currentLang,
  currentCategory,
} = Astro.props as Props;

const { t } = createTranslator(currentLang);

// The category vocabulary and its display order come from utils/docs-categories. This
// component used to carry a second copy of both, which is the exact drift that module's
// header comment exists to prevent: the tabs and the browse page agreed on six
// categories by coincidence, not by contract. The `?category=` values in the hrefs are
// the raw vocabulary strings the browse page's cards carry in `data-category`.
function categoryLabel(cat: string): string {
  const k = CATEGORY_KEYS[cat as DocCategory];
  // The schema (src/content/config.ts) restricts category to this vocabulary.
  // Failing loudly here keeps the invariant if the two lists ever drift: the
  // silent fallback used to render the raw frontmatter string as a seventh tab.
  // (docs-categories' makeCategoryLabel is deliberately LENIENT, which is right for
  // the browse page's headings and wrong for navigation chrome on 1,015 pages.)
  if (!k) throw new Error(`Unknown docs category "${cat}"; expected one of: ${Object.keys(CATEGORY_KEYS).join(', ')}`);
  return t(k);
}

const allDocs = await getCollection('docs');
// groupByCategory orders by CATEGORY_ORDER, sorts each group by frontmatter `order` and
// drops empty groups, which is precisely what the local reduce-plus-sort pair did.
const groups = groupByCategory(allDocs.filter((doc) => doc.data.language === currentLang));
---

<nav class="docs-top-tabs" aria-label={t('common.aria.docsSections')}>
  <ul class="docs-top-tabs-list">
    {/* Every tab lands on the browse page filtered to its category, where the reader
        sees the CARDS for that category. It used to deep-link the category's FIRST
        DOCUMENT, which silently decided for the reader which page they wanted; and on
        the browse page itself it jumped to an in-page anchor, a second control for an
        axis the filter rail already owned. One href for both surfaces now, and the
        browse page hides its own category filter group when this param is present. */}
    {groups.map(({ category }) => {
      const isActive = currentCategory === category;

      return (
        <li class="docs-top-tabs-item">
          <a
            href={`/${currentLang}/docs?category=${encodeURIComponent(category)}`}
            class={`docs-top-tab-link ${isActive ? 'active' : ''}`}
            data-docs-category={category}
          >
            {categoryLabel(category)}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<script is:inline>
  (function () {
    // The browse page is one static HTML for every `?category=` value, so the active
    // tab there can only be painted client-side from the URL. Article pages carry no
    // category param and their active tab is server-rendered from frontmatter, so the
    // early return leaves it alone. Tab clicks are full navigations (no page renders
    // <ClientRouter/>, see BaseLayout), so this runs fresh on every landing.
    function initDocsTabActiveState() {
      var wanted = new URLSearchParams(window.location.search).get('category');
      if (!wanted) return;
      var chosen = wanted.split(',');
      var tabs = document.querySelectorAll('.docs-top-tab-link[data-docs-category]');
      tabs.forEach(function (tab) {
        tab.classList.toggle('active', chosen.indexOf(tab.getAttribute('data-docs-category')) !== -1);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDocsTabActiveState);
    } else {
      initDocsTabActiveState();
    }
  })();
</script>

<style>
  /* `flex: 1 1 auto` with `min-width: 0`. The `flex: 1` here was inert until
     .docs-header-row became a real flex container; now that it is one, the
     min-width is what lets this strip shrink below its content width so the
     tabs scroll horizontally instead of pushing the search and theme controls
     off the end of the row. */
  .docs-top-tabs {
    border-bottom: none;
    overflow-x: auto;
    scrollbar-width: thin;
    flex: 1 1 auto;
    min-width: 0;
  }

  .docs-top-tabs-list {
    list-style: none;
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    min-width: max-content;
  }

  .docs-top-tabs-item {
    margin: 0;
  }

  .docs-top-tab-link {
    display: inline-flex;
    align-items: center;
    /* Same token the sticky chrome's min-height and the anchor offset read, so
       a change to the chrome's height moves all three together. It used to be
       this literal 3rem in two files and a third copy inside a calc(). */
    height: var(--docs-chrome-height, 3rem);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    border-bottom: 2px solid transparent;
    transition: color var(--transition-duration-base), border-color var(--transition-duration-base);
  }

  .docs-top-tab-link:hover {
    color: var(--color-text);
  }

  .docs-top-tab-link.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .docs-top-tab-link:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
</style>
