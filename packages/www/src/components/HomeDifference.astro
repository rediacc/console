---
/**
 * The homepage's proof section: what the day looks like without Rediacc, and
 * with it.
 *
 * This used to be the page's centre of gravity and its worst offender: 2,176px
 * of desktop and 4,059px of mobile (4.8 phone screens, 29% of the whole page)
 * for 73 words and 12 pieces of clipart, at 30px per word against 8-10px
 * everywhere else. It was a two-up lead block plus four alternating full-width
 * illustrated rows, plus a <dialog> zoom lightbox for the clipart, plus 22
 * lines of client script to drive it. By the third row a reader is pattern
 * matching rather than reading, and none of the drawings said anything its two
 * lines of text did not.
 *
 * The claims did not change. All eight `beforeAfter.*.points` survive, as does
 * both labels and the title. What left is the drawing: the illustrations, the
 * lightbox, its script, and the four-row scroll.
 *
 * Note for whoever sweeps `public/styles/main.css`: `.difference-twoup*` is
 * dead with this file, and `.difference-row*` / `.difference-zoom*` at
 * main.css:1956-2090 now have no consumer on any page. Left in place rather
 * than reached into, because that file belongs to another writer.
 */
import { createTranslator } from '../i18n/utils';
import type { Language } from '../i18n/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { t, ta } = createTranslator(lang);

const before = (ta('beforeAfter.before.points') as string[]) ?? [];
const after = (ta('beforeAfter.after.points') as string[]) ?? [];

const columns = [
  { label: t('beforeAfter.before.label'), points: before, variant: 'before' as const },
  { label: t('beforeAfter.after.label'), points: after, variant: 'after' as const },
];
---

<section class="home-difference">
  <div class="home-difference-container">
    <header class="section-header">
      <h2 class="section-title">{t('beforeAfter.title')}</h2>
    </header>

    <div class="difference-compare">
      {columns.map((col) => (
        <article class:list={['card', `difference-col--${col.variant}`, { 'card--raised': col.variant === 'after' }]}>
          <h3 class="difference-col-label">{col.label}</h3>
          <ul class="difference-col-list">
            {col.points.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .difference-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    max-width: var(--container-lg);
    margin: 0 auto;
  }

  .difference-col-label {
    margin: 0;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-secondary);
  }

  .difference-col--after .difference-col-label {
    color: var(--color-brand-primary);
  }

  .difference-col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .difference-col-list li {
    margin: 0;
    font-size: var(--font-size-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  .difference-col--after .difference-col-list li {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .difference-compare {
      grid-template-columns: 1fr;
    }
  }
</style>
