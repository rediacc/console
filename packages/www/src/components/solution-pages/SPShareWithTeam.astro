---
import type { Language } from '../../i18n/types';
import type { PersonaType } from '../../config/persona-pages';

// THE OVERLINE AND THE ARROW ARE GONE, and this is the only component on the four
// persona pages that still carried either.
//
// The overline shouted twice over: the catalog value was literally "SHARE WITH THE TEAM"
// / "NEXT STEP" in capitals AND persona-pages.css re-applied text-transform: uppercase on
// top of it. A tracked all-caps eyebrow above every heading is template chrome that shows
// up whatever the subject; SPHero.astro:11-18 already removed its own for the same reason.
// The heading below says "Share with the CTO" -- the eyebrow was announcing what the
// sentence underneath it already said.
//
// The arrow was an inline SVG appended after the link text. The button is a link; the
// browser already says so. Both English values and their 24 locale values were deleted
// with this markup rather than reworded, so the naturalization ledger stays clean.
interface Props {
  content: {
    title: string;
    description: string;
    ctaText: string;
    ctaSlug: string;
  };
  personaType: PersonaType;
  lang: Language;
}

const { content, lang } = Astro.props;
const href = `/${lang}/${content.ctaSlug}`;
---

<section class="sp-share-with-team">
  <div class="sp-share-with-team-inner">
    <h2>{content.title}</h2>
    <p>{content.description}</p>
    <a href={href} class="sp-btn-primary">{content.ctaText}</a>
  </div>
</section>
