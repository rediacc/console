---
import { resolveSolutionIllustration } from '../../utils/solution-illustration';
import { resolveDisclosureThumb } from '../../utils/disclosure-thumb';
import { getIcon } from './icons';

interface StatCallout {
  number: string;
  text: string;
  source: string;
  ref?: number;
}

interface TimelineStep {
  day: string;
  text: string;
}

interface ReferenceItem {
  text: string;
  url: string;
}

interface Props {
  /** Button label for the timeline disclosure, from `solutions.disclosure.*`. */
  timelineLabel: string;
  problem: {
    overline: string;
    title: string;
    description: string;
    statCallouts?: StatCallout[];
    timeline?: {
      oldLabel: string;
      oldSteps: TimelineStep[];
      newLabel: string;
      newSteps: string[];
    };
  };
  referenceItems?: ReferenceItem[];
  slug?: string;
}

const { problem, referenceItems = [], slug, timelineLabel } = Astro.props;

// The drawings are textless and decorative (the meaning lives in the copy
// around them), so one file serves every locale and viewport, inlined so it
// can paint from the theme-aware --illustration-* tokens.
const illustrationSvg = slug ? resolveSolutionIllustration(slug) : null;
// Unique per mount: aria-describedby must point at an id that exists exactly once.
const popIdBase = `sp-callout-src-${slug ?? 'page'}`;
const timelinePopId = `sp-pop-timeline-${slug ?? 'page'}`;
// The trigger's own picture: a long span of stops over a short one, which is the
// timeline's argument in a form that survives being 96px wide.
const timelineThumb = resolveDisclosureThumb('trigger-problem-detail');

/**
 * The glyph beside a callout, derived from the figure itself.
 *
 * A number on its own is a wall of characters; a 20px mark in front of it says what KIND
 * of number it is before the reader has parsed a digit. Deriving it from the value costs
 * no i18n key and cannot go stale when a figure is updated.
 *
 * Only what survives translation is read: currency symbols, `%`, `12x`, `1/3`. Unit
 * nouns are localized (`24 days` / `24 Tage` / `24 gün`), so a rule that matched them
 * would work in English and misfile the other twelve. A value with no digit at all is
 * not a quantity -- one callout on these pages is a QUOTE -- and gets no glyph rather
 * than a wrong one.
 */
function calloutGlyph(value: string): string | null {
  if (!/\d/.test(value)) return null;
  if (/[$€£¥]/.test(value)) return getIcon('stat-money');
  if (/%|\d\s*[x×]|\d\s*\/\s*\d/.test(value)) return getIcon('stat-share');
  return getIcon('stat-quantity');
}
---

<section class="sp-problem" id="problem">
  {/*
    Two-column on desktop, one column below 900px. The container only becomes a
    grid when there IS an illustration to put in the second column; with no
    illustration `.sp-problem-inner` stays the plain 720px prose block it was.

    DOM order is text-then-illustration, matching `.sp-hero-split` in
    solution-pages.css and for the same reason: grid places the first child on
    the inline-START edge, so LTR reads text-left / drawing-right and /ar
    mirrors to text-right / drawing-left with no direction-specific rules. The
    900px collapse keeps that order, so mobile leads with the title.

    THE CALLOUTS ARE THEIR OWN COLUMN, not part of the text block. They used to sit
    inside it, on the reasoning that stacking them there balanced the two column
    heights. Measured on /en/for-ctos that was backwards: the text column carried
    four stacked devices for 483px while the illustration column held two small line
    drawings in 324px of mostly empty air, and the section ran 1019px for 106 words.
    Four things stacked in a narrow column beside a near-empty one is what reads as
    crowded, and it is a composition problem rather than a word-count one. The
    timeline stays a full-width row under both columns because it is a
    horizontal band by design (a row of connected steps, capped at 700px) and
    squeezing it into a half-width column would break its own layout.
  */}
  <div class:list={['sp-problem-inner', illustrationSvg && 'sp-problem-split']}>
    <div class="sp-problem-text">
      <div class="sp-overline">{problem.overline}</div>
      <h2>{problem.title}</h2>
      <p>{problem.description}</p>

    </div>

    {problem.statCallouts && problem.statCallouts.length > 0 && (
      <div class="sp-stat-callouts">
        {problem.statCallouts.map((callout, idx) => {
          /*
            B4: the callout keeps its number and its claim and loses the stacked source
            line. What replaces it is a marker into SPSources, and it is rendered ONLY when
            the `ref` actually resolves to an item.

            That guard is the whole point rather than defensive habit. `statCallout.ref` is
            unvalidated: `scripts/validate-comparison-refs.js` iterates `comparison.features`
            and nothing else, so no gate has ever read these indices. And the case is live,
            not hypothetical -- `pages.personaPages.*` carries `ref` numbers but has never
            carried a `references` branch in any locale, so `PersonaPage.astro` passes no
            `referenceItems` and every persona callout lands here unresolved. An
            unconditional marker would emit `#sp-ref-N` against an id no page contains.
          */
          const cited = callout.ref && callout.ref > 0 ? referenceItems[callout.ref - 1] : undefined;
          const glyph = calloutGlyph(callout.number);
          return (
            <div
              class="sp-stat-callout"
              tabindex={callout.source ? 0 : undefined}
              aria-describedby={callout.source ? `${popIdBase}-${idx}` : undefined}
            >
              {glyph && (
                <span class="sp-stat-callout-glyph" aria-hidden="true" set:html={glyph} />
              )}
              <span class="sp-stat-callout-number">{callout.number}</span>
              {callout.text}
              {cited && (
                <a
                  class="sp-stat-ref"
                  href={`#sp-ref-${callout.ref}`}
                  title={callout.source}
                  aria-label={`${callout.source}: ${cited.text}`}
                >{callout.ref}</a>
              )}
              {/* THE SOURCE, GIVEN BACK WITHOUT ITS OLD COST.
                  B4 above removed the stacked source line to save vertical space, and on
                  persona pages that left these numbers with NO attribution at all, because
                  `pages.personaPages.*` carries `ref` indices but has never carried a
                  `references` branch, so `cited` is always undefined there.
                  This costs zero layout: it is absolutely positioned and only painted on
                  hover or focus.

                  HOVER *AND* FOCUS, and no JS. PersonaMegaMenu.tsx:186-191 records that
                  hover-to-open was deliberately removed from this site after two live bugs
                  (a hover-open whose own click closed it, an orphaned 100ms timer). Both
                  needed a TIMER and a competing CLICK action; a tooltip has neither, so
                  neither bug can occur here. The other half of that ruling was that hover
                  has no keyboard or touch equivalent -- which is why this is driven by
                  `:hover, :focus-visible, :focus-within` together and the chip is
                  focusable, so a keyboard reaches it and a tap opens it. */}
              {callout.source && (
                <span class="sp-callout-pop" id={`${popIdBase}-${idx}`} role="tooltip">
                  {callout.source}
                </span>
              )}
            </div>
          );
        })}
      </div>
    )}

    {illustrationSvg && (
      <div class="sp-problem-illustration" set:html={illustrationSvg} />
    )}

    {problem.timeline && (
      <Fragment>
      {/* THE TIMELINE IS THE THIRD TELLING, so it goes behind a click.
          The title states the problem, the callouts prove it with numbers, and this
          says the same thing a third time as a before/after strip. Measured on
          /en/for-ctos it was 233px of a 1019px section for 24 words. Behind a trigger
          the argument is still one click away for anyone who wants it, and the section
          reads as claim + evidence instead of claim + evidence + re-enactment.
          Native popover for the same reason as SPTechDiff: this is static Astro. */}
      <button type="button" class="sp-disclosure-trigger" popovertarget={timelinePopId}>
        {timelineThumb && <span class="sp-disclosure-thumb" set:html={timelineThumb} />}
        <span class="sp-disclosure-trigger-label">{timelineLabel}</span>
      </button>

      <div
        class="sp-disclosure-pop"
        id={timelinePopId}
        popover="auto"
        role="dialog"
        aria-labelledby={`${timelinePopId}-title`}
      >
        <h3 class="sp-disclosure-pop-title" id={`${timelinePopId}-title`}>{timelineLabel}</h3>
      <div class="sp-timeline-contrast">
        <div class="sp-timeline-label old">{problem.timeline.oldLabel}</div>
        <div class="sp-timeline-old">
          {problem.timeline.oldSteps.map((step) => (
            <div class="sp-timeline-old-step">
              <span class="sp-timeline-old-day">{step.day}</span>
              {step.text}
            </div>
          ))}
        </div>

        <div class="sp-timeline-label new">{problem.timeline.newLabel}</div>
        <div class="sp-timeline-new">
          {problem.timeline.newSteps.map((step) => (
            <div class="sp-timeline-new-step">{step}</div>
          ))}
        </div>
      </div>
      </div>
      </Fragment>
    )}
  </div>
</section>
