---
// SOCIAL PROOF — DISABLED, do not re-enable until the content behind it is real.
//
// To restore, both halves:
//   1. here in the frontmatter:  import SPSocialProof from './SPSocialProof.astro';
//   2. at the marked spot in the template below:
//        {has('socialProof') && (
//          <SPSocialProof socialProof={(content as any).socialProof} />
//        )}
//
// The quotes and impact metrics are invented and Rediacc has no public customers.
// The i18n keys are retained for a future honest replacement.
//
// This note lives in the frontmatter, not in a template comment: the
// hardcoded-string gate reads template comment bodies as text nodes, and an HTML
// comment would ship this reasoning to every visitor's page source.
//
// See SolutionPage.astro for the fuller note and rediacc/console#519.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../StructuredData.astro';
import SPHero from './SPHero.astro';
import SPSolutionVideo from './SPSolutionVideo.astro';
import SPStatsBar from './SPStatsBar.astro';
import SPProblem from './SPProblem.astro';
import SPCostCalculator from './SPCostCalculator';
import { resolveDisclosureThumb } from '../../utils/disclosure-thumb';
import SPHowItWorks from './SPHowItWorks.astro';
import SPTechDiff from './SPTechDiff.astro';
import SPBenefits from './SPBenefits.astro';
import SPComparisonTable from './SPComparisonTable.astro';
import SPBottomCta from './SPBottomCta.astro';
import SolutionConstellation from './SolutionConstellation.astro';
import SPShareWithTeam from './SPShareWithTeam.astro';
import SPSources from './SPSources.astro';
import { createTranslator } from '../../i18n/utils';
import type { Language } from '../../i18n/types';
import { PERSONA_PAGES, PERSONA_CTA_MAP } from '../../config/persona-pages';
import { SITE_URL, EXTERNAL_LINKS, ACCOUNT_PATH } from '../../config/constants';
import Breadcrumb from '../Breadcrumb.astro';
import '../../styles/solution-pages.css';
import '../../styles/persona-pages.css';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const config = PERSONA_PAGES[slug];

if (!config) {
  return Astro.redirect(`/${lang}`, 301);
}

const { t, to } = createTranslator(lang);
const content = to(`pages.personaPages.${config.contentKey}` as any);
const metaPath = `pages.personaPages.${config.contentKey}.meta`;

const has = (section: string) => config.sections.includes(section as any);

// Same harvested noun the solution pages use. Persona pages carry no `references` branch
// today, so SPSources renders nothing here -- the component is wired so that authoring one
// is a data change and not a template change.
const sourcesTitle = t('solutions.references.title', 'Sources');

// Resolve CTA href: per-page override → persona default
// THE HERO CTA GOES TO THE ACCOUNT, always, and deliberately NOT through the
// resolution below. `PERSONA_CTA_MAP` sends the CTO to an external calendar and the
// CEO to pricing, which is the right ask AFTER someone has read the page and the
// wrong one before they have read anything. Measured: for-ctos had no self-serve
// path anywhere on 7,150px, its only exit an external booking link at 89% depth.
// The bottom CTA keeps that routing untouched; the hero adds the missing one.
const heroCtaLabel = t(
  `pages.personaPages.${config.contentKey}.hero.ctaLabel` as any,
  ''
);
const heroCta = heroCtaLabel ? { label: heroCtaLabel, href: ACCOUNT_PATH } : undefined;

const rawCtaHref = config.ctaHref ?? PERSONA_CTA_MAP[config.personaType];
const ctaHref = rawCtaHref === 'CONSULTATION'
  ? EXTERNAL_LINKS.SCHEDULE_CONSULTATION
  : rawCtaHref.startsWith('/') || /^https?:\/\//.test(rawCtaHref)
    ? rawCtaHref
    : `/${lang}${rawCtaHref}`;

// Breadcrumb items
const pageTitle = (content as any).hero?.title ?? slug;
const breadcrumbItems = [
  { name: t('navigation.home'), url: `/${lang}` },
  { name: pageTitle, url: `/${lang}/${slug}` },
];
---

<BaseLayout
  lang={lang}
  title={t(`${metaPath}.title`)}
  description={t(`${metaPath}.description`)}
  keywords={t(`${metaPath}.keywords`)}
  ogType="website"
>
  <div class="sp-page" data-persona={config.personaType}>
    <Breadcrumb items={breadcrumbItems} class="sp-breadcrumb" />
    {/* The video rides INSIDE the hero as its media column, same as SolutionPage.astro
        (operator item n7). A ternary, not a falsy expression child: an expression child
        would count as passed slot content in SPHero's Astro.slots.has('default') even
        when it renders nothing. */}
    {has('hero') && (has('video') ? (
      <SPHero hero={(content as any).hero} cta={heroCta}>
        <SPSolutionVideo lang={lang} slug={slug} />
      </SPHero>
    ) : (
      <SPHero hero={(content as any).hero} cta={heroCta} />
    ))}

    {/*
      No `referenceItems`: `pages.personaPages.*` has never carried a `references`
      branch in any locale, so this prop was always `undefined` and the three stat
      callouts on each persona page cited a source that did not exist. The `ref`
      indices left in the catalog data are inert and are queued for retirement.
    */}
    {has('problem') && (
      <SPProblem
        timelineLabel={t('solutions.disclosure.timeline')}
        problem={(content as any).problem} slug={config.illustrationSlug} />
    )}

    {has('stats') && (
      <SPStatsBar stats={(content as any).stats} />
    )}

    {has('costCalculator') && config.calculatorPreset && (
      <SPCostCalculator
        client:visible
        content={(content as any).calculator}
        preset={config.calculatorPreset}
        closeLabel={t('common.close')}
        thumb={resolveDisclosureThumb('trigger-calculator')}
      />
    )}

    {has('howItWorks') && (
      <SPHowItWorks howItWorks={(content as any).howItWorks} />
    )}

    {has('techDiff') && (
      <SPTechDiff
        techDiff={(content as any).techDiff}
        triggerLabel={t('solutions.disclosure.mechanism')}
        popId="sp-pop-mechanism"
      />
    )}

    {has('benefits') && (
      <SPBenefits benefits={(content as any).benefits} />
    )}

    {has('competitorComparison') && config.competitors && (
      <SPComparisonTable
        triggerLabel={t('solutions.disclosure.comparison')}
        popId="sp-pop-comparison"
        comparison={(content as any).comparison}
        competitors={config.competitors}
      />
    )}

    {/* SPSocialProof was rendered here — see the SOCIAL PROOF note in the frontmatter. */}

    {/* B3: last content section, above the black zone. See SolutionPage.astro. */}
    <SPSources items={(content as any).references?.items} title={sourcesTitle} />

    {has('relatedSolutions') && config.relatedSolutions && (
      <SolutionConstellation
        lang={lang}
        preset="compact"
        slugs={config.relatedSolutions}
        heading={(content as any).relatedSolutions?.title}
      />
    )}

    {has('shareWithTeam') && (
      <SPShareWithTeam
        content={(content as any).shareWithTeam}
        personaType={config.personaType}
        lang={lang}
      />
    )}

    {has('bottomCta') && (
      <SPBottomCta bottomCta={(content as any).bottomCta} ctaHref={ctaHref} lang={lang} />
    )}
  </div>

  <StructuredData
    type="service"
    data={{
      name: (content as any).hero?.title ?? '',
      description: t(`${metaPath}.description`),
      url: `${SITE_URL}/${lang}/${slug}`,
    }}
  />

  {/* The hero video mounts through the shared hydrator rather than as an island, because
      `plyr` reads `document` at module scope and cannot be server-rendered. Same script
      SolutionPage.astro loads for its own hero video. */}
  <script src="../../scripts/tutorial-video-hydrate.ts"></script>
</BaseLayout>
