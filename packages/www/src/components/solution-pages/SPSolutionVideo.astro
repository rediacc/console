---
import { createTranslator } from '../../i18n/utils';
import type { Language } from '../../i18n/types';
import { resolveSolutionVideoSources } from '../../utils/solution-video';
import SolutionVideoPlayer from './SolutionVideoPlayer';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const { t } = createTranslator(lang);
const sources = resolveSolutionVideoSources(slug);

// No section wrapper any more: since round 6 this renders INSIDE the hero's media
// column (`.sp-hero-media` in SPHero.astro), which owns the layout box. The old
// `.sp-video` / `.sp-video-inner` standalone section is gone with the move.
//
// Both cuts are emitted with preload="none" + poster, so only the visible one
// (toggled by viewport via CSS) fetches its media when the viewer hits play.
// Captions are burned into the localized video, so no <track> is needed.
//
// The labels are translated HERE, on the server, and passed down as props. The island must
// not reach the i18n catalogs itself: src/i18n/utils.ts statically imports all thirteen,
// and anything that pulls it into a client bundle puts 9.28 MB of catalogs on the route.
---

<SolutionVideoPlayer
  client:visible
  lang={lang}
  sources={sources}
  playLabel={t('video.playVideo')}
  selectLanguageLabel={t('navigation.selectLanguage')}
/>
