---
import { createTranslator } from '../../i18n/utils';
import type { Language } from '../../i18n/types';
import { resolveSolutionVideoSources } from '../../utils/solution-video';
// The dark-band overrides used to ride into the bundle on SolutionVideoPlayer.tsx's own
// `import '../../styles/solution-video.css'`. Deleting that component orphaned the
// stylesheet, and the language trigger went straight back to a white pill on the dark
// hero -- measured at rgb(26,26,26) on rgb(255,255,255) before this import was added.
import '../../styles/solution-video.css';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const { t } = createTranslator(lang);
const sources = resolveSolutionVideoSources(slug);

// ONE PLAYER, NOT TWO. This used to mount `SolutionVideoPlayer`, a second React island
// with native controls, its own language picker and two <video> elements toggled by CSS.
// Two players is two of everything to maintain and two places for a bug to live, and the
// tutorial one is the better of the pair: Plyr controls, a speed menu, fullscreen,
// keyboard handling, and a picker that keeps your place across a language switch.
//
// What the solution videos DON'T have, and why the player no longer demands it: no VTT
// (captions are burned into each localized file), no chapters, no per-word timings. Those
// props are optional now, and Plyr drops its CC button when there is no track behind it.
//
// A PLACEHOLDER, NOT `client:visible`. `plyr` reads `document` at module scope, so
// importing it under Node throws before any component code runs -- an Astro island would
// have to server-render it and cannot. The shared hydrator mounts it from a dynamic
// import instead; this div is the same contract the tutorial embeds use.
//
// The portrait cut is picked by `matchMedia` inside the player rather than by rendering
// both and hiding one, because with Plyr two elements would mean two player instances.
const localized = Object.fromEntries(
  Object.entries(sources)
    .filter(([, urls]) => Boolean(urls))
    .map(([code, urls]) => [
      code,
      { mp4: urls!.landscape, poster: urls!.poster, vertical: urls!.vertical },
    ])
);
const here = localized[lang] ?? localized.en;
---

{
  here && (
    <div
      class="video-player-mount"
      data-video-src={here.mp4}
      data-poster-src={here.poster}
      data-vertical-src={here.vertical}
      data-title={t('video.playVideo')}
      data-lang={lang}
      data-sources={JSON.stringify(localized)}
      data-click-to-load
    >
      {/* SERVER-RENDERED POSTER, so the visitor sees the frame immediately instead of an
          empty box until 122 KB of player JS downloads and runs. `data-click-to-load`
          tells tutorial-video-hydrate.ts to build the player on the first click here
          rather than on load: an IntersectionObserver cannot help, because every mount
          on the site is above the fold (measured across 44 pages at two viewports).
          The hydrator removes this element when it mounts, so nothing is left behind. */}
      <img class="video-poster-preview" src={here.poster} alt="" loading="eager" decoding="async" />
      <button class="video-poster-play" type="button" aria-label={t('video.playVideo')}>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" /></svg>
      </button>
    </div>
  )
}
