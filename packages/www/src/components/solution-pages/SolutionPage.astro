---
// SOCIAL PROOF — DISABLED, do not re-enable until the content behind it is real.
//
// To restore, both halves:
//   1. here in the frontmatter:  import SPSocialProof from './SPSocialProof.astro';
//   2. at the marked spot in the template below:
//        {has('socialProof') && (
//          <SPSocialProof socialProof={(content as any).socialProof} />
//        )}
//
// Every quote and impact metric in the i18n data is invented: named incidents,
// timestamps, and dollar figures attributed to customers that do not exist.
// Rediacc has no public customers, and the partner sales training tells sellers
// never to invent one.
//
// The i18n keys are left in place for a future honest replacement (mechanism and
// measured demo numbers, no attributed quote).
//
// This note lives in the frontmatter, not in a template comment: the
// hardcoded-string gate reads template comment bodies as text nodes, and an HTML
// comment would ship this reasoning to every visitor's page source.
//
// See rediacc/console#519.
import BaseLayout from '../../layouts/BaseLayout.astro';
import StructuredData from '../StructuredData.astro';
import SPHero from './SPHero.astro';
import SPStatsBar from './SPStatsBar.astro';
import SPProblem from './SPProblem.astro';
import SPSolutionVideo from './SPSolutionVideo.astro';
import SPCostCalculator from './SPCostCalculator';
import SPHowItWorks from './SPHowItWorks.astro';
import SPTechDiff from './SPTechDiff.astro';
import SPBenefits from './SPBenefits.astro';
import SPComparisonTable from './SPComparisonTable.astro';
import SPBottomCta from './SPBottomCta.astro';
import SPDownloadGated from './SPDownloadGated.astro';
import SPDownloadShort from './SPDownloadShort.astro';
import SPSources from './SPSources.astro';
import SolutionConstellation from './SolutionConstellation.astro';
import { slugsForRole } from './constellation';
import { createTranslator } from '../../i18n/utils';
import type { Language } from '../../i18n/types';
import { SOLUTION_PAGES, CATEGORY_CTA_MAP } from '../../config/solution-pages';
import { SITE_URL, EXTERNAL_LINKS, ACCOUNT_PATH } from '../../config/constants';
import Breadcrumb from '../Breadcrumb.astro';
import '../../styles/solution-pages.css';

interface Props {
  lang: Language;
  slug: string;
}

const { lang, slug } = Astro.props;
const config = SOLUTION_PAGES[slug];

if (!config) {
  return Astro.redirect(`/${lang}`, 301);
}

const { t, to } = createTranslator(lang);
const content = to(`pages.solutionPages.${config.contentKey}` as any);
const metaPath = `pages.solutionPages.${config.contentKey}.meta`;

const has = (section: string) => config.sections.includes(section as any);

// Resolve CTA href: per-page override → category default
const rawCtaHref = config.ctaHref ?? CATEGORY_CTA_MAP[config.category];
const ctaHref = rawCtaHref === 'CONSULTATION'
  ? EXTERNAL_LINKS.SCHEDULE_CONSULTATION
  : rawCtaHref.startsWith('/') || /^https?:\/\//.test(rawCtaHref)
    ? rawCtaHref
    : `/${lang}${rawCtaHref}`;

// Section heading for the constellation, from the harvested
// `solutions.constellation.title` key. It replaced 21 identical per-page copies
// of the same string in every locale. The transitional fallback to
// `environmentCloning.explore.title` is gone with those arrays.
const exploreHeading = t('solutions.constellation.title', 'Explore Other Solutions');

// One harvested noun for the citation disclosure, alongside the constellation's. The count
// is appended by the component, so this stays a plain noun in every locale.
const sourcesTitle = t('solutions.references.title', 'Sources');

// THE HERO CTA GOES TO THE ACCOUNT, always, and that is a deliberate split from
// `ctaHref` above rather than a reuse of it. The bottom CTA stays routed by category
// (`/contact?interest=...`, consultation booking, pricing) because that is the tailored,
// higher-touch ask. The hero's job is the opposite: one self-serve action, no
// qualification step, offered before the visitor has scrolled anywhere.
//
// The label is PER PAGE, an action rather than a product noun: "Start cloning", not
// "Start free trial". It lives in the page's own subtree so each page names the thing
// its reader came to do. `hero.title` is the fallback only so a page whose key has not
// landed yet renders a button instead of a raw key.
const heroCtaLabel = t(
  `pages.solutionPages.${config.contentKey}.hero.ctaLabel` as any,
  ''
);
const heroCta = heroCtaLabel ? { label: heroCtaLabel, href: ACCOUNT_PATH } : undefined;

// Breadcrumb items
const pageTitle = (content as any).hero?.title ?? slug;
const breadcrumbItems = [
  { name: t('navigation.home'), url: `/${lang}` },
  { name: pageTitle, url: `/${lang}/solutions/${slug}` },
];
---

<BaseLayout
  lang={lang}
  title={t(`${metaPath}.title`)}
  description={t(`${metaPath}.description`)}
  keywords={t(`${metaPath}.keywords`)}
  ogType="website"
>
  <div class="sp-page">
    <Breadcrumb items={breadcrumbItems} class="sp-breadcrumb" />
    {/* The video rides INSIDE the hero as its media column (operator item n7).
        A ternary, not a falsy expression child: an expression child would count
        as passed slot content in SPHero's `Astro.slots.has('default')` even
        when it renders nothing. */}
    {has('hero') && (has('video') ? (
      <SPHero hero={(content as any).hero} cta={heroCta}>
        <SPSolutionVideo lang={lang} slug={slug} />
      </SPHero>
    ) : (
      <SPHero hero={(content as any).hero} cta={heroCta} />
    ))}

    {has('problem') && (
      <SPProblem problem={(content as any).problem} referenceItems={(content as any).references?.items} slug={slug} />
    )}

    {/* Operator item n5: the three-stat panel reads as the ANSWER to the problem
        section, so it renders directly after it, not between hero and problem. */}
    {has('stats') && (
      <SPStatsBar stats={(content as any).stats} />
    )}

    {has('costCalculator') && config.calculatorPreset && (
      <SPCostCalculator
        client:visible
        content={(content as any).calculator}
        preset={config.calculatorPreset}
        closeLabel={t('common.close')}
      />
    )}

    {has('howItWorks') && (
      <SPHowItWorks howItWorks={(content as any).howItWorks} />
    )}

    {has('techDiff') && (
      <SPTechDiff
        techDiff={(content as any).techDiff}
        triggerLabel={t('solutions.disclosure.mechanism')}
        popId="sp-pop-mechanism"
      />
    )}

    {has('benefits') && (
      <SPBenefits benefits={(content as any).benefits} />
    )}

    {/* B1+B2: the two download CTAs used to sit FOUR sections apart, with the comparison
        table and the black bottom CTA between them. They ask for the same thing in two
        registers, so they share one row. Render order is fixed JSX here, NOT data: `has()`
        at :63 is a membership test, so reordering ALL_SECTIONS in the config changes
        nothing on the page. */}
    {(has('downloadGated') || has('downloadShort')) && (
      <div class="sp-downloads-row">
        {has('downloadGated') && (
          <SPDownloadGated lang={lang} slug={slug} category={config.category} />
        )}
        {has('downloadShort') && (
          <SPDownloadShort lang={lang} slug={slug} category={config.category} />
        )}
      </div>
    )}

    {has('competitorComparison') && config.competitors && (
      <SPComparisonTable
        triggerLabel={t('solutions.disclosure.comparison')}
        popId="sp-pop-comparison"
        comparison={(content as any).comparison}
        competitors={config.competitors}
        referenceItems={(content as any).references?.items}
      />
    )}

    {/* SPSocialProof was rendered here — see the SOCIAL PROOF note in the frontmatter. */}

    {/* B3: the citations are the LAST content section, immediately above the black zone.
        They are rendered from data, not from `config.sections`: `has()` at :63 is a
        membership test over a fixed section vocabulary, and a page either has
        `references.items` or it does not. */}
    <SPSources items={(content as any).references?.items} title={sourcesTitle} />

    {/* D1: exploreSolutions moves ABOVE the bottom CTA so the CTA is the LAST thing before
        the footer. Both are `--sp-bg-hero`, so with nothing between them the CTA and the
        footer read as one continuous black band. Previously "Explore Other Solutions" and
        "Short on time?" sat between them and broke it into stripes. */}
    {has('exploreSolutions') && (
      <SolutionConstellation
        lang={lang}
        preset="compact"
        slugs={slugsForRole(config.role)}
        currentSlug={slug}
        heading={exploreHeading}
      />
    )}

    {has('bottomCta') && (
      <SPBottomCta bottomCta={(content as any).bottomCta} ctaHref={ctaHref} lang={lang} />
    )}
  </div>

  <StructuredData
    type="service"
    data={{
      name: (content as any).hero?.title ?? '',
      description: t(`${metaPath}.description`),
      url: `${SITE_URL}/${lang}/solutions/${slug}`,
    }}
  />

  {/* The hero video mounts through the shared hydrator rather than as an island, because
      `plyr` reads `document` at module scope and cannot be server-rendered. Same script
      DocsLayout loads for the tutorial embeds; it now matches both placeholders. */}
  <script src="../../scripts/tutorial-video-hydrate.ts"></script>
</BaseLayout>
