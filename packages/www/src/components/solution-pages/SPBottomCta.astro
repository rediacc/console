---
import type { Language } from '../../i18n/types';

interface Props {
  bottomCta: {
    title: string;
    description: string;
    primaryCta: string;
    command?: string;
  };
  ctaHref: string;
  lang?: Language;
}

const { bottomCta, ctaHref } = Astro.props;
---

<section class="sp-bottom-cta">
  <div class="sp-bottom-cta-inner">
    <h2>{bottomCta.title}</h2>
    <p>{bottomCta.description}</p>
    <a href={ctaHref} class="sp-btn-primary">{bottomCta.primaryCta}</a>
    {bottomCta.command && (
      <div class="sp-cta-command">
        <span class="sp-cta-command-prompt">$</span>
        {bottomCta.command}
      </div>
    )}
  </div>
</section>
