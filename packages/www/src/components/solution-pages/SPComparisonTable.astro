---
interface Feature {
  name: string;
  values: string[];
  refs?: number[];
}

interface ReferenceItem {
  text: string;
  url: string;
}

interface Props {
  /** Button label, from the shared `solutions.disclosure.*` nouns. */
  triggerLabel: string;
  /** Unique per mount: two popovers on one page must not share an id. */
  popId: string;
  comparison: {
    overline: string;
    title: string;
    description: string;
    capabilityLabel: string;
    features: Feature[];
  };
  competitors: string[];
  referenceItems?: ReferenceItem[];
}

const { comparison, competitors, referenceItems = [], triggerLabel, popId } = Astro.props;
const cmpTitleId = `${popId}-title`;

const attr = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;');

/**
 * The cell's own value carries the citation. The superscript `[n]` is gone: the
 * source lives on the words (or the glyph) the reader is already looking at, and
 * the underline is what marks it as a link without relying on colour.
 *
 * A glyph cell has no readable label, so its accessible name is the source prose
 * alone; a text cell keeps its visible text at the front of the accessible name so
 * "label in name" still holds.
 */
function renderValue(val: string, ref?: number) {
  const cited = ref && ref > 0 ? referenceItems[ref - 1] : undefined;
  const url = cited?.url;
  const cite = (inner: string, spoken: string) => {
    if (!url) return inner;
    const label = spoken ? `${spoken}: ${cited!.text}` : cited!.text;
    return `<a href="${attr(url)}" target="_blank" rel="noopener noreferrer" class="sp-source-link" title="${attr(cited!.text)}" aria-label="${attr(label)}">${inner}</a>`;
  };
  if (val === 'check') return cite('<span class="sp-comparison-check">&#10003;</span>', '');
  if (val === 'cross') return cite('<span class="sp-comparison-cross">&#10007;</span>', '');
  if (val === 'rediacc') return cite('<span class="sp-comparison-rediacc">&#10003;</span>', '');
  // Text values like "Minutes", "<60s"
  if (val.startsWith('<'))
    return cite(`<span class="sp-comparison-rediacc">${attr(val)}</span>`, val);
  return cite(attr(val), val);
}
---

<section class="sp-comparison-section">
  <div class="sp-comparison-section-inner">
    <div class="sp-overline">{comparison.overline}</div>
    <h2>{comparison.title}</h2>
    <p>{comparison.description}</p>

    {/* A real block wrapper owns the horizontal scroll. It used to be
        `display: block; overflow-x: auto` on the <table> itself, which does
        scroll but only by making the table stop being a table: `display: block`
        drops the column model, so `position: sticky` on the first column could
        not work and the row label scrolled away with everything else.
        Measured at 390px before this: 7 columns spanning 562px inside 327px,
        with the REDIACC column starting at x=512 -- the one column the table
        exists to show was always off-screen, and nothing indicated it was
        reachable. tabindex + role make the scroller keyboard-reachable, which
        an overflow container is not on its own. */}
    {/* Same native-popover treatment as SPTechDiff, and for the same reason: this is
        static Astro, so a dialog costs no JS runtime. The scroll wrapper and its sticky
        first column stay INSIDE the popover, because a 7-column table still needs both
        on a phone once opened. */}
    <button type="button" class="sp-disclosure-trigger" popovertarget={popId}>
      {triggerLabel}
    </button>

    <div class="sp-disclosure-pop" id={popId} popover="auto" role="dialog" aria-labelledby={cmpTitleId}>
      <h3 class="sp-disclosure-pop-title" id={cmpTitleId}>{comparison.title}</h3>
    <div
      class="sp-comparison-scroll"
      tabindex="0"
      role="region"
      aria-label={comparison.title}
    >
    <table class="sp-comparison-table">
      <thead>
        <tr>
          <th>{comparison.capabilityLabel}</th>
          {competitors.map((name) => (
            <th>{name}</th>
          ))}
          <th>Rediacc</th>
        </tr>
      </thead>
      <tbody>
        {comparison.features.map((feature) => (
          <tr>
            <td>{feature.name}</td>
            {feature.values.map((val, i) => (
              <td>
                <Fragment set:html={renderValue(val, feature.refs?.[i])} />
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    </div>
    </div>
  </div>
</section>
