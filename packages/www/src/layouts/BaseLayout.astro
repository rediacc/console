---
import Navigation from '../components/Navigation';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import ContactModal from '../components/ContactModal';
import RegionPickerModal from '../components/RegionPickerModal';
import Footer from '../components/Footer';
import NewsletterReturnPopup from '../components/NewsletterReturnPopup';
import LeadMagnetModal from '../components/LeadMagnetModal';
import CliReferenceModal from '../components/docs/CliReferenceModal.astro';
import ImageModal from '../components/ImageModal.astro';
import StructuredData from '../components/StructuredData.astro';
import { createTranslator } from '../i18n/utils';
import { getLanguageFromPath, getPathWithoutLanguage, SUPPORTED_LANGUAGES, getLocale, getHreflang } from '../i18n/language-utils';
import type { Language } from '../i18n/types';
// No view transitions. The two `astro-view-transitions-*` meta tags that used
// to sit in <head> here, and the ::view-transition rules in main.css that went
// with them, were inert: the meta is only read by Astro's client router
// (node_modules/astro/dist/transitions/router.js:12), which loads only when a
// page renders `<ClientRouter />` from `astro:transitions`. No page does.

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: string;
  structuredDataType?: 'organization' | 'website' | 'service' | 'breadcrumb' | 'techarticle' | 'offer';
  structuredData?: any;
  robots?: string;
  canonical?: string;
  lang?: Language;
}

const {
  title,
  description,
  keywords,
  ogTitle = title,
  ogDescription,
  ogImage = `${Astro.site}favicon.svg`,
  ogType = "website",
  structuredDataType = "organization",
  structuredData = {},
  robots = "index, follow",
  canonical,
  lang
} = Astro.props;

// Detect language from URL or use provided lang prop
const currentLang = lang || getLanguageFromPath(Astro.url.pathname);
const { t } = createTranslator(currentLang);

// Set descriptions with fallback to defaults
const finalDescription = description || t('layout.meta.defaultDescription');
const finalKeywords = keywords || t('layout.meta.defaultKeywords');
const finalOgDescription = ogDescription || finalDescription;

// Use current origin in development, production site in build
const baseURL = import.meta.env.DEV ? Astro.url.origin : Astro.site;
const canonicalURL = canonical ? canonical : new URL(Astro.url.pathname, baseURL);
const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === `/${currentLang}`;

// Get path without language prefix for generating alternate language links
const pathWithoutLang = getPathWithoutLanguage(Astro.url.pathname);

// Determine text direction based on language
const dir = currentLang === 'ar' ? 'rtl' : 'ltr';
---

<!DOCTYPE html>
<html lang={currentLang} dir={dir}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={finalDescription}>
    <meta name="keywords" content={finalKeywords}>
    <meta name="author" content={t('layout.meta.author')}>
    <meta name="robots" content={robots}>
    <!-- ONE theme-color, patched by the theme script below. The pair of
         media-scoped tags this replaces was resolved by the browser from the OS
         preference alone, so the moment the theme stopped being a function of
         that preference (see the script) the browser chrome and the page
         disagreed: dark page, green chrome, every evening. -->
    <meta name="theme-color" content="#4a7c3f">

    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff">
    <meta http-equiv="X-XSS-Protection" content="1; mode=block">
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), payment=()">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={finalOgDescription}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:site_name" content={t('layout.meta.siteName')}>
    <meta property="og:locale" content={getLocale(currentLang)}>

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={ogTitle}>
    <meta name="twitter:description" content={finalOgDescription}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:site" content={t('layout.meta.twitter.site')}>
    <meta name="twitter:creator" content={t('layout.meta.twitter.creator')}>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL}>

    <!-- RSS Feed Autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title={`Rediacc Blog - ${currentLang.toUpperCase()}`} href={`/${currentLang}/rss.xml`} />

    <!-- Alternate Language Links (hreflang) -->
    {SUPPORTED_LANGUAGES.map((lang) => {
      const langPath = `/${lang}${pathWithoutLang}`;
      const fullUrl = new URL(langPath, baseURL).toString();
      return (
        <link rel="alternate" hreflang={getHreflang(lang)} href={fullUrl} />
      );
    })}
    <!-- Default language fallback (always English) -->
    <link rel="alternate" hreflang="x-default" href={new URL(`/en${pathWithoutLang}`, baseURL).toString()} />

    <!-- Favicon and Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <title>{title}</title>

    <!-- Preload critical fonts (only the two most-used weights to avoid competing preloads) -->
    <link rel="preload" href="/fonts/inter/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/inter/Inter-SemiBold.woff2" as="font" type="font/woff2" crossorigin>

    <!-- Preload critical resources -->
    <link rel="preload" href="/styles/main.css" as="style">
    <link rel="preload" href="/styles/responsive.css" as="style">
    <link rel="dns-prefetch" href="//plausible.rediacc.com">
    <link rel="preconnect" href="https://plausible.rediacc.com" crossorigin>

    <!-- Structured Data -->
    <StructuredData type={structuredDataType} data={structuredData} />
    {isHomePage && <StructuredData type="website" />}
    {isHomePage && <StructuredData type="service" />}
    {isHomePage && <StructuredData type="sitenavigation" />}

    <!-- Theme detection script (runs before paint to prevent flash of wrong theme).
         Also stamps html.js-anim, which is the ONLY thing that lets the
         scroll-reveal rules in main.css hide anything. Without JavaScript the
         class never lands, the `.reveal` rules never match, and the content
         renders at full opacity instead of staying permanently invisible.
         It must be set HERE, before first paint, not from the deferred
         scroll-reveal script: setting it later would paint the content and
         then hide it. The js-anim line stays in THIS block for that reason; do
         not move it out when the theme rule changes again.

         The rule, in priority order:
           1. An explicit localStorage['theme'] of 'light' or 'dark' wins and is
              never cleared here. It is written by a control on the docs pages,
              and it persists site-wide by design.
           2. Otherwise dark between 20:00 and 06:00 by the visitor's own clock,
              OR whenever the OS asks for dark. The clock leg is why the header
              theme toggle could go: the site now guesses right for the case the
              toggle was mostly used for.

         Re-evaluated on visibilitychange so a tab left open across 20:00 flips
         when it is looked at again, and on the OS preference changing. -->
    <script is:inline>
      (function(){
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        function stored() {
          // A blocked or full localStorage must not take the theme, and must not
          // take js-anim down with it: without that class every reveal element
          // on the page renders at full opacity.
          try {
            var v = localStorage.getItem('theme');
            return v === 'dark' || v === 'light' ? v : null;
          } catch (e) {
            return null;
          }
        }
        function resolve() {
          var explicit = stored();
          if (explicit) return explicit;
          var hour = new Date().getHours();
          if (hour >= 20 || hour < 6) return 'dark';
          return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
        function apply() {
          var theme = resolve();
          root.dataset.theme = theme;
          if (meta) meta.content = theme === 'dark' ? '#0f0f10' : '#4a7c3f';
        }
        apply();
        root.classList.add('js-anim');
        document.addEventListener('visibilitychange', function(){
          if (!document.hidden) apply();
        });
        if (window.matchMedia) {
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          if (mq.addEventListener) mq.addEventListener('change', apply);
        }
      })();
    </script>

    <!-- Language Cookie Redirect Script (runs early to prevent flash) -->
    <script is:inline define:vars={{ currentLang, pathWithoutLang, SUPPORTED_LANGUAGES }}>
      (function() {
        // Get language cookie
        function getLanguageCookie() {
          const cookies = document.cookie.split(';');
          for (const cookie of cookies) {
            const [name, value] = cookie.trim().split('=');
            if (name === 'rediacc_lang') {
              return decodeURIComponent(value);
            }
          }
          return null;
        }

        // Only redirect if cookie language differs from current URL language
        const cookieLang = getLanguageCookie();
        if (cookieLang && cookieLang !== currentLang && SUPPORTED_LANGUAGES.includes(cookieLang)) {
          // Build new URL with cookie language
          const rawPath = cookieLang === 'en' ? pathWithoutLang : `/${cookieLang}${pathWithoutLang}`;
          const newPath = rawPath.replace(/\/$/, '') || `/${cookieLang}`;
          const newUrl = `${newPath}${window.location.search}${window.location.hash}`;

          // Redirect to the preferred language
          window.location.replace(newUrl);
        }
      })();
    </script>

    <!-- Custom head content from pages -->
    <slot name="head" />

    <!-- Privacy-friendly analytics by Plausible -->
    <script is:inline async src="https://plausible.rediacc.com/js/pa-QD2nMPajNQtoHBoHdMBpP.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init({ outboundLinks: true, fileDownloads: true, formSubmissions: true })
    </script>

    <!-- Core Web Vitals: LCP + CLS -->
    <script is:inline>
      (function(){
        var p=window.plausible;if(!p)return;
        function rate(m,v){
          if(m==='LCP')return v<=2500?'good':v<=4000?'needs-improvement':'poor';
          return v<=0.1?'good':v<=0.25?'needs-improvement':'poor';
        }
        try{
          new PerformanceObserver(function(l){
            var e=l.getEntries();if(!e.length)return;
            var lcp=e[e.length-1];
            var v=Math.round(lcp.startTime);
            p('web_vitals',{props:{metric:'LCP',value:String(v),rating:rate('LCP',v)},interactive:false});
          }).observe({type:'largest-contentful-paint',buffered:true});
        }catch(_){}
        try{
          var cls=0;
          new PerformanceObserver(function(l){
            var e=l.getEntries();
            for(var i=0;i<e.length;i++){if(!e[i].hadRecentInput)cls+=e[i].value;}
          }).observe({type:'layout-shift',buffered:true});
          document.addEventListener('visibilitychange',function(){
            if(document.visibilityState==='hidden'){
              var v=Math.round(cls*1000)/1000;
              p('web_vitals',{props:{metric:'CLS',value:String(v),rating:rate('CLS',v)},interactive:false});
            }
          });
        }catch(_){}
      })();
    </script>

    <!-- Critical CSS loaded first -->
    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/responsive.css">

    <!--
      The screen-reader-only " (opens in new tab)" suffix that `main.css` appends to every
      `a[target="_blank"]::after` was a HARDCODED ENGLISH string, so all twelve non-English
      locales announced English on 9,226 links. CSS cannot read a translation, so the
      locale's own wording is handed to it as a custom property here and `main.css` falls
      back to English only if this ever fails to render.

      `JSON.stringify` supplies the quotes and escapes any quote inside the translation,
      which matters because a CSS `content` string is quote-delimited and an unescaped one
      would terminate the declaration early and silently drop the suffix.
    -->
    <style is:inline set:html={`:root{--a11y-opens-in-new-tab:${JSON.stringify(` (${t('common.aria.opensInNewTab')})`)}}`}></style>

    <!-- Skip Navigation Styles -->
    <style>
      .skip-nav {
        position: absolute;
        top: -100px;
        inset-inline-start: 0;
        z-index: var(--z-max);
      }

      .skip-nav-link {
        position: absolute;
        top: -100px;
        inset-inline-start: var(--space-2);
        background: var(--color-text);
        color: var(--color-bg-alt);
        padding: var(--space-2) var(--space-4);
        text-decoration: none;
        font-size: var(--font-size-sm);
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        transition: top var(--transition-duration-slow) var(--ease-standard);
        border: 2px solid var(--color-bg-alt);
      }

      .skip-nav-link:focus {
        top: 0;
        outline: 3px solid var(--color-brand-primary);
        outline-offset: 2px;
      }

      .skip-nav-link:focus:hover {
        background: var(--color-text-secondary);
      }
    </style>

    <!-- Embed mode: the CLI reference iframe hides site chrome.
         This block used to also carry a 17-token `:root` copy plus scoped
         duplicates of `.nav`, `.nav-container`, `.nav-brand`, `.logo`,
         `.nav-wordmark`, `.container`, `*`, `body` and `main`. The `:root`
         copies were the LAST style source in the document and silently
         overrode public/styles/main.css for every token they redeclared;
         the rest were scoped to `[data-astro-cid-37fxchfa]` and so never
         matched the React-island nav they were written for. Both are gone;
         the tokens live in exactly one place now. Only these globals are
         load-bearing, which is why only these remain. -->
    <style>
      :global(html.cli-ref-embed .skip-nav),
      :global(html.cli-ref-embed #navigation),
      :global(html.cli-ref-embed .nav),
      :global(html.cli-ref-embed #footer),
      :global(html.cli-ref-embed footer),
      :global(html.cli-ref-embed .overlay-backdrop) {
        display: none !important;
      }

      :global(html.cli-ref-embed) {
        scroll-behavior: auto;
      }

      :global(html.cli-ref-embed main) {
        padding-top: 0 !important;
      }
    </style>
</head>
<body>
    <!-- Skip Navigation Links for Accessibility -->
    <div class="skip-nav">
      <a href="#main-content" class="skip-nav-link">{t('common.skipNavigation.skipToMainContent')}</a>
      <a href="#navigation" class="skip-nav-link">{t('common.skipNavigation.skipToNavigation')}</a>
      <a href="#footer" class="skip-nav-link">{t('common.skipNavigation.skipToFooter')}</a>
    </div>

    <AnnouncementBar lang={currentLang} />
    <Navigation lang={currentLang} origin={Astro.url.origin} client:idle />
    <main id="main-content">
        <slot />
    </main>
    <CliReferenceModal lang={currentLang} />
    <ImageModal lang={currentLang} />
    <ContactModal lang={currentLang} client:load />
    <RegionPickerModal lang={currentLang} client:load />
    <NewsletterReturnPopup lang={currentLang} client:load />
    <LeadMagnetModal lang={currentLang} client:idle />
    <Footer lang={currentLang} client:visible />
    <script src="/scripts/main.js" is:inline></script>
    <script src="/scripts/contact-interceptor.js" is:inline></script>
    <script src="/scripts/image-modal.js" is:inline></script>
    <script src="/scripts/search-hotkey.js" is:inline></script>
    <script src="/scripts/scroll-reveal.js" is:inline></script>
    <script src="/scripts/tracker.js" is:inline></script>
    <script is:inline>
      // Single source of truth for the marketing-host rule. Mirrors
      // src/utils/marketing-host.ts so React components and inline scripts
      // (CfPricingCard's checkout, Navigation/Sidebar's Account button)
      // all agree on which hosts open the region picker vs navigate
      // directly. See utils/marketing-host.ts header for the full matrix.
      // PR previews (*.rediacc.workers.dev) are NOT marketing hosts: they
      // serve a working portal backed by a per-PR D1, so /account/* CTAs
      // navigate directly and the funnel is testable per PR.
      window.__rediaccIsMarketingHost = function (hostname) {
        return (
          hostname === 'www.rediacc.com' ||
          hostname === 'edge.rediacc.com' ||
          hostname === 'localhost'
        );
      };

      // Intercept every same-origin /account/* anchor click. On marketing
      // hosts (www, dev, PR previews) the marketing site does not serve
      // the portal, so we open the region picker with the anchor's path
      // as the target. On portal hosts (regional cloud, edge, bench,
      // on-prem) we let the anchor navigate normally.
      //
      // Covers the announcement bar and any plain /account/* link without
      // per-anchor decoration. Cross-origin links to
      // https://eu.rediacc.com/account/... are pass-through (already
      // explicit destinations).
      (function () {
        // "Already bound" is tracked in a WeakSet, NOT in a data attribute.
        // It used to write `data-account-link-bound="true"` on each anchor,
        // and this script runs on DOMContentLoaded while <Navigation> and
        // <Sidebar> hydrate on `client:idle`, so React arrived at an <a> in
        // its own tree carrying an attribute React had never rendered. That
        // is a hydration mismatch, which React reports as a console error and
        // explicitly "won't patch up". A WeakSet keys off the node itself, so
        // it is invisible to hydration and still idempotent: a node React
        // replaces is simply a new key and gets bound again.
        var boundAccountLinks = new WeakSet();
        function bindAccountLinks() {
          var links = document.querySelectorAll('a[href^="/account"]');
          for (var i = 0; i < links.length; i++) {
            var link = links[i];
            if (boundAccountLinks.has(link)) continue;
            boundAccountLinks.add(link);
            link.addEventListener('click', function (e) {
              var href = this.getAttribute('href');
              if (!href) return;
              var url;
              try {
                url = new URL(href, window.location.origin);
              } catch (_) {
                return;
              }
              if (url.origin !== window.location.origin) return;
              // Match /account, /account/, /account/login, /account/?...
              // Exclude /account-management or /account-foo by requiring
              // the path to be exactly "/account" or to start with "/account/".
              if (url.pathname !== '/account' && url.pathname.indexOf('/account/') !== 0) return;
              if (!window.__rediaccIsMarketingHost(window.location.hostname)) return;
              e.preventDefault();
              var target = url.pathname + url.search + url.hash;
              if (window.plausible) {
                window.plausible('account_link_click', {
                  props: {
                    source: this.dataset.trackLabel || 'unknown',
                    dest: target,
                  },
                });
              }
              if (window.openRegionPicker) {
                window.openRegionPicker(target);
              }
            });
          }
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindAccountLinks);
        } else {
          bindAccountLinks();
        }
        // Re-bind after Astro view-transition page loads (the new page may
        // contain fresh anchors that weren't in the document at first load).
        document.addEventListener('astro:page-load', bindAccountLinks);
      })();
    </script>
    <script is:inline>
      (function() {
        function hideEmbedChrome() {
          try {
            if (new URLSearchParams(window.location.search).get('embed') !== 'cli-ref') return;
          } catch {
            return;
          }

          document.documentElement.classList.add('cli-ref-embed');

          const selectors = [
            '.skip-nav',
            '#navigation',
            '.nav',
            '#footer',
            'footer',
            '.overlay-backdrop'
          ];

          selectors.forEach((selector) => {
            document.querySelectorAll(selector).forEach((node) => {
              if (node instanceof HTMLElement) {
                node.style.display = 'none';
              }
            });
          });
        }

        document.addEventListener('astro:page-load', hideEmbedChrome);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', hideEmbedChrome);
        } else {
          hideEmbedChrome();
        }
      })();
    </script>
</body>
</html>
