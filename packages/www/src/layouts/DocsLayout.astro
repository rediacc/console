      }
    }

    /* Responsive Design - TOC sidebar is hidden on tablets/phones (handled in sidebar-shared.css) */
    @media (max-width: 75rem) {
      /* 1200px. The TOC rail is display:none here, so the grid drops to nav +
         article and the article takes the whole remainder: there is no room
         left to dock anything against. */
      .docs-layout {
        grid-template-columns: var(--docs-rail-nav) minmax(0, 1fr);
      }

      /* The browse page has no rail to make room for, at any width. Without this it
         inherited the nav track anyway and, having nothing to put in it, auto-placed
         the whole card grid INTO it: measured at 1100, `.docs-browse` came out 250px
         wide. The breakpoint below is safe only because one track is one track. */
      .docs-shell-browse .docs-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      /* Two tracks now, so hand placement back to auto: rail then article, in
         DOM order. */
      .docs-layout > :global(.docs-sidebar),
      .docs-layout > .docs-content,
      .docs-layout > .toc-sidebar {
        grid-column: auto;
      }
    }

    @media (max-width: 48rem) {
      .docs-shell {
        padding: calc(var(--nav-top-offset) + var(--space-3)) var(--space-2) var(--space-4) var(--space-2);
      }

      /* The tab strip and the tools wrap onto two rows rather than the tabs
         being squeezed to nothing beside them. */
      .docs-header-row {
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        padding-block: var(--space-2);
      }

      .docs-search-trigger {
        max-inline-size: none;
      }

      /* Icon only: the row is already two lines here and the glyph plus caret
         says everything the word did. aria-label on the trigger keeps the
         accessible name. */
      .docs-theme-trigger-text {
        display: none;
      }

      /* 768px */
      .docs-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      /* One track, and .docs-sidebar-toggle becomes a grid item here. Auto for
         every child keeps the toggle first in DOM order; pinning the other
         three to column 1 while the toggle stayed auto placed it in the LAST
         row instead of the first. */
      .docs-layout > :global(.docs-sidebar),
      .docs-layout > .docs-content,
      .docs-layout > .toc-sidebar {
        grid-column: auto;
      }

      .article-title {
        font-size: var(--font-size-2xl);
      }

      .article-header-main {
        flex-direction: column;
      }

      .docs-sidebar-toggle {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        width: 100%;
        padding: var(--space-3);
        background: var(--color-bg-alt, var(--color-bg));
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        font-size: var(--font-size-sm);
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        margin-bottom: var(--space-4);
        transition: background-color var(--transition-duration-fast) var(--ease-standard);
      }

      .docs-sidebar-toggle:hover {
        background: var(--color-hover, var(--color-bg-alt));
      }

      .docs-sidebar-toggle:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 2px;
      }

      .docs-sidebar-toggle[aria-expanded="true"] {
        margin-bottom: 0;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom: none;
      }

      .docs-layout :global(#docs-sidebar-nav) {
        display: none;
      }

      .docs-layout :global(#docs-sidebar-nav.docs-sidebar-visible) {
        display: block;
        border: 1px solid var(--color-border);
        border-top: none;
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        padding: var(--space-3);
        margin-bottom: var(--space-4);
        background: var(--color-bg-alt, var(--color-bg));
      }

    }
  </style>

  <LlmsInlineScript page="docs" />

  <script is:inline>
  (function() {
    function initDocsSidebarToggle() {
      var btn = document.querySelector('.docs-sidebar-toggle');
      var sidebar = document.getElementById('docs-sidebar-nav');
      if (!btn || !sidebar) return;
      if (btn.dataset.toggleInit === 'true') return;
      btn.dataset.toggleInit = 'true';

      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        sidebar.classList.toggle('docs-sidebar-visible', !expanded);
      });
    }

    document.addEventListener('astro:page-load', initDocsSidebarToggle);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDocsSidebarToggle);
    } else {
      initDocsSidebarToggle();
    }
  })();
  </script>
</BaseLayout>
