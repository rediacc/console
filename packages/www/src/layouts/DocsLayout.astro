---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsTopTabs from '../components/DocsTopTabs.astro';
import DocsSearchMount from '../components/DocsSearchMount';
import Breadcrumb from '../components/Breadcrumb.astro';
import DocsPageActions from '../components/DocsPageActions.astro';
import LlmsInlineScript from '../components/LlmsInlineScript.astro';
import StructuredData from '../components/StructuredData.astro';
import type { Language } from '../i18n/types';
import { createTranslator } from '../i18n/utils';
import { generateTOCFromHtml } from '../utils/sidebar-behavior';
import '../styles/sidebar-shared.css';
import '../styles/article-content.css';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    category?: string;
  };
  url: string;
  currentLang: Language;
  showFallbackNotice?: boolean;
  variant?: 'article' | 'index';
  tocItems?: Array<{ id: string; title: string; level: number }>;
  tocTrackingSelector?: string;
  showTOC?: boolean;
}

const {
  frontmatter,
  url,
  currentLang,
  showFallbackNotice,
  variant = 'article',
  tocItems,
  tocTrackingSelector = '.article-content h2, .article-content h3, .article-content h4',
  showTOC = true
} = Astro.props as Props;

// D-5: the docs search returns Documentation hits only; the site-wide Cmd/Ctrl+K
// modal keeps returning both. These are the `category` values the generated
// search index actually carries ("Documentation" and "Blog"), not a display
// label, so the filter is an exact match rather than a heuristic.
const DOCS_SEARCH_CATEGORIES = ['Documentation'] as const;

// Extract slug for markdown alternate link
const slugMatch = url.match(/\/docs\/([^/]+)\/?$/);
const docSlug = slugMatch ? slugMatch[1] : '';
const mdUrl = docSlug ? `/${currentLang}/docs/${docSlug}.md` : '';

// Generate breadcrumbs
const { t } = createTranslator(currentLang);
const breadcrumbItems = variant === 'article'
  ? [
      {
        name: t('navigation.home'),
        url: `/${currentLang}`
      },
      {
        name: t('navigation.docs'),
        url: `/${currentLang}/docs`
      },
      {
        name: frontmatter.title,
        url: url
      }
    ]
  : [];

// Generate table of contents from rendered HTML using shared utility
const tocFromContent = generateTOCFromHtml(await Astro.slots.render('default'));
const toc = tocItems ?? tocFromContent;
const shouldTrackTOC = !tocItems && toc.length > 0;
// Whether the TOC rail is actually RENDERED. The grid reserved its 250px track
// unconditionally, so the browse page (showTOC={false}) laid out as
// `250px 0px 765px 0px 250px` at 1440 and parked a quarter of the viewport, empty, to
// the right of content that had nothing docked against it.
const hasTOC = showTOC && toc.length > 0;
// Hoisted out of the `class:list` below rather than written inline as
// `variant === 'index' && '...'`: check:ci-css-dom-refs harvests every string literal in a
// class position, so the comparison's `'index'` was reported as a rendered-but-unstyled
// class. The flag reads better anyway.
const isBrowse = variant === 'index';

// The TOC nests: h2 entries are top-level, h3/h4 gather under their h2, and a branch
// collapses on a USER click only. A previous collapsible rail was removed because
// scroll-spy drove its open/close, so the rail's own height changed under the reader's
// cursor while they scrolled -- that constraint stands: branches default to open, the
// spy only ever paints highlights (including `has-active` on a branch the reader chose
// to collapse), and NOTHING scroll-driven may expand or collapse a branch.
type TocEntry = { id: string; title: string; level: number };
const tocTree: { entry: TocEntry; children: TocEntry[] }[] = [];
for (const entry of toc as TocEntry[]) {
  const last = tocTree[tocTree.length - 1];
  if (entry.level <= 2 || !last) tocTree.push({ entry, children: [] });
  else last.children.push(entry);
}
---

<BaseLayout
  title={`${frontmatter.title} | Rediacc`}
  description={frontmatter.description}
  lang={currentLang}
>
  {mdUrl && <link slot="head" rel="alternate" type="text/markdown" href={mdUrl} />}
  {/* `docs-shell-browse` is TOTAL -- it replaces the whole track list with one track --
      so the no-TOC modifier must not ride along beside it. Both set `--docs-tracks` at
      the same specificity, and the no-TOC rule is further down the sheet, so a browse
      page carrying both classes laid out as `250px 123.5px 800px 123.5px` and
      auto-placed its content into the 250px rail track. */}
  <div class:list={['docs-shell', !hasTOC && !isBrowse && 'docs-shell-no-toc', isBrowse && 'docs-shell-browse']}>
    <div class="docs-shell-top">
      <div class="docs-header-row">
        {/* Both surfaces. The tabs are the category navigation: every tab lands on the
            browse page filtered to its category (`?category=`), where the cards for that
            category are what the reader sees. They render on the browse page too so the
            reader can move between categories from there -- the browse script hides its
            own category filter group when a tab expressed the choice, so the axis has
            one control, not two. */}
        <DocsTopTabs
          currentLang={currentLang}
          currentCategory={frontmatter.category}
        />

        <div class="docs-header-tools">
          {/* Server-rendered trigger, not part of the React island. The island
              below is headless: it carries the modal and nothing else, so the
              control the reader sees is present in the HTML and works the
              moment the island hydrates, with no layout shift on hydration. */}
          <button
            type="button"
            class="docs-search-trigger"
            data-docs-search-open
            aria-label={t('documentation.searchDocs')}
          >
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="6" />
              <path d="M12.5 12.5L17 17" />
            </svg>
            <span class="docs-search-trigger-text">{t('pages.docs.searchPlaceholder')}</span>
          </button>

          {/* Light / Dark / Auto. The popover contract is the one LanguageMenu
              established (anchored to its own button, click-outside, Escape
              returns focus to the trigger, roving arrow keys), implemented
              inline rather than as a second React island: three radio options
              do not need a hydration boundary, and the site's standing problem
              is shipped JavaScript. */}
          <div class="docs-theme">
            <button
              type="button"
              class="docs-theme-trigger"
              id="docs-theme-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="docs-theme-menu"
              aria-label={t('documentation.theme.label', 'Theme')}
            >
              <svg class="docs-theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg class="docs-theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
              <span class="docs-theme-trigger-text">{t('documentation.theme.label', 'Theme')}</span>
              <svg class="docs-theme-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="docs-theme-menu" id="docs-theme-menu" role="menu" aria-labelledby="docs-theme-trigger" hidden>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="light" aria-checked="false">{t('documentation.theme.light', 'Light')}</button>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="dark" aria-checked="false">{t('documentation.theme.dark', 'Dark')}</button>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="auto" aria-checked="false">{t('documentation.theme.auto', 'Auto')}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="docs-layout">
      {/* The article navigation tree, and the control that opens it on a phone, are
          ARTICLE furniture. The browse page is the index of that tree: rendering the
          tree beside it duplicated the page's own job and squeezed the cards into a
          middle column. Both the rail and its toggle are omitted there, which leaves
          the browse page a single full-width slot to lay its filter rail out in.
          The toggle script below reads both elements and returns early when either is
          missing, so nothing is left dangling. */}
      {!isBrowse && (
        <button class="docs-sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <span>{t('pages.docs.title')}</span>
        </button>
      )}
      {!isBrowse && (
        <DocsSidebar
          currentLang={currentLang}
          currentUrl={url}
          visibleCategory={frontmatter.category}
        />
      )}

      {/* A <div>, not a <main>: BaseLayout.astro:321 already emits the page's one
          <main id="main-content"> and this sits inside it. Nesting a second landmark
          shipped on 1,120 of 1,842 built pages and is what axe reports as
          landmark-no-duplicate-main / landmark-main-is-top-level / landmark-unique. */}
      <div class="docs-content">
        <article class="docs-article">
          {variant === 'article' && <Breadcrumb items={breadcrumbItems} />}
          {variant === 'article' && (
            <StructuredData
              type="techarticle"
              data={{
                title: frontmatter.title,
                description: frontmatter.description,
                category: frontmatter.category,
                url: `${url}`,
                language: currentLang,
              }}
            />
          )}

          {variant === 'article' && showFallbackNotice && (
            <div class="fallback-notice" role="alert">
              <div class="fallback-notice-icon">ℹ️</div>
              <div class="fallback-notice-content">
                <strong class="fallback-notice-title">{t('pages.docs.fallbackNotice.title')}</strong>
                <p class="fallback-notice-message">{t('pages.docs.fallbackNotice.message')}</p>
              </div>
            </div>
          )}

          {variant === 'article' && (
            <header class="article-header">
              {/* The per-document illustration, finally on the document.

                  These 79 files under public/img/docs-thumbs/ have existed at 100%
                  coverage since round 4 and the browse card was their ONLY consumer
                  anywhere in the codebase, so a reader who arrived from search or from a
                  link never saw the picture drawn for the page they were on. Resolved by
                  filename convention from the URL slug, which IS the base slug in every
                  locale (see [slug].astro's getStaticPaths), so all 13 locales share one
                  file and none of them needs a lookup table.

                  alt="" because the picture restates the title and the category the page
                  already gives in words, exactly as on the browse card. Eager, not lazy:
                  it is the first thing in the article and lazy-loading the top of the
                  viewport only delays it. The intrinsic width/height reserve the box so
                  the H1 does not jump when it lands. */}
              {docSlug && (
                <img
                  class="docs-article-thumb"
                  src={`/img/docs-thumbs/${docSlug}.svg`}
                  alt=""
                  width="320"
                  height="120"
                  decoding="async"
                />
              )}
              <div class="article-header-main">
                <h1 class="article-title">{frontmatter.title}</h1>
                {mdUrl && <DocsPageActions currentLang={currentLang} mdUrl={mdUrl} />}
              </div>

              {frontmatter.description && (
                <p class="article-description">{frontmatter.description}</p>
              )}
            </header>
          )}

          <div class="article-content">
            <slot />
          </div>
        </article>
      </div>

      {/* aria-labelledby, not a second aria-label: this <aside> and the docs sidebar's
          <aside> are both `complementary` and both were unnamed, which axe reports as
          landmark-unique (measured on /en/docs/quick-start, 1 node). Borrowing the
          visible heading names it without inventing a string, and leaves ONE authored
          name for the rail instead of two that can drift.
          The comment sits OUTSIDE the `hasTOC &&` expression on purpose: a JSX comment
          is a child node, so putting it inside gave that expression two children with
          no fragment and every docs route answered 500. */}
      {hasTOC && (
        <aside class="sidebar-base sidebar-toc toc-sidebar" aria-labelledby="docs-toc-heading" data-track={shouldTrackTOC ? 'true' : 'false'} data-selector={tocTrackingSelector}>
          <nav class="sidebar-nav sidebar-nav-with-accent toc-nav" role="navigation" aria-label={t('common.aria.tableOfContents')}>
            <h3 class="sidebar-title toc-title" id="docs-toc-heading">{t('pages.docs.tableOfContents')}</h3>
            <ul class="sidebar-list toc-list">
              {tocTree.map((node, index) => {
                const hasChildren = node.children.length > 0;
                const branchId = `toc-branch-${index}`;
                return (
                  <li
                    class={`sidebar-item toc-item toc-level-${node.entry.level}${hasChildren ? ' toc-branch' : ''}`}
                    data-expanded={hasChildren ? 'true' : undefined}
                  >
                    {hasChildren ? (
                      <>
                        <div class="toc-row">
                          <a href={`#${node.entry.id}`} class="sidebar-link toc-link">{node.entry.title}</a>
                          <button
                            type="button"
                            class="toc-toggle"
                            aria-expanded="true"
                            aria-controls={branchId}
                            aria-label={t('documentation.tocToggleSection', 'Toggle section')}
                          >
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <path d="m6 9 6 6 6-6" />
                            </svg>
                          </button>
                        </div>
                        <ul class="sidebar-list toc-sublist" id={branchId}>
                          {node.children.map((child) => (
                            <li class={`sidebar-item toc-item toc-level-${child.level}`}>
                              <a href={`#${child.id}`} class="sidebar-link toc-link">{child.title}</a>
                            </li>
                          ))}
                        </ul>
                      </>
                    ) : (
                      <a href={`#${node.entry.id}`} class="sidebar-link toc-link">{node.entry.title}</a>
                    )}
                  </li>
                );
              })}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>

  {/* Headless: it renders the modal and nothing else. Kept OUTSIDE .docs-shell
      so the island wrapper element is never a child of a layout container that
      might count it. */}
  <DocsSearchMount client:idle categories={DOCS_SEARCH_CATEGORIES} scope="docs" />

  <div id="docs-i18n" hidden
    data-copied={t('documentation.copied')}
    data-copy-code={t('documentation.copyCode')}
  ></div>

  <script is:inline>
    // Apply embed mode for iframe preview pages via runtime query param detection.
    (function() {
      function applyCliRefEmbedMode() {
        const docsShell = document.querySelector('.docs-shell');
        if (!docsShell) return;

        const search = window.location.search;
        const isEmbed = new URLSearchParams(search).get('embed') === 'cli-ref';
        docsShell.classList.toggle('docs-shell-embed', isEmbed);
      }

      document.addEventListener('astro:page-load', applyCliRefEmbedMode);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyCliRefEmbedMode);
      } else {
        applyCliRefEmbedMode();
      }
    })();
  </script>

  <script is:inline>
    // TOC scroll-spy.
    //
    // No `window.rediaccTOCInitialized` guard. That guard made init run exactly
    // once per PAGE LOAD, which is once per browsing session under Astro view
    // transitions: after a client-side navigation the observer was still
    // watching the previous document's heading nodes, so the TOC of the page
    // you were reading tracked the page you had left. The lifecycle is instead
    // a module-scoped observer that disconnects at the top of every init.
    (function() {
      var observer = null;
      // Ids of every heading currently inside the spy band, so the active link
      // can be the FIRST one in document order. The previous version took
      // whichever entry the callback happened to see last, which on a fast
      // scroll -- or on any single callback carrying several entries -- could
      // activate a heading below the one being read.
      var visible = new Set();
      var order = [];

      /* Bring a rail's active link into view WITHOUT Element.scrollIntoView.
         scrollIntoView walks every scrollable ancestor up to and including the
         document, so nudging a link inside the 250px rail also scrolled the
         article out from under the reader. Arithmetic on the rail's own
         scrollTop touches nothing else. Guarded on the rail actually being a
         scroll container: with a max-height rail, a short TOC is not one, and
         scrolling it is both pointless and a no-op we should not pay for. */
      function revealInRail(nav, el) {
        if (!nav || !el) return;
        // A link inside a collapsed branch has no box; its rect is all zeros and the
        // arithmetic below would scroll the rail to its own top.
        if (el.offsetParent === null) return;
        if (nav.scrollHeight <= nav.clientHeight) return;
        var navBox = nav.getBoundingClientRect();
        var elBox = el.getBoundingClientRect();
        var margin = 24;
        if (elBox.top < navBox.top + margin) {
          nav.scrollTop -= (navBox.top + margin) - elBox.top;
        } else if (elBox.bottom > navBox.bottom - margin) {
          nav.scrollTop += elBox.bottom - (navBox.bottom - margin);
        }
      }

      function initTOCActiveState() {
        var container = document.querySelector('.toc-sidebar');
        if (!container) return; // No TOC sidebar on this page

        if (container.getAttribute('data-track') !== 'true') return;

        var selector = container.getAttribute('data-selector') || '.article-content h2, .article-content h3, .article-content h4';
        var headings = Array.prototype.slice.call(document.querySelectorAll(selector));
        if (headings.length === 0) return; // No headings to track

        var nav = container.querySelector('.sidebar-nav');
        order = headings.map(function(h) { return h.id; }).filter(Boolean);
        visible = new Set();

        function paint() {
          var activeId = null;
          for (var i = 0; i < order.length; i++) {
            if (visible.has(order[i])) { activeId = order[i]; break; }
          }
          if (!activeId) return;
          var link = container.querySelector('a[href="#' + CSS.escape(activeId) + '"]');
          if (!link || link.classList.contains('active')) return;
          container.querySelectorAll('a.active').forEach(function(a) {
            a.classList.remove('active');
          });
          link.classList.add('active');
          // Mark the branch holding the active heading. This is a HIGHLIGHT, never an
          // expand: a branch the reader collapsed stays collapsed, and the marker is
          // what keeps their place visible on its top row (see the has-active rule).
          container.querySelectorAll('.toc-branch.has-active').forEach(function(b) {
            b.classList.remove('has-active');
          });
          var sublist = link.closest('.toc-sublist');
          if (sublist) {
            var branch = sublist.closest('.toc-branch');
            if (branch) branch.classList.add('has-active');
          }
          revealInRail(nav, link);
        }

        /* The band's top edge is the site's one anchor offset, read from the
           computed scroll-padding-top rather than hardcoded. A literal is wrong
           in one of the two announcement-bar states, because
           --announcement-bar-height is written at runtime by AnnouncementBar. */
        var pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
        if (!isFinite(pad)) pad = 0;

        observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            var id = entry.target.id;
            if (!id) return;
            if (entry.isIntersecting) visible.add(id);
            else visible.delete(id);
          });
          paint();
        }, {
          rootMargin: '-' + Math.round(pad) + 'px 0px -66% 0px'
        });

        headings.forEach(function(heading) { observer.observe(heading); });
      }

      function init() {
        if (observer) { observer.disconnect(); observer = null; }
        initTOCActiveState();
      }

      // Astro View Transitions support
      document.addEventListener('astro:page-load', init);

      // Initial load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

  <script is:inline>
    // TOC branch toggles. USER-driven only, by standing constraint (see the tocTree
    // comment in the frontmatter): nothing here listens to scroll, and the default is
    // every branch open, so collapse is always a reader's own choice.
    (function() {
      function initTocToggles() {
        document.querySelectorAll('.toc-branch').forEach(function(item) {
          if (item.dataset.tocToggleBound === 'true') return;
          item.dataset.tocToggleBound = 'true';
          var btn = item.querySelector('.toc-toggle');
          if (!btn) return;
          btn.addEventListener('click', function() {
            var expanded = item.getAttribute('data-expanded') === 'true';
            item.setAttribute('data-expanded', expanded ? 'false' : 'true');
            btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          });
        });
      }
      document.addEventListener('astro:page-load', initTocToggles);
      if (document.readyState !== 'loading') initTocToggles();
      else document.addEventListener('DOMContentLoaded', initTocToggles);
    })();
  </script>

  <script is:inline>
    // Light / Dark / Auto.
    //
    // The pre-paint block in BaseLayout owns the RULE (an explicit
    // localStorage['theme'] wins; otherwise the clock plus the OS preference).
    // This control only writes that key, so Auto is `removeItem`, not a third
    // stored value: a stored "auto" would be a second source of truth for the
    // same decision. The class flip is repeated here because the pre-paint
    // block runs once, before this element exists.
    (function() {
      var STORE = 'theme';
      var menuOpen = false;

      function stored() {
        try {
          var v = localStorage.getItem(STORE);
          return v === 'dark' || v === 'light' ? v : null;
        } catch (e) {
          return null;
        }
      }

      function resolve() {
        var explicit = stored();
        if (explicit) return explicit;
        var hour = new Date().getHours();
        if (hour >= 20 || hour < 6) return 'dark';
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      }

      function applyTheme() {
        var theme = resolve();
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#0f0f10' : '#4a7c3f';
      }

      function syncChecked(root) {
        var current = stored() || 'auto';
        root.querySelectorAll('.docs-theme-option').forEach(function(opt) {
          opt.setAttribute('aria-checked', String(opt.dataset.themeChoice === current));
        });
      }

      /* The two document-level listeners are registered ONCE, here, and read the
         live control through `current`. Registering them inside init would add
         a pair per initialisation and leave every old pair holding a reference
         to a control that is no longer in the document -- a slower version of
         exactly the lifecycle bug this wave removes. */
      var current = null;

      function setOpen(next) {
        if (!current) return;
        menuOpen = next;
        current.menu.hidden = !next;
        current.trigger.setAttribute('aria-expanded', String(next));
      }

      function close(returnFocus) {
        var trigger = current && current.trigger;
        setOpen(false);
        if (returnFocus && trigger) trigger.focus();
      }

      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && menuOpen) close(true);
      });

      document.addEventListener('mousedown', function(event) {
        if (menuOpen && current && !current.root.contains(event.target)) close(false);
      });

      function initThemeControl() {
        var root = document.querySelector('.docs-theme');
        if (!root) { current = null; return; }

        var trigger = root.querySelector('.docs-theme-trigger');
        var menu = root.querySelector('.docs-theme-menu');
        if (!trigger || !menu) { current = null; return; }
        var options = Array.prototype.slice.call(menu.querySelectorAll('.docs-theme-option'));
        current = { root: root, trigger: trigger, menu: menu, options: options };
        menuOpen = !menu.hidden;

        syncChecked(root);
        if (root.dataset.themeInit === 'true') return;
        root.dataset.themeInit = 'true';

        trigger.addEventListener('click', function() {
          setOpen(!menuOpen);
          if (menuOpen) {
            syncChecked(root);
            var checked = options.find(function(o) { return o.getAttribute('aria-checked') === 'true'; });
            (checked || options[0]).focus();
          }
        });

        options.forEach(function(opt, index) {
          opt.addEventListener('click', function() {
            var choice = opt.dataset.themeChoice;
            try {
              if (choice === 'auto') localStorage.removeItem(STORE);
              else localStorage.setItem(STORE, choice);
            } catch (e) { /* private mode: the choice just does not persist */ }
            applyTheme();
            syncChecked(root);
            close(true);
          });
          opt.addEventListener('keydown', function(event) {
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              options[(index + 1) % options.length].focus();
            } else if (event.key === 'ArrowUp') {
              event.preventDefault();
              options[(index - 1 + options.length) % options.length].focus();
            } else if (event.key === 'Home') {
              event.preventDefault();
              options[0].focus();
            } else if (event.key === 'End') {
              event.preventDefault();
              options[options.length - 1].focus();
            }
          });
        });
      }

      document.addEventListener('astro:page-load', initThemeControl);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeControl);
      } else {
        initThemeControl();
      }
    })();
  </script>

  <script is:inline>
    /* The docs search trigger is delegated on `document`, not bound to the
       button. Delegation survives an Astro view transition replacing the header
       without any rebinding, which is exactly the failure mode the set-once
       guards elsewhere in this file used to create. */
    (function() {
      document.addEventListener('click', function(event) {
        var trigger = event.target instanceof Element
          ? event.target.closest('[data-docs-search-open]')
          : null;
        if (!trigger) return;
        event.preventDefault();
        document.dispatchEvent(new CustomEvent('docs-search:open'));
      });
    })();
  </script>

  <script is:inline>
    // One copy button per code block.
    //
    // This replaces a 336-line script that injected a 141px split button into
    // every h2 and h3 -- including a whole HTML-to-Markdown converter shipped to
    // the browser to serve one menu item. That control was permanently visible,
    // it left every heading's accessible name reading
    // "IntroductionCopy sectionvCopy section link...", and in Arabic it covered
    // the first 40px of the heading text. Deep links still work: the ids come
    // from remark, not from that script.
    (function() {
      function initCodeCopy() {
        var i18n = document.getElementById('docs-i18n');
        var copyLabel = (i18n && i18n.dataset.copyCode) || 'Copy code';
        var copiedLabel = (i18n && i18n.dataset.copied) || 'Copied!';

        document.querySelectorAll('.article-content pre').forEach(function(pre) {
          if (pre.dataset.copyBound === 'true') return;
          pre.dataset.copyBound = 'true';

          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.setAttribute('aria-label', copyLabel);
          btn.title = copyLabel;
          btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

          btn.addEventListener('click', function() {
            var code = pre.querySelector('code');
            navigator.clipboard.writeText((code || pre).textContent || '').then(function() {
              btn.classList.add('copied');
              btn.setAttribute('aria-label', copiedLabel);
              btn.title = copiedLabel;
              setTimeout(function() {
                btn.classList.remove('copied');
                btn.setAttribute('aria-label', copyLabel);
                btn.title = copyLabel;
              }, 2000);
            }).catch(function() {});
          });

          pre.appendChild(btn);
          addPerLineCopy(pre, copyLabel, copiedLabel);
        });
      }

      // PER-LINE COPY, for blocks that hold more than one runnable command.
      //
      // THE DEFECT: a reader looking at
      //     curl -fsSL https://www.rediacc.com/install.sh | bash
      //     rdc doctor     # Verify: Node, SSH key, renet, Docker
      // wants ONE of those lines, and the block-level button gives them both,
      // so the second command is pasted into a shell that is still running the
      // first. The block button stays -- copying the whole recipe is a real
      // want too -- and this adds a control per command line beside it.
      //
      // A LINE IS NOT A COMMAND. Shiki emits one `.line` span per source line,
      // including blank lines and comment-only lines. Offering "copy" on
      // `# Generate a key (skip if you already have one)` is noise, and offering
      // it on a blank line is worse, so both are skipped. A line that ENDS in a
      // trailing comment still copies whole: stripping it would hand the reader
      // something they cannot paste back to check against the page, and the
      // comment is harmless in a shell.
      //
      // Single-command blocks get NOTHING. There the block button already IS the
      // per-line button, and a second identical control next to it is pure noise.
      function isRunnableLine(text) {
        var t = (text || '').trim();
        if (t === '') return false;
        if (t.charAt(0) === '#') return false;
        return true;
      }

      function addPerLineCopy(pre, copyLabel, copiedLabel) {
        var code = pre.querySelector('code');
        if (!code) return;
        var lines = code.querySelectorAll('.line');
        if (!lines.length) return;

        var runnable = [];
        lines.forEach(function(line) {
          if (isRunnableLine(line.textContent)) runnable.push(line);
        });
        // One runnable line means the block button already covers it exactly.
        if (runnable.length < 2) return;

        pre.classList.add('has-line-copy');
        runnable.forEach(function(line, idx) {
          if (line.dataset.lineCopyBound === 'true') return;
          line.dataset.lineCopyBound = 'true';
          line.classList.add('line-copyable');

          var lbtn = document.createElement('button');
          lbtn.type = 'button';
          lbtn.className = 'line-copy';
          var label = copyLabel + ' (' + (idx + 1) + '/' + runnable.length + ')';
          lbtn.setAttribute('aria-label', label);
          lbtn.title = label;
          lbtn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';

          lbtn.addEventListener('click', function(ev) {
            ev.stopPropagation();
            // textContent of the line, minus the button's own (empty) text.
            var text = (line.textContent || '').replace(/\s+$/, '');
            navigator.clipboard.writeText(text).then(function() {
              lbtn.classList.add('copied');
              lbtn.setAttribute('aria-label', copiedLabel);
              lbtn.title = copiedLabel;
              setTimeout(function() {
                lbtn.classList.remove('copied');
                lbtn.setAttribute('aria-label', label);
                lbtn.title = label;
              }, 2000);
            }).catch(function() {});
          });

          line.appendChild(lbtn);
        });
      }

      document.addEventListener('astro:page-load', initCodeCopy);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCodeCopy);
      } else {
        initCodeCopy();
      }
    })();
  </script>

  <!-- Tutorial video hydration: mounts TutorialVideoPlayer for any .tutorial-video-container on the page. -->
  <script src="../scripts/tutorial-video-hydrate.ts"></script>

  <style>
    /* No max-width and no `margin: 0 auto`. Centring a 1400px shell inside a
       1920px viewport pushed the nav rail 260px in from the edge and the
       article 551px in, which is what made the docs read narrow: the reader
       paid for the whitespace on BOTH sides. The shell now spans the viewport
       and the five-track grid below decides where the void goes. */
    .docs-shell {
      padding: calc(var(--nav-top-offset) + var(--space-4)) var(--space-4) var(--space-8) var(--space-4);
      font-family: 'Inter', var(--font-family);

      /* The rail's sticky top has to clear the fixed nav AND the sticky docs
         chrome under it. --docs-chrome-height is the chrome's height; it is
         declared once in main.css because html:has() needs to read it there
         too, and the tab links in DocsTopTabs size themselves from it. */
      --sidebar-top-offset: calc(var(--docs-chrome-height, 3rem) + var(--space-4) + var(--space-4));

      --docs-rail-nav: 250px;
      --docs-rail-toc: 250px;
      --docs-measure: 800px;

      /* The column cluster's total width: three tracks plus the two gutters between
         them. The header row reads it to indent its content to the cluster's edges
         (the reference layout's tab strip starts above the sidebar, not at the
         viewport edge), so it must be restated by every modifier that changes the
         track list: the no-TOC variant below drops a rail and a gutter, and the
         full-width pages set it to 100% so the chrome spans with them. */
      --docs-cluster: calc(
        var(--docs-rail-nav) + var(--docs-measure) + var(--docs-rail-toc) + 2 * var(--space-8)
      );

      /* The track list, composed rather than written out at the grid, so the
         no-TOC variant drops the last track by leaving the toc rail off the
         end instead of restating the other two. It is a custom property and
         NOT a second `grid-template-columns` rule on purpose: a modifier class
         would outrank the two responsive rules below, which set the property
         literally and have no business being beaten by a page that happens to
         lack a TOC.

         There used to be two 1fr slack tracks flanking the measure, which
         pinned both rails to the viewport edges and put the void BETWEEN the
         rails and the article: at 1920 the reader's eye crossed 287px of
         nothing from the sidebar to the first word. The rails now sit one
         gutter from the content and the cluster centres as a unit
         (justify-content on .docs-layout below), so free space lands OUTSIDE
         the columns -- the layout the operator pointed at. Pages that want
         every pixel still get it: their `--docs-measure: 1fr` override makes
         the middle track absorb what the slack tracks used to. */
      --docs-tracks-body:
        var(--docs-rail-nav)
        minmax(0, var(--docs-measure));
      --docs-tracks: var(--docs-tracks-body) var(--docs-rail-toc);

      /* The PROSE measure, which is not the same thing as the measure TRACK. The
         track decides how much room the article gets; this decides how much of it
         the running text is allowed to use.

         RAISED 34rem -> 44rem ON OPERATOR INSTRUCTION ("make the middle column content
         wider. Do not resize the column"), which is the column staying at its 800px
         measure while the text inside stops stopping short of it. 544px left 256px of
         an 800px column unused.

         The trade, stated rather than hidden: 34rem was chosen because at the 16px body
         size the article column renders 101 characters per line, so 544/765 of that is
         ~72, inside the 65-75 that reads comfortably. 704px is ~93 characters, above
         that band. This is a deliberate override of a measured default, not an
         oversight, and the earlier answer to "bump it to 43rem?" was leave-it -- the
         instruction here supersedes that. 44rem stops 96px short of the 800px track so
         the text still sits in a column rather than becoming the column. */
      --docs-prose: 44rem;
    }

    /* A cheat sheet is a reference table, not prose: it wants every pixel, so
       the measure track takes all the free space instead of capping at 800px.
       Declared HERE rather than in CheatSheetGrid because Astro's scoping adds
       an attribute to every selector in this block, so `.docs-shell` here is
       (0,2,0) and the same selector written in the component's unscoped
       `is:inline` block is (0,1,0) -- the component cannot win without
       `!important`, which is exactly the escalation this rewrite removed.
       Verified, not assumed: the first attempt put these two lines in
       CheatSheetGrid and --docs-measure still computed to 800px. */
    .docs-shell:has(.cs-cards) {
      --docs-measure: 1fr;
      /* 1fr poisons the cluster calc (invalid at computed-value time would zero the
         chrome padding anyway, but silently); say what is meant: the columns span
         the shell, so the chrome does too. */
      --docs-cluster: 100%;
    }

    /* Tutorial pages release the measure for the same reason cheat sheets do:
       the payload is not prose. The player has no intrinsic max-width
       (tutorial-video.css), so at the 800px measure a 1920x1080 render is drawn
       at 800x450 and the recorded 107-column terminal gets ~7px per character --
       about an 11.7px effective font, at the legibility floor before anything
       else goes wrong. Widening the page buys back roughly a third of that and,
       unlike re-recording, it improves every video already published.
       Same specificity note as above: it must live here, not in the component. */
    .docs-shell:has(.tutorial-video-container) {
      --docs-measure: 1fr;
      --docs-cluster: 100%;
    }

    /* The browse page is ONE track: no article rail, no TOC, no measure cap. It is
       not prose, it is an index, and it owns its own rail and its own cap
       (styles/docs-browse.css). Everything this layout used to impose on it --
       250px of navigation, 250px of phantom TOC and an 800px measure -- was
       subtracting from a page whose job is to show many cards at once. */
    .docs-shell-browse {
      --docs-tracks: minmax(0, 1fr);
      /* The browse page's own content cap, so the chrome indents to the card grid's
         edges the way it indents to the rails on an article page. The literal is
         .docs-browse's max-width (styles/docs-browse.css); keep them in step. */
      --docs-cluster: 84rem;
    }

    /* One track, so the base rule's `grid-column: 2` would conjure an implicit
       track before it. Same hand-back the embed override and both breakpoints do. */
    .docs-shell-browse .docs-layout > .docs-content {
      grid-column: auto;
    }

    .docs-shell.docs-shell-embed {
      padding: var(--space-3) var(--space-3) var(--space-5);
    }

    .docs-shell.docs-shell-embed .docs-shell-top,
    .docs-shell.docs-shell-embed :global(.docs-sidebar),
    .docs-shell.docs-shell-embed .toc-sidebar,
    .docs-shell.docs-shell-embed .docs-article-thumb,
    .docs-shell.docs-shell-embed :global(.breadcrumb) {
      display: none !important;
    }

    /* Two classes deep, so it outranks both the base .docs-layout rule and the
       two responsive ones -- the embed has no rails at any width and must not
       be re-columned by a breakpoint. */
    .docs-shell.docs-shell-embed .docs-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* One track, so the base rule's `grid-column: 2` would invent track 2 and
       push the article off the right of an embed that has no rails. */
    .docs-shell.docs-shell-embed .docs-layout > :global(.docs-sidebar),
    .docs-shell.docs-shell-embed .docs-layout > .docs-content,
    .docs-shell.docs-shell-embed .docs-layout > .toc-sidebar {
      grid-column: auto;
    }

    .docs-shell.docs-shell-embed .article-header {
      margin-top: 0;
      margin-bottom: var(--space-4);
    }

    /* padding-bottom, not margin-bottom. A sticky element's margin is outside
       its background box, so the 16px gap under the chrome was transparent and
       article text scrolled visibly through it before disappearing behind the
       bar. Padding puts that gap inside the opaque box. */
    .docs-shell-top {
      display: block;
      padding-bottom: var(--space-4);
      position: sticky;
      top: var(--nav-top-offset);
      z-index: 10;
      background: var(--color-bg-alt);
    }

    /* A real flex container. This was `display: block` with an `align-items`
       that block layout ignores, which is why DocsTopTabs' own `flex: 1` had
       never done anything: it had no flex parent to be a child of. */
    .docs-header-row {
      display: flex;
      align-items: center;
      gap: var(--space-4);
      border-bottom: 1px solid var(--color-border);
      min-height: var(--docs-chrome-height, 3rem);
      /* Indent the chrome CONTENT to the column cluster's edges while the row itself
         stays full width: the hairline must keep spanning the shell (the reference
         does this), and the active tab's 2px underline sits ON that hairline, which
         a capped-and-centred row would have dragged inward with it. Padding, not
         margin, is what keeps both true at once. The max() clamp makes it vanish
         wherever the cluster fills the row -- narrow viewports and the 100% override
         on full-width pages -- and padding-inline is logical, so RTL mirrors free. */
      padding-inline: max(0px, calc((100% - var(--docs-cluster)) / 2));
    }

    .docs-header-tools {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      flex: 0 0 auto;
    }

    .docs-search-trigger {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      max-inline-size: 14rem;
      padding: var(--space-1) var(--space-3);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-bg-alt);
      color: var(--color-text-secondary);
      font-family: inherit;
      font-size: var(--font-size-sm);
      line-height: var(--leading-normal);
      cursor: pointer;
      transition:
        color var(--transition-duration-fast) var(--ease-standard),
        border-color var(--transition-duration-fast) var(--ease-standard);
    }

    .docs-search-trigger:hover {
      color: var(--color-text);
      border-color: var(--color-text-muted);
    }

    .docs-search-trigger:focus-visible {
      outline: 2px solid var(--color-brand-primary);
      outline-offset: 2px;
    }

    .docs-search-trigger-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .docs-theme {
      position: relative;
    }

    .docs-theme-trigger {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-1) var(--space-2);
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      background: none;
      color: var(--color-text-secondary);
      font-family: inherit;
      font-size: var(--font-size-sm);
      cursor: pointer;
    }

    .docs-theme-trigger:hover {
      color: var(--color-text);
      border-color: var(--color-border);
    }

    /* The label is translated, so its longest form is not something this
       stylesheet can know. Clip it rather than let it set the row's min-content
       width and push the page sideways. */
    .docs-theme-trigger-text {
      overflow: hidden;
      max-inline-size: 8rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .docs-theme-caret {
      flex-shrink: 0;
      opacity: var(--opacity-65, 0.65);
    }

    .docs-theme-trigger:focus-visible {
      outline: 2px solid var(--color-brand-primary);
      outline-offset: 2px;
    }

    /* The trigger shows the theme in force, so exactly one of the two glyphs is
       ever painted. Driven off the same data-theme attribute the pre-paint
       block writes, so it is correct on the first frame. */
    .docs-theme-icon-dark,
    :global([data-theme='dark']) .docs-theme-icon-light {
      display: none;
    }

    :global([data-theme='dark']) .docs-theme-icon-dark {
      display: inline;
    }

    /* Anchored to its own button, not to the header row: a three-item control
       does not need to reserve horizontal space it only uses while open.
       inset-inline-end so it opens inward under RTL as well. */
    .docs-theme-menu {
      position: absolute;
      inset-block-start: calc(100% + var(--space-1));
      inset-inline-end: 0;
      z-index: 20;
      min-inline-size: 8rem;
      padding: var(--space-1);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      background: var(--color-bg-alt);
      box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.12));
    }

    .docs-theme-menu[hidden] {
      display: none;
    }

    .docs-theme-option {
      display: block;
      inline-size: 100%;
      padding: var(--space-2) var(--space-3);
      border: none;
      border-radius: var(--radius-sm);
      background: none;
      color: var(--color-text);
      font-family: inherit;
      font-size: var(--font-size-sm);
      text-align: start;
      cursor: pointer;
    }

    .docs-theme-option:hover {
      background: var(--color-hover);
    }

    .docs-theme-option[aria-checked='true'] {
      font-weight: var(--font-weight-semibold);
      background: var(--color-hover);
    }

    .docs-theme-option:focus-visible {
      outline: 2px solid var(--color-brand-primary);
      outline-offset: -2px;
    }

    .docs-sidebar-toggle {
      display: none;
    }

    /* Three tracks: nav rail, measure, TOC rail, one gutter apart, and the
       whole cluster centred by `justify-content` when the tracks add up to
       less than the row. Two earlier shapes both parked the void in the wrong
       place: a single slack track at the END left 340px of dead space to the
       right of the TOC at 1920, and the slack-on-each-side-of-the-measure
       version that replaced it pinned both rails to the viewport edges, so the
       reader's eye crossed 287px of nothing between the sidebar and the first
       word. Centring the CLUSTER puts the void outside the columns instead.
       `justify-content: center`, never `margin` on a child or a physical
       `padding-right`: this layout's comment history records RTL regressions
       from physical properties, and content-distribution on the grid container
       is laid out in the inline direction, so dir=rtl mirrors with no second
       rule. On pages whose measure is 1fr (cheat sheets, tutorials, browse)
       the tracks fill the row and the centring is inert by construction.
       The article cap lives on the measure track rather than on .docs-article,
       so a page that wants the full width (a cheat sheet) redefines one custom
       property instead of fighting a max-width with !important. */
    .docs-layout {
      display: grid;
      grid-template-columns: var(--docs-tracks);
      justify-content: center;
      gap: var(--space-8);
      padding: 0;
    }

    /* No TOC rendered, no TOC track. Dropping the track takes its gap with it,
       which a `--docs-rail-toc: 0px` override would not: a zero-width track
       still costs a full `gap` between it and the one before. It has to sit on
       .docs-shell rather than on .docs-layout because a custom property's
       var() references are substituted on the element that DECLARES it: an
       override further down the tree arrives too late to change the composed
       list it inherits. */
    .docs-shell-no-toc {
      --docs-tracks: var(--docs-tracks-body);
      /* One rail and one gutter fewer, so the chrome indents to the narrower cluster. */
      --docs-cluster: calc(var(--docs-rail-nav) + var(--docs-measure) + var(--space-8));
    }

    /* Explicit placement: with the slack tracks gone the DOM order happens to
       match the track order, but leaving it to auto-placement makes the layout
       hostage to a DOM reorder. Every rule that changes the track COUNT (the
       embed override and the two max-width breakpoints below) has to hand
       these back to `auto`, or a definite column 2 or 3 conjures implicit
       tracks in a grid that only has one. */
    .docs-layout > :global(.docs-sidebar) {
      grid-column: 1;
    }

    .docs-layout > .docs-content {
      grid-column: 2;
    }

    .docs-layout > .toc-sidebar {
      grid-column: 3;
    }


    /* Main Content */
    .docs-content {
      min-width: 0;
      font-size: var(--font-size-base);
    }

    /* Flatten sidebars to match integrated docs rails style */
    .docs-shell :global(.docs-sidebar .sidebar-nav),
    .docs-shell :global(.toc-sidebar .sidebar-nav) {
      background: transparent;
      border: none;
      border-radius: 0;
      padding: var(--space-2) 0;
      box-shadow: none;
    }

    .docs-article {
      overflow-wrap: break-word;
    }

    /* The cap sits on the article's flow CHILDREN, not on .article-content itself,
       and that is the whole design: a child cannot be wider than a capped parent, so
       capping the wrapper would have dragged the tutorial player down with the text.
       The player and the cheat-sheet card grid are payloads, not prose -- the layout
       already widens their whole page for them (see the two :has() rules above) --
       so they opt out here and keep the full column while the words around them do
       not. Centred rather than start-aligned so the text sits under its own heading
       block wherever the track is wider than the measure.
       Two surfaces are excluded by ancestor, and the exclusion has to be the SELECTOR
       rather than a `--docs-prose: none` override, which was tried and is worse: the
       cap is `max-inline-size` and the browse page's own cap is `max-width`, the same
       used value under two property names, so the token version did not step aside --
       it WON at `none` and blew `.docs-browse` from its own 1152px out to 1393px.
       The browse page is an index, not prose (uncapped, its single slot child is
       `.docs-browse`), and the CLI-reference embed is an iframe up to 1200px whose
       whole purpose is to use the space it was given.
       The breadcrumb, the fallback notice and the title block are capped with the same
       measure because they are the same column of reading: capping only .article-content
       left an H1 starting 110px to the LEFT of the first paragraph under it. */
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .article-content > :global(*),
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .docs-article > :global(.breadcrumb),
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .docs-article > .fallback-notice,
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .docs-article > .article-header {
      max-inline-size: var(--docs-prose);
      margin-inline: auto;
    }

    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .article-content > :global(.cs-cards),
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .article-content > :global(.print-page-header) {
      max-inline-size: none;
    }

    /* The tutorial player is an ILLUSTRATION IN THE READING FLOW, so it is capped
       rather than left at the full column width the two rules above hand to the
       cheat-sheet grid and the print header.

       Why it needed a cap at all: uncapped it rendered 765px at 1440 and 1245px at
       1920 above 544px-wide text in the same column, so the prose used 43.7% of its
       own column while the player used 100%. Watching it properly is what the player's
       own fullscreen button is for -- `.tutorial-video-container` is emitted by
       src/plugins/remark-tutorial-embed.ts and hydrated into TutorialVideoPlayer.tsx,
       whose Plyr control list carries `fullscreen` (the <video> itself has NO `controls`
       attribute; that is the OTHER embed, remark-video-embed.ts, which builds
       `.video-container`). So the inline copy has no reason to out-shout the words it
       illustrates.

       The formula, and the invariant it holds BY CONSTRUCTION rather than by
       arithmetic coincidence at the two widths somebody measured:
         960px  ceiling  -- past this a 16:9 render is taller than most viewports.
         80%             -- the player still reads as the wider element on a wide column.
         --docs-prose    -- and it is NEVER narrower than the paragraph above it.

       max-inline-size, not `width`. Written as `width` the formula is a floor as well
       as a ceiling, so on a 359px mobile column it computed 544px (the prose token) and
       pushed the document 162px wider than the viewport -- measured at 390x844, not
       assumed. As a max it simply stops applying once the column is narrower than the
       cap, which is the behaviour every other measure rule in this block already has. */
    .docs-shell:not(.docs-shell-browse):not(.docs-shell-embed) .article-content > :global(.tutorial-video-container) {
      max-inline-size: min(960px, max(80%, var(--docs-prose)));
      margin-inline: auto;
    }

    /* Fallback Notice */
    .fallback-notice {
      display: flex;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5);
      margin: var(--space-6) 0;
      background-color: var(--color-info-bg);
      border-inline-start: 4px solid var(--color-info-border);
      border-radius: var(--radius-sm);
      color: var(--color-info-text, #1565c0);
    }

    .fallback-notice-icon {
      font-size: var(--font-size-2xl);
      line-height: var(--leading-none);
      flex-shrink: 0;
    }

    .fallback-notice-content {
      flex: 1;
    }

    .fallback-notice-title {
      display: block;
      font-size: var(--font-size-base);
      margin-bottom: var(--space-1);
      color: var(--color-info-text, #0d47a1);
      font-weight: var(--font-weight-semibold);
    }

    .fallback-notice-message {
      margin: 0;
      font-size: var(--font-size-sm);
      line-height: var(--leading-normal);
      color: var(--color-info-text, #1565c0);
    }

    .article-header {
      margin-bottom: var(--space-8);
    }

    /* The per-document illustration. Sized to the reading measure rather than to the
       column, because .article-header is already capped at --docs-prose by the rule
       above and the picture belongs to the same column of reading as the title under it.

       aspect-ratio alongside the intrinsic width/height attributes on purpose: the
       attributes reserve the box before the file lands, the ratio keeps it reserved if a
       future thumbnail is authored at a different intrinsic size. */
    .docs-article-thumb {
      display: block;
      inline-size: 100%;
      block-size: auto;
      aspect-ratio: 320 / 120;
      border-radius: var(--radius-md);
    }

    /* Dark theme, and this is the SECOND copy of this filter: docs-browse.css carries the
       first, for the same artwork on the browse card, and that sheet is loaded ONLY by the
       browse page. An `<img>`-referenced SVG is an isolated document -- it cannot see
       --docs-hue, currentColor or :root[data-theme] -- so each of the 79 files carries its
       category's colours as literal hex, and inverting plus rotating the hue 180deg lands
       back on the original hue at inverted lightness. Untreated, the light artwork renders
       as a glaring panel on the #0f0f10 docs page. If the trim values change, change them
       in BOTH places; there is no third. */
    :global([data-theme='dark']) .docs-article-thumb {
      filter: invert(1) hue-rotate(180deg) brightness(0.82) saturate(1.15);
    }

    .article-header-main {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .article-title {
      font-size: var(--font-size-3xl);
      line-height: var(--leading-tight);
      margin: var(--space-4) 0;
      color: var(--color-text);
    }

    /* The Copy-as-Markdown button and its menu moved to DocsPageActions.astro, and
       their styles went WITH the markup: this block is component-scoped, so rules left
       here would match nothing once the element renders in a child component. */

    .article-description {
      font-size: var(--font-size-lg);
      color: var(--color-text-secondary);
      margin: var(--space-4) 0;
    }

    .article-content {
      line-height: var(--leading-loose);
      font-size: var(--font-size-base);
    }

    /* The nested TOC. New names on purpose: .toc-list/.toc-item/.toc-link come from
       sidebar-shared.css, which the BLOG also loads, so restyling those would reach
       every blog post. These rules only touch the branch structure this layout adds. */
    .toc-row {
      display: flex;
      align-items: center;
      gap: var(--space-1);
    }

    .toc-row .toc-link {
      flex: 1;
    }

    .toc-toggle {
      display: inline-flex;
      align-items: center;
      padding: var(--space-1);
      border: none;
      background: none;
      color: var(--color-text-muted);
      cursor: pointer;
    }

    .toc-toggle:hover {
      color: var(--color-text);
    }

    .toc-toggle svg {
      transition: transform var(--transition-duration-fast) var(--ease-standard);
    }

    .toc-toggle[aria-expanded='false'] svg {
      transform: rotate(-90deg);
    }

    .toc-sublist {
      /* list-style/margin/padding come from .sidebar-base .sidebar-list */
    }

    .toc-branch[data-expanded='false'] > .toc-sublist {
      display: none;
    }

    /* A collapsed branch that CONTAINS the active heading keeps the reader's place
       visible on its top row. Highlight only: the spy never expands anything. */
    .toc-branch.has-active[data-expanded='false'] > .toc-row > .toc-link {
      color: var(--color-primary);
    }

    /* Right Sidebar - TOC (uses shared styles from sidebar-shared.css) */
    .toc-sidebar {
      /* All base styles inherited from sidebar-base */
    }

    /* Image and caption styles (docs-specific) */
    .article-content :global(p:has(img)) {
      text-align: center;
      margin: var(--space-6) 0 var(--space-8) 0;
    }

    .article-content :global(img) {
      max-width: 100%;
      height: auto;
      border-radius: var(--radius-md);
      margin: 0 auto;
      display: block;
    }

    /* Figure captions - em elements that follow images in the same paragraph */
    .article-content :global(p:has(img) em) {
      display: block;
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      margin-top: var(--space-3);
      font-style: italic;
      line-height: var(--leading-normal);
    }

    /* Video container and placeholder styles (docs-specific) */
    .article-content :global(.video-container) {
      text-align: center;
      margin: var(--space-6) 0 var(--space-8) 0;
    }

    .article-content :global(.video-container video) {
      width: 100%;
      max-width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md);
      display: block;
      margin: 0 auto;
      background-color: #000;
    }

    .article-content :global(.video-placeholder) {
      width: 100%;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md);
      background-color: var(--color-bg-light);
      border: 2px dashed var(--color-border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-3);
      margin: 0 auto;
    }

    .article-content :global(.video-placeholder-icon) {
      width: 4rem;
      height: 4rem;
      border-radius: 50%;
      background-color: var(--color-border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-secondary);
    }

    .article-content :global(.video-placeholder-icon svg) {
      width: 2rem;
      height: 2rem;
      margin-inline-start: 0.15rem;
    }

    .article-content :global(.video-placeholder-text) {
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      font-weight: var(--font-weight-semibold);
    }

    .article-content :global(.video-container em) {
      display: block;
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
      margin-top: var(--space-3);
      font-style: italic;
      line-height: var(--leading-normal);
    }

    /* Terminal player styles are centralized in public/styles/main.css to keep
       docs and homepage behavior identical. */

    .article-content :global(.cli-ref-links) {
      margin-top: calc(var(--space-2) * -1);
      margin-bottom: var(--space-5);
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }

    .article-content :global(.cli-ref-links-label) {
      font-weight: var(--font-weight-semibold);
      color: var(--color-text);
      margin-inline-end: var(--space-2);
    }

    .article-content :global(.cli-ref-links a) {
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    /* Per-code-block copy control. Logical properties throughout: the control
       it replaced used `right: 0` with `padding-right`, so under dir=rtl it sat
       on top of the text it was meant to sit beside. */
    .article-content :global(pre) {
      position: relative;
    }

    /* PER-LINE COPY. The line span becomes a block and a positioning context so
       the control can sit at its inline-end: Shiki emits `.line` as an inline
       span, which cannot host an absolutely-positioned child. Logical
       properties throughout, so /ar mirrors with no extra rules. */
    .article-content :global(pre.has-line-copy .line-copyable) {
      display: block;
      position: relative;
      padding-inline-end: 2rem;
    }

    .article-content :global(pre .line-copy) {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 0;
      transform: translateY(-50%);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      inline-size: 1.5rem;
      block-size: 1.5rem;
      padding: 0;
      border: 0;
      border-radius: var(--radius-sm);
      background: transparent;
      color: inherit;
      opacity: 0;
      cursor: pointer;
      transition: opacity var(--transition-duration-fast) var(--ease-standard);
    }

    /* Revealed on hover of the LINE, and permanently once the control takes
       focus. Hiding by opacity keeps it in the tab order deliberately: a copy
       affordance a keyboard user cannot reach is not an affordance. */
    .article-content :global(pre.has-line-copy .line-copyable:hover .line-copy),
    .article-content :global(pre .line-copy:focus-visible) {
      opacity: 0.75;
    }

    .article-content :global(pre .line-copy:hover),
    .article-content :global(pre .line-copy.copied) {
      opacity: 1;
    }

    .article-content :global(pre .code-copy) {
      position: absolute;
      inset-block-start: var(--space-2);
      inset-inline-end: var(--space-2);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.75rem;
      height: 1.75rem;
      padding: 0;
      border: 0;
      border-radius: var(--radius-sm);
      background: transparent;
      color: rgba(255, 255, 255, var(--opacity-65));
      cursor: pointer;
      opacity: 0;
      transition: opacity var(--transition-duration-base) var(--ease-standard), color var(--transition-duration-base) var(--ease-standard);
    }

    .article-content :global(pre:hover .code-copy),
    .article-content :global(pre .code-copy:focus-visible) {
      opacity: 1;
    }

    .article-content :global(pre .code-copy:hover) {
      color: white;
      background: rgba(255, 255, 255, var(--opacity-10));
    }

    .article-content :global(pre .code-copy.copied) {
      opacity: 1;
      color: var(--color-success, #7fa03f);
    }

    /* Coarse pointers have no hover, so the control is always visible there. */
    @media (hover: none) {
      .article-content :global(pre .code-copy) {
        opacity: 1;
      }
    }

    /* Responsive Design - TOC sidebar is hidden on tablets/phones (handled in sidebar-shared.css) */
    @media (max-width: 75rem) {
      /* 1200px. The TOC rail is display:none here, so the grid drops to nav +
         article and the article takes the whole remainder: there is no room
         left to dock anything against. */
      .docs-layout {
        grid-template-columns: var(--docs-rail-nav) minmax(0, 1fr);
      }

      /* The browse page has no rail to make room for, at any width. Without this it
         inherited the nav track anyway and, having nothing to put in it, auto-placed
         the whole card grid INTO it: measured at 1100, `.docs-browse` came out 250px
         wide. The breakpoint below is safe only because one track is one track. */
      .docs-shell-browse .docs-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      /* Two tracks now, so hand placement back to auto: rail then article, in
         DOM order. */
      .docs-layout > :global(.docs-sidebar),
      .docs-layout > .docs-content,
      .docs-layout > .toc-sidebar {
        grid-column: auto;
      }
    }

    @media (max-width: 48rem) {
      .docs-shell {
        padding: calc(var(--nav-top-offset) + var(--space-3)) var(--space-2) var(--space-4) var(--space-2);
      }

      /* The tab strip and the tools wrap onto two rows rather than the tabs
         being squeezed to nothing beside them. */
      .docs-header-row {
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2);
        padding-block: var(--space-2);
      }

      .docs-search-trigger {
        max-inline-size: none;
      }

      /* Icon only: the row is already two lines here and the glyph plus caret
         says everything the word did. aria-label on the trigger keeps the
         accessible name. */
      .docs-theme-trigger-text {
        display: none;
      }

      /* 768px */
      .docs-layout {
        grid-template-columns: minmax(0, 1fr);
      }

      /* One track, and .docs-sidebar-toggle becomes a grid item here. Auto for
         every child keeps the toggle first in DOM order; pinning the other
         three to column 1 while the toggle stayed auto placed it in the LAST
         row instead of the first. */
      .docs-layout > :global(.docs-sidebar),
      .docs-layout > .docs-content,
      .docs-layout > .toc-sidebar {
        grid-column: auto;
      }

      .article-title {
        font-size: var(--font-size-2xl);
      }

      .article-header-main {
        flex-direction: column;
      }

      .docs-sidebar-toggle {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        width: 100%;
        padding: var(--space-3);
        background: var(--color-bg-alt, var(--color-bg));
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        color: var(--color-text);
        font-size: var(--font-size-sm);
        font-weight: 500;
        font-family: inherit;
        cursor: pointer;
        margin-bottom: var(--space-4);
        transition: background-color var(--transition-duration-fast) var(--ease-standard);
      }

      .docs-sidebar-toggle:hover {
        background: var(--color-hover, var(--color-bg-alt));
      }

      .docs-sidebar-toggle:focus-visible {
        outline: 2px solid var(--color-text);
        outline-offset: 2px;
      }

      .docs-sidebar-toggle[aria-expanded="true"] {
        margin-bottom: 0;
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        border-bottom: none;
      }

      .docs-layout :global(#docs-sidebar-nav) {
        display: none;
      }

      .docs-layout :global(#docs-sidebar-nav.docs-sidebar-visible) {
        display: block;
        border: 1px solid var(--color-border);
        border-top: none;
        border-radius: 0 0 var(--radius-sm) var(--radius-sm);
        padding: var(--space-3);
        margin-bottom: var(--space-4);
        background: var(--color-bg-alt, var(--color-bg));
      }

    }
  </style>

  <LlmsInlineScript page="docs" />

  <script is:inline>
  (function() {
    function initDocsSidebarToggle() {
      var btn = document.querySelector('.docs-sidebar-toggle');
      var sidebar = document.getElementById('docs-sidebar-nav');
      if (!btn || !sidebar) return;
      if (btn.dataset.toggleInit === 'true') return;
      btn.dataset.toggleInit = 'true';

      btn.addEventListener('click', function() {
        var expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        sidebar.classList.toggle('docs-sidebar-visible', !expanded);
      });
    }

    document.addEventListener('astro:page-load', initDocsSidebarToggle);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDocsSidebarToggle);
    } else {
      initDocsSidebarToggle();
    }
  })();
  </script>
</BaseLayout>
