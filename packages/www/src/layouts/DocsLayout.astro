---
import BaseLayout from './BaseLayout.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import DocsTopTabs from '../components/DocsTopTabs.astro';
import DocsSearchMount from '../components/DocsSearchMount';
import Breadcrumb from '../components/Breadcrumb.astro';
import LlmsInlineScript from '../components/LlmsInlineScript.astro';
import StructuredData from '../components/StructuredData.astro';
import type { Language } from '../i18n/types';
import { createTranslator } from '../i18n/utils';
import { generateTOCFromHtml } from '../utils/sidebar-behavior';
import '../styles/sidebar-shared.css';
import '../styles/article-content.css';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    category?: string;
  };
  url: string;
  currentLang: Language;
  showFallbackNotice?: boolean;
  variant?: 'article' | 'index';
  tocItems?: Array<{ id: string; title: string; level: number }>;
  tocTrackingSelector?: string;
  showTOC?: boolean;
}

const {
  frontmatter,
  url,
  currentLang,
  showFallbackNotice,
  variant = 'article',
  tocItems,
  tocTrackingSelector = '.article-content h2, .article-content h3, .article-content h4',
  showTOC = true
} = Astro.props as Props;

// D-5: the docs search returns Documentation hits only; the site-wide Cmd/Ctrl+K
// modal keeps returning both. These are the `category` values the generated
// search index actually carries ("Documentation" and "Blog"), not a display
// label, so the filter is an exact match rather than a heuristic.
const DOCS_SEARCH_CATEGORIES = ['Documentation'] as const;

// Extract slug for markdown alternate link
const slugMatch = url.match(/\/docs\/([^/]+)\/?$/);
const docSlug = slugMatch ? slugMatch[1] : '';
const mdUrl = docSlug ? `/${currentLang}/docs/${docSlug}.md` : '';

// Generate breadcrumbs
const { t } = createTranslator(currentLang);
const breadcrumbItems = variant === 'article'
  ? [
      {
        name: t('navigation.home'),
        url: `/${currentLang}`
      },
      {
        name: t('navigation.docs'),
        url: `/${currentLang}/docs`
      },
      {
        name: frontmatter.title,
        url: url
      }
    ]
  : [];

// Generate table of contents from rendered HTML using shared utility
const tocFromContent = generateTOCFromHtml(await Astro.slots.render('default'));
const toc = tocItems ?? tocFromContent;
const shouldTrackTOC = !tocItems && toc.length > 0;
// Whether the TOC rail is actually RENDERED. The grid reserved its 250px track
// unconditionally, so the browse page (showTOC={false}) laid out as
// `250px 0px 765px 0px 250px` at 1440 and parked a quarter of the viewport, empty, to
// the right of content that had nothing docked against it.
const hasTOC = showTOC && toc.length > 0;
// Hoisted out of the `class:list` below rather than written inline as
// `variant === 'index' && '...'`: check:ci-css-dom-refs harvests every string literal in a
// class position, so the comparison's `'index'` was reported as a rendered-but-unstyled
// class. The flag reads better anyway.
const isBrowse = variant === 'index';

// A long TOC is rendered flat and simply scrolls. The grouping that used to be
// computed here fed a collapsible rail whose only job was to fit a long list
// into a rail with a fixed height -- and it did that by opening one group and
// closing another on every scroll-spy transition, so the rail's own height
// changed under the reader's cursor while they scrolled. The rail is now
// max-height, so the list needs no help fitting.
---

<BaseLayout
  title={`${frontmatter.title} | Rediacc`}
  description={frontmatter.description}
  lang={currentLang}
>
  {mdUrl && <link slot="head" rel="alternate" type="text/markdown" href={mdUrl} />}
  {/* `docs-shell-browse` is TOTAL -- it replaces the whole track list with one track --
      so the no-TOC modifier must not ride along beside it. Both set `--docs-tracks` at
      the same specificity, and the no-TOC rule is further down the sheet, so a browse
      page carrying both classes laid out as `250px 123.5px 800px 123.5px` and
      auto-placed its content into the 250px rail track. */}
  <div class:list={['docs-shell', !hasTOC && !isBrowse && 'docs-shell-no-toc', isBrowse && 'docs-shell-browse']}>
    <div class="docs-shell-top">
      <div class="docs-header-row">
        {/* Article pages only. On the browse page the same six categories render
            immediately below as filter pills that actually DRIVE the filter, so a tab
            row there is a second control for one axis whose only power is to jump to
            an anchor. On an article page it is the real between-section navigation. */}
        {!isBrowse && (
          <DocsTopTabs
            currentLang={currentLang}
            currentCategory={frontmatter.category}
            variant={variant}
          />
        )}
        <div class="docs-header-tools">
          {/* Server-rendered trigger, not part of the React island. The island
              below is headless: it carries the modal and nothing else, so the
              control the reader sees is present in the HTML and works the
              moment the island hydrates, with no layout shift on hydration. */}
          <button
            type="button"
            class="docs-search-trigger"
            data-docs-search-open
            aria-label={t('documentation.searchDocs')}
          >
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="6" />
              <path d="M12.5 12.5L17 17" />
            </svg>
            <span class="docs-search-trigger-text">{t('pages.docs.searchPlaceholder')}</span>
          </button>

          {/* Light / Dark / Auto. The popover contract is the one LanguageMenu
              established (anchored to its own button, click-outside, Escape
              returns focus to the trigger, roving arrow keys), implemented
              inline rather than as a second React island: three radio options
              do not need a hydration boundary, and the site's standing problem
              is shipped JavaScript. */}
          <div class="docs-theme">
            <button
              type="button"
              class="docs-theme-trigger"
              id="docs-theme-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="docs-theme-menu"
              aria-label={t('documentation.theme.label', 'Theme')}
            >
              <svg class="docs-theme-icon-light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
              </svg>
              <svg class="docs-theme-icon-dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
              </svg>
              <span class="docs-theme-trigger-text">{t('documentation.theme.label', 'Theme')}</span>
              <svg class="docs-theme-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="docs-theme-menu" id="docs-theme-menu" role="menu" aria-labelledby="docs-theme-trigger" hidden>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="light" aria-checked="false">{t('documentation.theme.light', 'Light')}</button>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="dark" aria-checked="false">{t('documentation.theme.dark', 'Dark')}</button>
              <button type="button" role="menuitemradio" class="docs-theme-option" data-theme-choice="auto" aria-checked="false">{t('documentation.theme.auto', 'Auto')}</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="docs-layout">
      {/* The article navigation tree, and the control that opens it on a phone, are
          ARTICLE furniture. The browse page is the index of that tree: rendering the
          tree beside it duplicated the page's own job and squeezed the cards into a
          middle column. Both the rail and its toggle are omitted there, which leaves
          the browse page a single full-width slot to lay its filter rail out in.
          The toggle script below reads both elements and returns early when either is
          missing, so nothing is left dangling. */}
      {!isBrowse && (
        <button class="docs-sidebar-toggle" type="button" aria-expanded="false" aria-controls="docs-sidebar-nav">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <span>{t('pages.docs.title')}</span>
        </button>
      )}
      {!isBrowse && (
        <DocsSidebar
          currentLang={currentLang}
          currentUrl={url}
          visibleCategory={frontmatter.category}
        />
      )}

      {/* A <div>, not a <main>: BaseLayout.astro:321 already emits the page's one
          <main id="main-content"> and this sits inside it. Nesting a second landmark
          shipped on 1,120 of 1,842 built pages and is what axe reports as
          landmark-no-duplicate-main / landmark-main-is-top-level / landmark-unique. */}
      <div class="docs-content">
        <article class="docs-article">
          {variant === 'article' && <Breadcrumb items={breadcrumbItems} />}
          {variant === 'article' && (
            <StructuredData
              type="techarticle"
              data={{
                title: frontmatter.title,
                description: frontmatter.description,
                category: frontmatter.category,
                url: `${url}`,
                language: currentLang,
              }}
            />
          )}

          {variant === 'article' && showFallbackNotice && (
            <div class="fallback-notice" role="alert">
              <div class="fallback-notice-icon">ℹ️</div>
              <div class="fallback-notice-content">
                <strong class="fallback-notice-title">{t('pages.docs.fallbackNotice.title')}</strong>
                <p class="fallback-notice-message">{t('pages.docs.fallbackNotice.message')}</p>
              </div>
            </div>
          )}

          {variant === 'article' && (
            <header class="article-header">
              <div class="article-header-main">
                <h1 class="article-title">{frontmatter.title}</h1>
                {mdUrl && (
                  <button
                    type="button"
                    class="docs-copy-page-md"
                    data-md-href={mdUrl}
                    aria-label={t('documentation.copyFullPageAriaLabel')}
                    title={t('documentation.copyAsMarkdown')}
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" />
                      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <span class="copy-md-label">{t('documentation.copyAsMarkdown')}</span>
                  </button>
                )}
              </div>

              {frontmatter.description && (
                <p class="article-description">{frontmatter.description}</p>
              )}
            </header>
          )}

          <div class="article-content">
            <slot />
          </div>
        </article>
      </div>

      {hasTOC && (
        <aside class="sidebar-base sidebar-toc toc-sidebar" data-track={shouldTrackTOC ? 'true' : 'false'} data-selector={tocTrackingSelector}>
          <nav class="sidebar-nav sidebar-nav-with-accent toc-nav" role="navigation" aria-label={t('common.aria.tableOfContents')}>
            <h3 class="sidebar-title toc-title">{t('pages.docs.tableOfContents')}</h3>
            <ul class="sidebar-list toc-list">
              {toc.map(heading => (
                <li class={`sidebar-item toc-item toc-level-${heading.level}`}>
                  <a href={`#${heading.id}`} class="sidebar-link toc-link">{heading.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>

  {/* Headless: it renders the modal and nothing else. Kept OUTSIDE .docs-shell
      so the island wrapper element is never a child of a layout container that
      might count it. */}
  <DocsSearchMount client:idle categories={DOCS_SEARCH_CATEGORIES} scope="docs" />

  <div id="docs-i18n" hidden
    data-copied={t('documentation.copied')}
    data-copy-code={t('documentation.copyCode')}
  ></div>

  <script is:inline>
    // Apply embed mode for iframe preview pages via runtime query param detection.
    (function() {
      function applyCliRefEmbedMode() {
        const docsShell = document.querySelector('.docs-shell');
        if (!docsShell) return;

        const search = window.location.search;
        const isEmbed = new URLSearchParams(search).get('embed') === 'cli-ref';
        docsShell.classList.toggle('docs-shell-embed', isEmbed);
      }

      document.addEventListener('astro:page-load', applyCliRefEmbedMode);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyCliRefEmbedMode);
      } else {
        applyCliRefEmbedMode();
      }
    })();
  </script>

  <script is:inline>
    // Copy full page as markdown button
    (function() {
      function initCopyMd() {
        document.querySelectorAll('.docs-copy-page-md').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var href = btn.getAttribute('data-md-href');
            if (!href) return;
            fetch(href)
              .then(function(r) { return r.text(); })
              .then(function(text) {
                return navigator.clipboard.writeText(text);
              })
              .then(function() {
                var label = btn.querySelector('.copy-md-label');
                var orig = label ? label.textContent : '';
                var i18nEl = document.getElementById('docs-i18n');
                var copiedText = i18nEl && i18nEl.dataset.copied || 'Copied!';
                btn.classList.add('copied');
                if (label) label.textContent = copiedText;
                setTimeout(function() {
                  btn.classList.remove('copied');
                  if (label) label.textContent = orig;
                }, 2000);
              })
              .catch(function() {});
          });
        });
      }
      document.addEventListener('astro:page-load', initCopyMd);
      if (document.readyState !== 'loading') initCopyMd();
      else document.addEventListener('DOMContentLoaded', initCopyMd);
    })();
  </script>

  <script is:inline>
    // TOC scroll-spy.
    //
    // No `window.rediaccTOCInitialized` guard. That guard made init run exactly
    // once per PAGE LOAD, which is once per browsing session under Astro view
    // transitions: after a client-side navigation the observer was still
    // watching the previous document's heading nodes, so the TOC of the page
    // you were reading tracked the page you had left. The lifecycle is instead
    // a module-scoped observer that disconnects at the top of every init.
    (function() {
      var observer = null;
      // Ids of every heading currently inside the spy band, so the active link
      // can be the FIRST one in document order. The previous version took
      // whichever entry the callback happened to see last, which on a fast
      // scroll -- or on any single callback carrying several entries -- could
      // activate a heading below the one being read.
      var visible = new Set();
      var order = [];

      /* Bring a rail's active link into view WITHOUT Element.scrollIntoView.
         scrollIntoView walks every scrollable ancestor up to and including the
         document, so nudging a link inside the 250px rail also scrolled the
         article out from under the reader. Arithmetic on the rail's own
         scrollTop touches nothing else. Guarded on the rail actually being a
         scroll container: with a max-height rail, a short TOC is not one, and
         scrolling it is both pointless and a no-op we should not pay for. */
      function revealInRail(nav, el) {
        if (!nav || !el) return;
        if (nav.scrollHeight <= nav.clientHeight) return;
        var navBox = nav.getBoundingClientRect();
        var elBox = el.getBoundingClientRect();
        var margin = 24;
        if (elBox.top < navBox.top + margin) {
          nav.scrollTop -= (navBox.top + margin) - elBox.top;
        } else if (elBox.bottom > navBox.bottom - margin) {
          nav.scrollTop += elBox.bottom - (navBox.bottom - margin);
        }
      }

      function initTOCActiveState() {
        var container = document.querySelector('.toc-sidebar');
        if (!container) return; // No TOC sidebar on this page

        if (container.getAttribute('data-track') !== 'true') return;

        var selector = container.getAttribute('data-selector') || '.article-content h2, .article-content h3, .article-content h4';
        var headings = Array.prototype.slice.call(document.querySelectorAll(selector));
        if (headings.length === 0) return; // No headings to track

        var nav = container.querySelector('.sidebar-nav');
        order = headings.map(function(h) { return h.id; }).filter(Boolean);
        visible = new Set();

        function paint() {
          var activeId = null;
          for (var i = 0; i < order.length; i++) {
            if (visible.has(order[i])) { activeId = order[i]; break; }
          }
          if (!activeId) return;
          var link = container.querySelector('a[href="#' + CSS.escape(activeId) + '"]');
          if (!link || link.classList.contains('active')) return;
          container.querySelectorAll('a.active').forEach(function(a) {
            a.classList.remove('active');
          });
          link.classList.add('active');
          revealInRail(nav, link);
        }

        /* The band's top edge is the site's one anchor offset, read from the
           computed scroll-padding-top rather than hardcoded. A literal is wrong
           in one of the two announcement-bar states, because
           --announcement-bar-height is written at runtime by AnnouncementBar. */
        var pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop);
        if (!isFinite(pad)) pad = 0;

        observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            var id = entry.target.id;
            if (!id) return;
            if (entry.isIntersecting) visible.add(id);
            else visible.delete(id);
          });
          paint();
        }, {
          rootMargin: '-' + Math.round(pad) + 'px 0px -66% 0px'
        });

        headings.forEach(function(heading) { observer.observe(heading); });
      }

      function init() {
        if (observer) { observer.disconnect(); observer = null; }
        initTOCActiveState();
      }

      // Astro View Transitions support
      document.addEventListener('astro:page-load', init);

      // Initial load
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

  <script is:inline>
    // Light / Dark / Auto.
    //
    // The pre-paint block in BaseLayout owns the RULE (an explicit
    // localStorage['theme'] wins; otherwise the clock plus the OS preference).
    // This control only writes that key, so Auto is `removeItem`, not a third
    // stored value: a stored "auto" would be a second source of truth for the
    // same decision. The class flip is repeated here because the pre-paint
    // block runs once, before this element exists.
    (function() {
      var STORE = 'theme';
      var menuOpen = false;

      function stored() {
        try {
          var v = localStorage.getItem(STORE);
          return v === 'dark' || v === 'light' ? v : null;
        } catch (e) {
          return null;
        }
      }

      function resolve() {
        var explicit = stored();
        if (explicit) return explicit;
        var hour = new Date().getHours();
        if (hour >= 20 || hour < 6) return 'dark';
        return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      }

      function applyTheme() {
        var theme = resolve();
        document.documentElement.dataset.theme = theme;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.content = theme === 'dark' ? '#0f0f10' : '#4a7c3f';
      }

      function syncChecked(root) {
        var current = stored() || 'auto';
        root.querySelectorAll('.docs-theme-option').forEach(function(opt) {
          opt.setAttribute('aria-checked', String(opt.dataset.themeChoice === current));
        });
      }

      /* The two document-level listeners are registered ONCE, here, and read the
         live control through `current`. Registering them inside init would add
         a pair per initialisation and leave every old pair holding a reference
         to a control that is no longer in the document -- a slower version of
         exactly the lifecycle bug this wave removes. */
      var current = null;

      function setOpen(next) {
        if (!current) return;
        menuOpen = next;
        current.menu.hidden = !next;
        current.trigger.setAttribute('aria-expanded', String(next));
      }

      function close(returnFocus) {
        var trigger = current && current.trigger;
        setOpen(false);
        if (returnFocus && trigger) trigger.focus();
      }

      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && menuOpen) close(true);
      });

      document.addEventListener('mousedown', function(event) {
        if (menuOpen && current && !current.root.contains(event.target)) close(false);
      });

      function initThemeControl() {
        var root = document.querySelector('.docs-theme');
        if (!root) { current = null; return; }

        var trigger = root.querySelector('.docs-theme-trigger');
        var menu = root.querySelector('.docs-theme-menu');
        if (!trigger || !menu) { current = null; return; }
        var options = Array.prototype.slice.call(menu.querySelectorAll('.docs-theme-option'));
        current = { root: root, trigger: trigger, menu: menu, options: options };
        menuOpen = !menu.hidden;

        syncChecked(root);
        if (root.dataset.themeInit === 'true') return;
        root.dataset.themeInit = 'true';

        trigger.addEventListener('click', function() {
          setOpen(!menuOpen);
          if (menuOpen) {
            syncChecked(root);
            var checked = options.find(function(o) { return o.getAttribute('aria-checked') === 'true'; });
            (checked || options[0]).focus();
          }
        });

        options.forEach(function(opt, index) {
          opt.addEventListener('click', function() {
            var choice = opt.dataset.themeChoice;
            try {
              if (choice === 'auto') localStorage.removeItem(STORE);
              else localStorage.setItem(STORE, choice);
            } catch (e) { /* private mode: the choice just does not persist */ }
            applyTheme();
            syncChecked(root);
            close(true);
          });
          opt.addEventListener('keydown', function(event) {
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              options[(index + 1) % options.length].focus();
            } else if (event.key === 'ArrowUp') {
              event.preventDefault();
              options[(index - 1 + options.length) % options.length].focus();
            } else if (event.key === 'Home') {
              event.preventDefault();
              options[0].focus();
            } else if (event.key === 'End') {
              event.preventDefault();
              options[options.length - 1].focus();
            }
          });
        });
      }

      document.addEventListener('astro:page-load', initThemeControl);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeControl);
      } else {
        initThemeControl();
      }
    })();
  </script>

  <script is:inline>
    /* The docs search trigger is delegated on `document`, not bound to the
       button. Delegation survives an Astro view transition replacing the header
       without any rebinding, which is exactly the failure mode the set-once
       guards elsewhere in this file used to create. */
    (function() {
      document.addEventListener('click', function(event) {
        var trigger = event.target instanceof Element
          ? event.target.closest('[data-docs-search-open]')
          : null;
        if (!trigger) return;
        event.preventDefault();
        document.dispatchEvent(new CustomEvent('docs-search:open'));
      });
    })();
  </script>

  <script is:inline>
    // One copy button per code block.
    //
    // This replaces a 336-line script that injected a 141px split button into
    // every h2 and h3 -- including a whole HTML-to-Markdown converter shipped to
    // the browser to serve one menu item. That control was permanently visible,
    // it left every heading's accessible name reading
    // "IntroductionCopy sectionvCopy section link...", and in Arabic it covered
    // the first 40px of the heading text. Deep links still work: the ids come
    // from remark, not from that script.
    (function() {
      function initCodeCopy() {
        var i18n = document.getElementById('docs-i18n');
        var copyLabel = (i18n && i18n.dataset.copyCode) || 'Copy code';
        var copiedLabel = (i18n && i18n.dataset.copied) || 'Copied!';

        document.querySelectorAll('.article-content pre').forEach(function(pre) {
          if (pre.dataset.copyBound === 'true') return;
          pre.dataset.copyBound = 'true';

          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.setAttribute('aria-label', copyLabel);
          btn.title = copyLabel;
