---
// The `/[lang]/solutions` index is gone: the constellation it existed to hold is
// on the homepage now, under `#solutions`. This 301 stays so the one URL that
// was ever published outside the site keeps landing on the figure rather than on
// a 404.
import { DEFAULT_LANGUAGE } from '../i18n/language-utils';

return Astro.redirect(`/${DEFAULT_LANGUAGE}#solutions`, 301);
---
