---
import LegalDocument from '../../components/LegalDocument.astro';
import { getLanguagePaths } from '../../i18n/language-utils';
import { termsAt } from '@rediacc/shared/legal';
import type { Language } from '../../i18n/types';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Language };

// The version line is the manifest's newest declared version, so the page, the archive and
// the hash a user accepts are one value (check:ci-terms-version, check 6).
const { latest } = termsAt(new Date());
const archiveName = latest.archiveUrl.slice(latest.archiveUrl.lastIndexOf('/') + 1);

const related = [
  { page: 'privacy-policy', labelKey: 'footer.legalLinks.privacyPolicy' },
  { page: 'acceptable-use-policy', labelKey: 'footer.legalLinks.acceptableUsePolicy' },
  { page: 'refund-policy', labelKey: 'footer.legalLinks.refundPolicy' },
  { page: 'telemetry-policy', labelKey: 'footer.legalLinks.telemetryPolicy' },
];
---

<LegalDocument lang={lang} pageKey="pages.termsOfService" related={related}>
  <p class="legal-version" slot="hero-extra" dir="ltr">
    Version {latest.version} &middot; SHA-256 <code>{latest.sha256}</code>
    &middot; <a href={latest.archiveUrl}>{archiveName}</a>
  </p>
</LegalDocument>

<style>
  .legal-version {
    margin-top: var(--space-2);
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, var(--opacity-65));
    overflow-wrap: anywhere;
  }

  .legal-version a {
    color: inherit;
    text-decoration: underline;
  }
</style>
