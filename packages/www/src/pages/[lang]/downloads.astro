---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createTranslator } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/language-utils';
import type { Language } from '../../i18n/types';
import { GITHUB_REPO } from '../../config/constants';
import { parseGitHubRelease, type ReleaseData } from '../../utils/release-parser';
import { fetchLatestRelease } from '../../utils/latest-release';
import DownloadsList from '../../components/DownloadsList';
import '../../styles/downloads-page.css';
import Sentences from '../../components/Sentences.astro';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Language };
const { t } = createTranslator(lang);

// Fetch release data at build time.
//
// This used to be a per-page fetch wrapped in a catch whose only effect was a
// DEV-gated console.error. That shipped a page reading "No releases available
// right now." from a build that exited 0, silently, in production, and it hit an
// unauthenticated GitHub endpoint once PER LOCALE (13 times per build), which is
// how it started failing intermittently in the first place.
//
// Now: one fetch per build, shared across every locale, and a production build
// FAILS rather than shipping an empty page. Dev still degrades gracefully,
// because a developer without network access should not be blocked.
const release = await fetchLatestRelease();
const releaseData: ReleaseData | null = release === null ? null : parseGitHubRelease(release, lang);

if (releaseData === null && !import.meta.env.DEV) {
  throw new Error(
    `downloads.astro: no GitHub release data for ${GITHUB_REPO}. Refusing to build a ` +
      'downloads page with no downloads on it. Set GITHUB_TOKEN if this is rate limiting.',
  );
}
---

<BaseLayout
  lang={lang}
  title={t('pages.downloads.meta.title')}
  description={t('pages.downloads.meta.description')}
  keywords={t('pages.downloads.meta.keywords')}
  ogType="website"
  structuredDataType="organization"
>
  <article class="downloads-page">
    <!-- Hero Section -->
    <section class="downloads-hero section-dark">
      <div class="downloads-hero-content">
        <h1>{t('pages.downloads.hero.title')}</h1>
        {releaseData && (
          <p class="hero-subtitle">
            {t('pages.downloads.hero.subtitle')} <strong>v{releaseData.version}</strong>
          </p>
          <p class="hero-release-date">
            {t('pages.downloads.hero.released')}: {releaseData.publishedAt}
          </p>
        )}
      </div>
    </section>

    <!-- Downloads Section -->
    <section class="downloads-content section-light">
      <div class="container">
        <DownloadsList client:visible lang={lang} releaseData={releaseData} />
      </div>
    </section>

    <!-- Auto-Update Information -->
    <section class="auto-update-section section-dark">
      <div class="container">
        <h2>{t('pages.downloads.autoUpdate.title')}</h2>
        <p class="auto-update-description"><Sentences text={t('pages.downloads.autoUpdate.description')} lang={lang} /></p>
      </div>
    </section>

    <!-- Installation Instructions -->
    <section class="installation-section section-light">
      <div class="container">
        <h2>{t('pages.downloads.installation.title')}</h2>

        <details class="installation-details">
          <summary>{t('pages.downloads.sections.cli')}</summary>
          <p><Sentences text={t('pages.downloads.installation.cli')} lang={lang} /></p>
        </details>
      </div>
    </section>

    <!-- System Requirements -->
    <section class="requirements-section section-light">
      <div class="container">
        <h2>{t('pages.downloads.requirements.title')}</h2>

        <div class="requirements-grid">
          <div class="requirement-card">
            <h3>{t('pages.downloads.platforms.windows')}</h3>
            <p>{t('pages.downloads.requirements.windows')}</p>
          </div>

          <div class="requirement-card">
            <h3>{t('pages.downloads.platforms.macos')}</h3>
            <p>{t('pages.downloads.requirements.macos')}</p>
          </div>

          <div class="requirement-card">
            <h3>{t('pages.downloads.platforms.linux')}</h3>
            <p>{t('pages.downloads.requirements.linux')}</p>
          </div>
        </div>
      </div>
    </section>
  </article>

</BaseLayout>
