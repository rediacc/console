---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createTranslator } from '../../../i18n/utils';
import { getLanguagePaths } from '../../../i18n/language-utils';
import type { Language } from '../../../i18n/types';
import { getBaseSlug } from '../../../utils/slug';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.props as { lang: Language };
const { t } = createTranslator(lang);

// Get blog posts for current language, sorted by date
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.language === lang)
  .sort(
    (a, b) =>
      new Date(b.data.publishedDate).getTime() -
      new Date(a.data.publishedDate).getTime()
  );

// ONE ordering principle: newest first, with the category carried as a tag on each
// entry. This replaced a grouping by category, which split an already short list (eight
// posts per locale) into several shorter ones and left the reader no way to see what was
// most recent. The shape is a lead story, a small featured row, then the archive.
const featuredPosts = posts.filter((post) => post.data.featured);

// The lead is the newest FEATURED post, falling back to the newest post of any kind, so
// the slot is never empty on a locale where nothing is flagged featured.
const leadPost = featuredPosts[0] ?? posts[0];
const secondaryPosts = posts.filter((post) => post !== leadPost && post.data.featured).slice(0, 3);
const restPosts = posts.filter((post) => post !== leadPost && !secondaryPosts.includes(post));

/**
 * Dates in the READER's locale.
 *
 * This used to be `lang === 'es' ? 'es-ES' : 'en-US'`, so Spanish got Spanish dates and
 * the other eleven non-English locales silently got US ones: an Arabic or Japanese reader
 * saw `Aug 18, 2026`. Our locale codes are already valid BCP-47 language subtags, so the
 * language itself is the correct argument and every locale formats natively.
 */
const formatDate = (value: string | Date): string =>
  new Date(value).toLocaleDateString(lang, { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout lang={lang} title={t('pages.blog.meta.title')} description={t('pages.blog.meta.description')} keywords={t('pages.blog.meta.keywords')}>
  <div class="blog-page">
    <header class="blog-header">
      <h1>{t('pages.blog.title')}</h1>
      <p>{t('pages.blog.subtitle')}</p>
    </header>

    {leadPost && (
      <section class="blog-lead">
        <article class="lead-card">
          <div class="card-meta">
            <span class="category">{leadPost.data.category}</span>
            <span>{formatDate(leadPost.data.publishedDate)}</span>
          </div>
          <h2><a href={`/${lang}/blog/${getBaseSlug(leadPost.slug)}`}>{leadPost.data.title}</a></h2>
          <p class="description">{leadPost.data.description}</p>
        </article>
      </section>
    )}

    {secondaryPosts.length > 0 && (
      <section class="featured-posts">
        <h2>{t('pages.blog.featured')}</h2>
        <div class="featured-grid">
          {secondaryPosts.map(post => (
            <article class="featured-card">
              <div class="card-meta">
                <span class="category">{post.data.category}</span>
                <span>{formatDate(post.data.publishedDate)}</span>
              </div>
              <h3><a href={`/${lang}/blog/${getBaseSlug(post.slug)}`}>{post.data.title}</a></h3>
              <p class="description">{post.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {restPosts.length > 0 && (
      <section class="posts-section">
        <h2>{t('pages.blog.allArticles')}</h2>
        <ul class="posts-list" role="list">
          {restPosts.map(post => (
            <li class="post-row">
              <a class="post-row-link" href={`/${lang}/blog/${getBaseSlug(post.slug)}`}>
                <span class="post-row-date">{formatDate(post.data.publishedDate)}</span>
                <span class="post-row-category">{post.data.category}</span>
                <span class="post-row-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

  </div>

  <style>
    .blog-page {
      max-width: var(--container-md);
      margin: 0 auto;
      padding: calc(var(--nav-top-offset) + var(--space-8)) var(--space-4) var(--space-8);
    }

    .blog-header {
      margin-bottom: var(--space-10);
    }

    .blog-header h1 {
      font-size: var(--font-size-4xl);
      margin-bottom: var(--space-2);
    }

    .blog-header p {
      font-size: var(--font-size-lg);
      color: var(--color-text-secondary);
    }

    /* Shared meta line: the category and the date, above the title in every shape. */
    .card-meta {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-2);
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }

    .category {
      text-transform: capitalize;
    }

    .description {
      color: var(--color-text-secondary);
      margin: 0;
    }

    /* The lead story. One item, larger type, no card chrome: it is the first thing on
       the page, so it does not need a border to say it matters. */
    .blog-lead {
      margin-bottom: var(--space-10);
      padding-bottom: var(--space-8);
      border-bottom: 1px solid var(--color-border);
    }

    .lead-card h2 {
      font-size: var(--font-size-3xl);
      margin: 0 0 var(--space-3) 0;
      text-wrap: balance;
    }

    .lead-card h2 a {
      color: var(--color-text);
      text-decoration: none;
    }

    .lead-card h2 a:hover {
      color: var(--color-brand-primary);
    }

    .featured-posts {
      margin-bottom: var(--space-12);
    }

    .featured-posts h2,
    .posts-section h2 {
      font-size: var(--font-size-xl);
      margin-bottom: var(--space-6);
    }

    .featured-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--space-6);
    }

    .featured-card h3 {
      margin: 0 0 var(--space-2) 0;
      font-size: var(--font-size-lg);
      text-wrap: balance;
    }

    .featured-card h3 a {
      color: var(--color-text);
      text-decoration: none;
    }

    .featured-card h3 a:hover {
      color: var(--color-brand-primary);
    }

    /* The archive: one row per post, scannable as a column of dates and titles. */
    .posts-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .post-row + .post-row {
      border-top: 1px solid var(--color-border-subtle);
    }

    .post-row-link {
      display: grid;
      grid-template-columns: 7.5rem 7rem 1fr;
      gap: var(--space-4);
      align-items: baseline;
      padding: var(--space-4) 0;
      color: var(--color-text);
      text-decoration: none;
    }

    .post-row-link:hover .post-row-title {
      color: var(--color-brand-primary);
    }

    .post-row-date,
    .post-row-category {
      font-size: var(--font-size-sm);
      color: var(--color-text-secondary);
    }

    .post-row-category {
      text-transform: capitalize;
    }

    .post-row-title {
      font-weight: var(--font-weight-medium);
    }

    /* Below 40rem the three columns stop being scannable and become cramped, so the row
       stacks and the meta line sits above the title, matching the card shapes above. */
    @media (max-width: 40rem) {
      .post-row-link {
        grid-template-columns: 1fr;
        gap: var(--space-1);
      }

      .post-row-title {
        order: -1;
      }
    }
  </style>
</BaseLayout>
