---
import LegalDocument from '../../components/LegalDocument.astro';
import { getLanguagePaths } from '../../i18n/language-utils';
import type { Language } from '../../i18n/types';

export const getStaticPaths = getLanguagePaths;

const { lang } = Astro.params as { lang: Language };

const related = [
  { page: 'terms-of-service', labelKey: 'footer.legalLinks.termsOfService' },
  { page: 'service-level-agreement', labelKey: 'footer.legalLinks.serviceLevelAgreement' },
  { page: 'data-processing-agreement', labelKey: 'footer.legalLinks.dataProcessingAgreement' },
];
---

<LegalDocument lang={lang} pageKey="pages.enterpriseLicense" related={related} />
