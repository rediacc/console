{
  "name": "@rediacc/www",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check:cta-bolt": "node scripts/check-cta-bolt-uniqueness.js",
    "dev": "astro dev",
    "generate:cli-docs": "npm run export:command-tree -w @rediacc/cli && node scripts/generate-cli-docs.js",
    "i18n:generate-client": "tsx scripts/generate-client-i18n.ts",
    "i18n:check-client": "tsx scripts/check-client-i18n-freshness.ts --selftest && tsx scripts/check-client-i18n-freshness.ts",
    "preview": "astro preview",
    "test:unit": "vitest run",
    "test:tutorial-player": "node scripts/test-tutorial-player-release-gate.js",
    "scale:svg": "node scripts/scale-svg-viewbox.cjs",
    "transcripts:scaffold-locales": "node scripts/scaffold-tutorial-transcript-locales.js",
    "transcripts:extract": "node scripts/extract-tutorial-events.js",
    "tutorials:tts:generate": "tsx scripts/generate-tutorial-audio.ts",
    "tutorials:translate": "tsx scripts/translate-tutorial-transcripts.ts",
    "tutorials:derive-fallback-timeline": "tsx scripts/derive-fallback-timeline.ts",
    "tutorials:publish-video": "tsx scripts/publish-tutorial-video-to-r2.ts",
    "video-manifest:generate": "tsx scripts/generate-video-manifest.ts",
    "validate:cli-docs": "node scripts/validate-cli-docs.js",
    "validate:content-accuracy": "node scripts/validate-content-accuracy.js --strict",
    "validate:docs-cli-usage": "node scripts/validate-docs-cli-usage.js",
    "validate:landing-cli-usage": "node scripts/validate-landing-cli-usage.js",
    "validate:tutorial-audio": "node scripts/validate-tutorial-audio.js",
    "validate:tutorial-transcripts": "node scripts/validate-tutorial-transcripts.js",
    "validate:translation-freshness": "node scripts/validate-translation-freshness.js",
    "validate:tutorial-cast-output": "node scripts/validate-tutorial-cast-output.js",
    "validate:content": "node scripts/validate-content.js",
    "validate:content-media": "npm run validate:tutorial-transcripts && npm run validate:tutorial-audio && npm run validate:tutorial-cast-output",
    "validate:comparison-refs": "node scripts/validate-comparison-refs.js",
    "validate:content:strict": "node scripts/validate-content.js --strict"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/react": "^5.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@marsidev/react-turnstile": "^1.6.0",
    "@rediacc/shared": "*",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/runner": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vitest/utils": "^4.0.18",
    "astro": "^5.17.3",
    "fast-xml-parser": "^5.11.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "plyr": "^3.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "playwright": "^1.61.1",
    "vfile": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
