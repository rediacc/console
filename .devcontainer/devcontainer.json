{
  "name": "Rediacc Console",
  "image": "ghcr.io/rediacc/devcontainer:latest",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // KVM, kept in step with the `docker run` in .ci/lib/devbox.sh, which is what
	// `./run.sh devbox up` uses. THE TWO PATHS MUST AGREE: a devbox created by
	// run.sh and one created by the VS Code / devcontainer-CLI path should have
	// the same capabilities, or a bug reproduces in one and not the other.
	//
	// THE DIVERGENCE THAT REMAINS IS DELIBERATE: devbox.sh derives the host kvm
	// gid at run time and passes `--group-add <gid>`, which this file cannot do
	// -- devcontainer.json is static JSON with no command substitution. So this
	// path binds the device and the capability, and start-kvm.sh reports loudly
	// if the group is missing rather than silently chmod-ing the node 0666.
	//
	// --device is unconditional here because devcontainer.json cannot test the
	// host; docker refuses to start if /dev/kvm is absent, which is why run.sh
	// is the supported path on a machine without nested virtualisation.
	"runArgs": [
		"--init",
		"--shm-size=1g",
		"--device", "/dev/kvm",
		"--cap-add", "NET_ADMIN",
		"--cap-add", "SYS_ADMIN"
	],
  "forwardPorts": [3000, 6080, 7681, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Console Dev Server",
      "onAutoForward": "notify"
    },
    "6080": {
      "label": "Desktop (noVNC)",
      "onAutoForward": "notify"
    },
    "7681": {
      "label": "Terminal (ttyd + tmux)",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "VS Code (Self-Hosted)",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "{ bash .devcontainer/init-submodules.sh || true; } && npm install && npm install --prefix private/account && npm run build:packages && npx --prefix packages/e2e playwright install chromium",
  "postStartCommand": "start-desktop.sh; setsid start-ttyd.sh >/tmp/ttyd.log 2>&1 & start-kvm.sh; ./run.sh provision auto; ./run.sh backend auto; npm install",
  "remoteEnv": {
    "PORT": "3000",
    "DISPLAY": ":99"
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "rediacc/renet": { "permissions": { "contents": "write" } },
        "rediacc/homebrew-tap": { "permissions": { "contents": "write" } },
        "rediacc/account": { "permissions": { "contents": "write" } }
      }
    },
    "vscode": {
      "extensions": [
        "biomejs.biome",
        "dbaeumer.vscode-eslint",
        "GitHub.vscode-github-actions",
        "ms-playwright.playwright",
        "astro-build.astro-vscode",
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "ms-python.python"
      ]
    }
  }
}
