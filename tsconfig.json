{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@rediacc/shared": ["./packages/shared/src/index"],
      "@rediacc/shared/*": ["./packages/shared/src/*"]
    }
  },
  // A SOLUTION FILE: `"files": []`, so this config compiles nothing itself and only shares
  // its options and names the projects below. Without it tsc read this file as matching
  // every .ts under the repo, so a bare `npx tsc --noEmit` here compiled the whole tree
  // under options meant to be shared rather than applied (lib ES2020, `types: ["node"]`,
  // no DOM, no astro, no workers-types) and reported about 10,000 errors, all of them the
  // wrong config.
  //
  // It stayed match-everything until 2026-10-14 for one reader: ESLint's type-aware
  // `projectService` picked each file's project by walking up to the nearest tsconfig.json,
  // and about 356 test and script files that no package build includes found this one.
  // ESLint is gone (PLAN-biome-only-lint), Biome reads no tsconfig, and `npm run typecheck`
  // runs each project under its own options, so nothing depends on the old shape.
  "files": [],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/cli" }
  ]
}
