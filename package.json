  "_overridesReasons": {
    "body-parser": "BLOCKER: force 2.3.0 to clear GHSA-v422-hmwv-36x6 (DoS via an invalid limit value that silently disables body-size enforcement; vulnerable >=2.0.0 <2.3.0 and <1.20.6). express@5 pulls body-parser ^2.2.1 which froze the lockfile at 2.2.2; 2.3.0 is the patched 2.x line and satisfies express's range. Advisory published after 2.3.0 (2026-06-15) had already aged past minimum-release-age, so this is a straight patched-version bump, not a deferral.",
    "glob": "BLOCKER: force glob ^11 everywhere to avoid the deprecated transitive glob <9 chain pulled in via older eslint tooling paths",
    "rimraf": "BLOCKER: force rimraf ^6 to avoid unmaintained v2/v3 transitive chains still referenced by older build/lint tooling",
    "rollup": "BLOCKER: pin rollup ^4.59 to ensure all workspaces resolve the same native binary set and avoid platform-specific optional-dep drift",
    "fast-xml-parser": "BLOCKER: pin 5.11.1 (raised from 5.8.0 for @astrojs/rss 4.0.19, then from 5.10.1 for deps freshness, then from 5.11.0 for the same reason) to carry the CDATA/comment injection fix (GHSA-gh4j-gqv2-49f6) plus the entity-expansion limit family; without the pin transitive consumers drift below the fixed range",
    "flatted": "BLOCKER: force >=3.4.2 to pick up prototype pollution fix landed after vitest/@vitest transitive pin held older versions",
    "smol-toml": "BLOCKER: force >=1.6.1 to pick up DoS-via-commented-lines fix; astro toolchain otherwise pulls older transitive versions",
    "h3": "BLOCKER: force >=1.15.9 to include SSE carriage-return sanitization + path traversal fixes; upstream astro/nitro transitives lag",
    "yaml": "BLOCKER: force >=2.8.3 to include stack-overflow-on-deeply-nested-collections fix; astro transitive chain otherwise holds tree at older version",
