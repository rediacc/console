# Discovery mechanisms that scripts/gates/check-dead-bash.ts cannot see statically.
#
# This file covers HOW something is reached, never WHETHER it should exist.
# "glob:<dir>/"        a directory whose .sh files are found by a glob, so no
#                      file in it is ever named individually.
# "dispatch:<prefix>"  a function-name prefix assembled at runtime, so no static
#                      reference to the full name exists.
#
# NOT a place to park dead code. If a script or function is genuinely unused,
# delete it — there is one operator and no external consumers. An entry here is
# a claim about a discovery mechanism, and it is checked: the liveness probe in
# scripts/gates/check-suppression-liveness.ts fails when a glob root no longer exists
# or a dispatch prefix matches zero functions.
#
# Each entry MUST carry a "# BLOCKER: <reason>" naming the discovering site and
# line, validated by the shared blocker-validator (30-char minimum, no
# low-effort phrases).

# BLOCKER: expanded as a glob by .ci/rediacc_ci/battery.py (DEFAULT_PATTERN = "test-*.sh", discovered by its discover()), so every test-*.sh under that root is executed without ever being named individually
glob:.ci/scripts/test/gates/

# BLOCKER: three sites expand this directory as a glob and name no file in it individually -- .ci/media/tutorials.sh (for script in "$tutorials_dir"/tutorial-*.sh, and "$tutorials_dir/tutorial-${name}.sh" built from an argument), .ci/tutorials/run-sequence.sh (for script in "$SCRIPT_DIR"/tutorial-*.sh, plus a per-slug existence check derived from the docs frontmatter), and scripts/gates/check-tutorial-noninteractive.ts (readdirSync of .ci/tutorials filtered to .sh)
glob:.ci/tutorials/

# BLOCKER: assembled at runtime in scripts/ops/linode-cluster-validation.sh as "phase_$p", so phase_preflight/phase_plan/phase_idempotency have no static call site
dispatch:phase_

# ---------------------------------------------------------------------------
# manual: an entrypoint a human runs directly. Still a discovery mechanism --
# the operator is the caller -- but the loosest one, so each BLOCKER must name
# WHO runs it and WHEN. If you cannot write that sentence truthfully, the
# script is dead: delete it.
# ---------------------------------------------------------------------------

# BLOCKER: deliberately not wired into the release pipeline; its own header at the top of the file states MANUAL ONLY, and it is run by the operator when a proxy deploy is needed
manual:.ci/scripts/deploy/deploy-proxy.sh

# BLOCKER: NIS2/CRA supply-chain SBOM enumeration, run by the operator on demand when a dependency inventory is required for compliance evidence rather than on every build
manual:.ci/scripts/security/dependency-inventory.sh

# BLOCKER: starts OpenVSCode Server for self-hosted browser access and refuses to run inside Codespaces; invoked by the operator on a self-hosted box, not by the devcontainer lifecycle
manual:.devcontainer/start-vscode.sh

# BLOCKER: idempotent Cloudflare apex-redirect reconciler for rediacc.com, run by the operator when the redirect ruleset drifts; safe to re-run and asserts current state before writing
manual:scripts/ops/apply-cf-redirect-rules.sh

# BLOCKER: multi-phase Linode cluster provisioning validation driven interactively by the operator, phases selected on the command line and dispatched via "phase_$p"
manual:scripts/ops/linode-cluster-validation.sh

# BLOCKER: one-shot idempotent R2 scrub for legacy orphan prefixes, run by the operator when release-path pollution needs clearing; deliberately not automated because it hard-deletes prefixes
manual:scripts/ops/r2-oneshot-scrub.sh

# BLOCKER: pre-commit quality gate wired through the operator's local Claude Code hook settings rather than tracked config, and explicitly protected from deletion by .claude/hooks/pre-bash/block-protected-files.sh
manual:scripts/pre-commit-check.sh

# BLOCKER: downstream re-vendor helper for the copyable .ci/breakpoint/ folder, run by the operator in a repo that vendored breakpoint when check-breakpoint-drift.sh reports the copy has fallen behind rediacc/console
manual:.ci/breakpoint/scripts/sync-breakpoint.sh

# BLOCKER: operator-invoked wrapper carrying its own "Usage: .ci/docker/run-in-web.sh <command...>" line, the entry point of the containerised web toolchain added alongside .ci/docker/{tts,render}. Its siblings are reachable statically -- run-in-render.sh from this file, and the narration wrapper from the exec shim at .ci/docker/run-in-tts.sh, which W10 phase 3 left behind when the wrapper and its image context moved to .ci/media/tools/run-in-tts.sh and .ci/media/tts/ -- so it is the TOP of that chain and nothing above it can name it. REDIACC_NO_DOCKER=1 makes it exec on the host, which is how it is driven locally.
manual:.ci/docker/run-in-web.sh

# BLOCKER: operator-run probe for the receipt's `stable` field, which cannot be gated without flakiness -- it must plant a tree change WHILE a real lane run is in flight, so any automated version races the gate it is timing against. Kept because the control took three attempts to stop reporting success while measuring nothing (a slow-tier gate matched zero gates; then a *.tmp probe was invisible to git status via .gitignore:73), and that knowledge is worth more as a runnable script than as prose.
manual:.ci/scripts/test/manual/probe-receipt-stability.sh
