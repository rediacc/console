{
  "$comment": "The tunables registry of `npm run settings` (agent/plans/PLAN-settings-set-verb.md). One entry per tunable: its unit and range, every copy that must hold the same value (the first is the source), where `set --reason` writes the ruling, and the tests `set` runs after writing. Change a registered value with `npm run settings -- set <id> <value> --reason '<why>'`, never by hand.",
  "settings": [
    {
      "id": "cf.workers_requests_month",
      "unit": "count",
      "min": 1000000,
      "max": 10000000000,
      "why": "Workers requests per billing cycle: the Cloudflare usage alerts on worker_requests and worker_standard_request, and the weekly report's ceiling.",
      "copies": [
        {
          "file": ".ci/config/cf-spend-guard.json",
          "json_path": "/notifications/products/worker_requests/limit"
        },
        {
          "file": ".ci/config/cf-spend-guard.json",
          "json_path": "/notifications/products/worker_standard_request/limit"
        },
        {
          "file": ".ci/rediacc_ci/ops/cf_usage_report.py",
          "py_dict": "DEFAULT_CEILINGS",
          "py_key": "workers_requests_month"
        }
      ],
      "reason_paths": [
        {
          "file": ".ci/config/cf-spend-guard.json",
          "json_path": "/notifications/products/worker_requests/why",
          "mode": "replace",
          "prefix": "Workers requests, "
        },
        {
          "file": ".ci/config/cf-spend-guard.json",
          "json_path": "/notifications/products/worker_standard_request/why",
          "mode": "replace",
          "prefix": "Workers standard-usage-model requests, "
        }
      ],
