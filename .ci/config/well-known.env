# THE WELL-KNOWN VALUES, WRITTEN ONCE.
#
# Every origin, bucket, repository slug, image registry, owned path, address and
# third-party API base that more than one file needs is declared here and read
# everywhere else. `check:ci-literal-sources`
# (.ci/rediacc_ci/quality/literal_sources.py) fails when a value below is typed
# out anywhere it is not allowed to be, and when an owned literal that is not
# below starts spreading across files.
#
# FORMAT IS LOAD-BEARING, the same as .devcontainer/toolchain.env: plain
# KEY=value, no quotes, no $, no spaces, no `readonly`. That is what lets every
# reader take the file as it is:
#
#   bash       .ci/config/constants.sh sources it under `set -a`
#   Python     rediacc_ci.well_known parses it
#   TS         packages/shared/src/config/well-known.generated.ts is rendered
#              from it by `literal_sources.py --write` and held equal by the gate
#   Actions    grep '^WK_' .ci/config/well-known.env >> "$GITHUB_ENV"
#
# THE WK_ PREFIX SEPARATES A FACT FROM A KNOB. RELEASES_BASE_URL in constants.sh
# is an override a developer may point at a staging bucket; WK_RELEASES_ORIGIN is
# what production is. A verifier reads the fact, never the knob.
#
# Each value is the exact production value. A change here is a production change.

# Origins (scheme and host, no trailing slash). Paths are composed by the reader.
WK_RELEASES_ORIGIN=https://releases.rediacc.com
WK_SITE_ORIGIN=https://www.rediacc.com
WK_EDGE_ORIGIN=https://edge.rediacc.com
WK_MEDIA_ORIGIN=https://media.rediacc.com
WK_BENCH_ORIGIN=https://bench.rediacc.com
WK_SANDBOX_ORIGIN=https://sandbox.rediacc.com
WK_PROFILING_ORIGIN=https://profiles.rediacc.io
# The default region's account server. regions.json owns the region list; the
# gate asserts this equals the domain of the region marked "default" there.
WK_ACCOUNT_DEFAULT_ORIGIN=https://eu.rediacc.com
WK_CONSOLE_ORIGIN=https://console.rediacc.com
WK_CLOUD_ORIGIN=https://cloud.rediacc.io

# Apex domains. rediacc.com is the product's; rediacc.io holds infrastructure
# (machine and CI hostnames, the internal mail domain).
WK_APEX_DOMAIN=rediacc.com
WK_INFRA_DOMAIN=rediacc.io

# Object storage
WK_RELEASES_BUCKET=rediacc-releases

# Source hosting and images
WK_GH_REPO=rediacc/console
WK_RENET_REPO=rediacc/renet
WK_ACCOUNT_REPO=rediacc/account
WK_ELITE_REPO=rediacc/elite
WK_HOMEBREW_TAP_REPO=rediacc/homebrew-tap
WK_HOMEBREW_TAP=rediacc/tap
WK_IMAGE_REGISTRY=ghcr.io/rediacc
# Local (never pushed) image repositories.
WK_WEB_IMAGE_REPO=rediacc/web
WK_DEVBOX_UID_IMAGE_REPO=rediacc/devbox

# Paths on a machine
WK_DATASTORE_PATH=/mnt/rediacc
WK_RUNTIME_DIR=/var/run/rediacc
WK_ETC_DIR=/etc/rediacc
WK_OPT_DIR=/opt/rediacc

# Addresses
WK_CONTACT_EMAIL=contact@rediacc.com
WK_SUPPORT_EMAIL=support@rediacc.com
WK_PKG_MAINTAINER_EMAIL=info@rediacc.com
WK_PKG_SIGNING_KEY_NAME=releases@rediacc.com
WK_ADMIN_EMAIL_DEFAULT=admin@rediacc.io
WK_DEV_USER_EMAIL=dev-user@rediacc.io
WK_OPERATOR_EMAIL=muhammed@rediacc.com

# Ports
WK_ACCOUNT_DEV_PORT=4800

# Third-party bases. A URL entry with a path matches URLs under that path.
WK_CF_API_BASE=https://api.cloudflare.com/client/v4
WK_GH_ORIGIN=https://github.com
WK_GH_API_BASE=https://api.github.com
WK_GO_DL_BASE=https://go.dev/dl
WK_UBUNTU_ARCHIVE=http://archive.ubuntu.com/ubuntu
WK_UBUNTU_AZURE_MIRROR=http://azure.archive.ubuntu.com/ubuntu
WK_DOCKER_INSTALL_DOCS=https://docs.docker.com/get-docker
WK_CLAUDE_CODE_URL=https://claude.com/claude-code
