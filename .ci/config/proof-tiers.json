{
  "schema": 1,
  "about": "The one surface map of agent/plans/PLAN-tested-on-bench.md Design item 2, read only through rediacc_ci.proof.surfaces. Globs are console-relative in the Owns grammar (wl_planconc.normalize_owns, then glob_regex). A surface with a glob under a submodule lives in that submodule; its gitlink pointer joins the inputs digest.",
  "submodules": ["private/renet", "private/account"],
  "surfaces": {
    "renet": {
      "globs": [
        "private/renet/cmd/**",
        "private/renet/pkg/**",
        "private/renet/proxy/**",
        "private/renet/build.sh",
        "private/renet/go.mod",
        "private/renet/go.sum",
        "private/renet/embed-assets.lock.json"
      ],
      "live": ["hostinger"],
      "renet_build": true
    },
    "cli-remote": {
      "globs": [
        "packages/cli/src/remote/**",
        "packages/cli/src/services/repo/repo-key-deployment.ts"
      ],
      "live": ["hostinger"],
      "renet_build": true
    },
    "cli": {
      "globs": ["packages/cli/src/**"],
      "live": ["bench", "hostinger"],
      "renet_build": false
    },
    "account": {
      "globs": [
        "private/account/{src,web,drizzle,scripts}/**",
        "private/account/{package.json,package-lock.json,tsconfig.json,wrangler*.toml,dev.defaults.env,docker-compose.yml,Dockerfile}",
        "packages/shared/src/**"
      ],
      "live": ["bench"],
      "renet_build": false
    },
    "account-worker": {
      "globs": ["workers/account/**"],
      "live": ["bench"],
      "renet_build": false
    },
    "proxy": {
      "globs": ["workers/proxy/src/**", "workers/proxy/wrangler*.toml", "workers/proxy/Dockerfile"],
      "live": ["bench"],
      "renet_build": false
    },
    "www": {
      "globs": ["packages/www/src/**", "workers/www/**"],
      "live": ["bench"],
      "renet_build": false
    }
  },
  "exclude": [
    "**/*_test.go",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/testdata/**",
    "**/tests/**",
    "**/e2e/**",
    "**/*.md",
    "**/.naturalized-hashes.json"
  ],
  "tiers": {
    "vm": {
      "phases": {
        "renet": {"surfaces": ["renet", "cli-remote"]},
        "account": {"surfaces": ["account"]}
      },
      "instrument": {
        ".ci/rediacc_ci/drills/license.py": ["account"],
        ".ci/rediacc_ci/drills/universe.py": ["account"],
        ".ci/rediacc_ci/drills/transfer.py": ["account"],
        ".ci/rediacc_ci/drills/vm_check.py": ["renet", "account"],
        ".ci/rediacc_ci/drills/lib.py": ["renet", "account"],
        ".ci/rediacc_ci/drills/upgrade_converge.py": ["renet"],
        ".ci/rediacc_ci/drills/tenant_isolation.py": ["renet"],
        ".ci/rediacc_ci/drills/session_teardown.py": ["renet"],
        ".ci/rediacc_ci/drills/converge_preflight.py": ["renet"],
        ".ci/rediacc_ci/drills/gpu_grants.py": ["renet"],
        ".ci/rediacc_ci/drills/vm_ssh.py": ["renet", "account"],
        ".ci/rediacc_ci/drills/wire.py": ["renet", "account"]
      }
    },
    "live": {
      "baseline_at": "2026-10-28",
      "targets": {
        "bench": {"origin_wk": "WK_BENCH_ORIGIN"},
        "hostinger": {"config": "eu-bench", "machines": ["hostinger"]}
      },
      "checks": {
        "account-smoke": {
          "targets": ["bench"],
          "surfaces": ["account", "account-worker"],
          "deploy": "bench-cache",
          "what": "the bench account Worker answers /health and /.well-known/server-info; the version recorded by deploy_bench is the one serving 100% at check time",
          "steps": [
            {"id": "health", "argv": ["curl", "-fsS", "--max-time", "30", "{origin}/account/api/v1/health"]},
            {"id": "server-info", "argv": ["curl", "-fsS", "--max-time", "30", "{origin}/account/api/v1/.well-known/server-info"]}
          ]
        },
        "proxy-ready": {
          "targets": ["bench"],
          "surfaces": ["proxy"],
          "deploy": "unrecorded",
          "what": "deploy_proxy --smoke-only against bench: /v1/health 200, /v1/server-info 401 and /v1/ready on the newest deployment; no deploy record ties that version to a console head yet, so a run is NOT_VERIFIED not-live",
          "steps": [
            {"id": "smoke", "argv": ["python3", "-m", "rediacc_ci.deploy.deploy_proxy", "--target", "bench", "--smoke-only"], "timeout_s": 900}
          ]
        },
        "cli-bench": {
          "targets": ["bench"],
          "surfaces": ["cli"],
          "deploy": "tree",
          "what": "the CLI built from the clean head tree reads its subscription from the bench account server through the eu-bench config",
          "steps": [
            {"id": "subscription", "argv": ["./rdc.sh", "--config", "eu-bench", "subscription", "status"]}
          ]
        },
        "www-smoke": {
          "targets": ["bench"],
          "surfaces": ["www"],
          "deploy": "unrecorded",
          "what": "no bench www Worker exists yet (workers/www carries wrangler.toml and wrangler.edge.toml only), so no deploy identity ties a served version to a console head: every run is NOT_VERIFIED not-live and writes no row; it meets LP7's coverage rule and cannot close a box until a bench www deploy is recorded",
          "steps": [
            {"id": "root", "argv": ["curl", "-fsS", "--max-time", "30", "{origin}/"]}
          ]
        },
        "renet-live": {
          "targets": ["hostinger"],
          "surfaces": ["renet", "cli-remote", "cli"],
          "deploy": "renet-hash",
          "per_machine": true,
          "rebuild": ["./rdc.sh", "--version"],
          "what": "per machine alias: bin/renet is the renet pointer unmodified (rebuilt once), machine status provisions it and reports stale_binary empty, and the remote renet hash equals the local sha256",
          "steps": [
            {"id": "status", "expect": "stale-binary-empty", "argv": ["./rdc.sh", "--config", "{config}", "machine", "status", "{machine}", "-o", "json"], "timeout_s": 900},
            {"id": "hash", "expect": "renet-hash", "argv": ["./rdc.sh", "--config", "{config}", "term", "connect", "{machine}", "-c", "/usr/lib/rediacc/renet/current/renet hash"]}
          ]
        }
      },
      "pointer_only": ["private/renet", "private/account"]
    }
  }
}
