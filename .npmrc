# Supply-chain hardening — enforced by .ci/scripts/quality/check_npmrc.py.
#
# ignore-scripts: Blocks every dependency lifecycle script (preinstall/install/postinstall) at install time.
#                 Native modules (ssh2, cpu-features, esbuild) are recompiled by an explicit
#                 `npm run install:natives` step after `npm ci`.
# allow-git:      Rejects git+/github:/tarball deps. Defends against PackageGate-style git-dep RCE
#                 (Koi Security, Jan 2026) where a hijacked .npmrc in a git dep redirects the git binary.
#
# The dependency freshness window is NOT here: npm never read the old minimum-release-age key
# (npm 11 warns about it as an unknown project config). It lives in .ci/config/release-age.json,
# read by the repo's gates, and check_npmrc.py refuses the key's return to this file.
ignore-scripts=true
allow-git=none
