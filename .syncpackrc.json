{
  "$schema": "https://unpkg.com/syncpack@13/dist/schema.json",
  "indent": "  ",
  "sortFirst": [
    "name",
    "version",
    "private",
    "type",
    "workspaces",
    "scripts"
  ],
  "versionGroups": [
    {
      "label": "A non-workspace consumer must use a file: path, not the wildcard",
      "packages": [
        "@rediacc/account"
      ],
      "dependencies": [
        "@rediacc/**"
      ],
      "isIgnored": true
    },
    {
      "label": "Workspace dependencies should use wildcard",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@rediacc/**"
      ],
      "dependencyTypes": [
        "!local"
      ],
      "pinVersion": "*"
    },
    {
      "label": "Pin @types/node to latest",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@types/node"
      ],
      "pinVersion": "^24.19.0"
    },
    {
      "label": "Pin the OpenTelemetry 0.3 line in lockstep",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@opentelemetry/exporter-logs-otlp-http",
        "@opentelemetry/exporter-metrics-otlp-http",
        "@opentelemetry/exporter-trace-otlp-http",
        "@opentelemetry/sdk-node"
      ],
      "pinVersion": "^0.300.0"
    },
    {
      "label": "Pin the OpenTelemetry api-logs line (no 0.300 release yet)",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@opentelemetry/api-logs"
      ],
      "pinVersion": "^0.223.0"
    },
    {
      "label": "Pin the OpenTelemetry 3.x line in lockstep",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@opentelemetry/core",
        "@opentelemetry/resources",
        "@opentelemetry/sdk-logs",
        "@opentelemetry/sdk-metrics"
      ],
      "pinVersion": "^3.0.0"
    },
    {
      "label": "Pin i18next for CLI",
      "packages": [
        "**"
      ],
      "dependencies": [
        "i18next"
      ],
      "pinVersion": "^26.5.11"
    },
    {
      "label": "Pin vite-tsconfig-paths to latest",
      "packages": [
        "**"
      ],
      "dependencies": [
        "vite-tsconfig-paths"
      ],
      "pinVersion": "^6.0.3"
    },
    {
      "label": "Ensure consistent dependency versions across packages",
      "packages": [
        "**"
      ],
      "dependencies": [
        "**"
      ],
      "dependencyTypes": [
        "prod",
        "dev"
      ],
      "policy": "sameRange",
      "preferVersion": "highestSemver"
    }
  ],
  "source": [
    "package.json",
    "packages/*/package.json",
    "private/account/package.json"
  ]
}
